#!/usr/bin/env python3
"""Watch one codex job to a terminal verdict, with the evidence for that verdict.

Hand-written watch loops keep breaking in the same two ways, so the completion
rules from the codex-delegation skill live here as code instead:

- The job id is looked up by scanning every workspace state dir. A job started
  in an isolated worktree registers under that worktree, so asking the
  companion from the main checkout reports "nothing running" while it runs.
- Completion is decided by the deliverable plus the job record on disk, never
  by "the id no longer appears in the status output" — a finished id stays
  visible under latestFinished, so that test can never become true.
- Every exit is a verdict carrying what it was based on. A verdict that sends
  the reader off to investigate by hand is the failure this tool exists to
  remove, so silence is always reported against this workspace's own history,
  alongside the tree activity, the last log line, and the cancel command.

Signals are limited to what is observable from inside the sandbox and bindable
to this job. Process liveness is not: the sandbox runs in its own pid
namespace, so every job's pid reads as absent. Broker-socket liveness is not
either: a job's socket path only reaches its log when an interrupt fails, and
the endpoint the companion reports belongs to the current runtime rather than
to the job.

Takes a job id plus the deliverable it must produce; --help lists the rest and
--selftest runs the rules below as tests.

Exit codes, and what the caller does with each:

  0  done              the deliverable is this run's and the job completed
  3  done-hung         deliverable ready, runner still registered — verify, then cancel
  4  stall             log and tree both quiet — read the log, cancel, re-issue fresh
  5  no-deliverable    completed but produced nothing complete — read the log
  6  never-registered  no record in any searched root — the launch did not take
  7  timeout           still alive at the deadline — decide whether to keep waiting
  8  not-completed     cancelled or failed — never a result; re-issue on a fresh thread
  9  ambiguous         several records carry the id — disambiguate before trusting one
  10 vanished          the record was pruned after registration — outcome unknowable
  11 alive             --once only: still running; re-arm or investigate
  12 over-estimate     twice --estimate-seconds with no verdict — investigate
  13 corrupt           the record is present but unreadable — do not read it as a stall
  14 unverifiable      quiet log but the tree could not be read — neither call is evidenced
"""

from __future__ import annotations

import argparse
import calendar
import glob
import json
import math
import os
import re
import shlex
import sys
import tempfile
import time
import unittest

STATE_ROOT = os.path.expanduser("~/.claude/plugins/data/codex-openai-codex/state")
# The plugin resolves its state root from CLAUDE_PLUGIN_DATA and falls back to
# the temp dir, so watching only the packaged path loses jobs it really started.
PLUGIN_DATA_ENV = "CLAUDE_PLUGIN_DATA"
COMPANION = os.path.expanduser(
    "~/.claude/plugins/cache/openai-codex/codex/1.0.5/scripts/codex-companion.mjs"
)
# The companion's own vocabulary for a job that is still going; anything else
# it writes is terminal. Listing the alive side keeps unseen end states terminal.
ALIVE_STATUS = frozenset({"queued", "running"})
# Only a job that finished on its own teaches how long healthy quiet lasts; the
# cancelled ones are the stalls this tool exists to catch (measured here: every
# completed job went quiet for at most 147s, every cancelled one for 697s+).
BASELINE_STATUS = "completed"
STALL_FLOOR_SECONDS = 420.0  # the skill's 7 min, used when history gives nothing larger
STALL_BASELINE_FACTOR = 3.0
LOG_TS = re.compile(r"^\[(\d{4}-\d\d-\d\dT[\d:.]+)Z\]")

EXIT_DONE = 0
EXIT_DONE_HUNG = 3
EXIT_STALL = 4
EXIT_ENDED_WITHOUT_ARTIFACT = 5
EXIT_NEVER_REGISTERED = 6
EXIT_TIMEOUT = 7
EXIT_NOT_COMPLETED = 8
EXIT_AMBIGUOUS = 9
EXIT_VANISHED = 10
EXIT_ALIVE = 11
EXIT_OVER_ESTIMATE = 12
EXIT_CORRUPT = 13
EXIT_UNVERIFIABLE = 14

# The skill's third condition — is a command still running — can only be guessed
# at. The plugin appends message bodies verbatim, so a body quoting a log line
# looks exactly like the event it quotes. The guess is therefore used in one
# direction only: it can suppress a verdict, never manufacture one. Suppression
# fires when a start has no matching end — commands run in parallel, so the tail
# alone misses one still running behind a neighbour's completion — or when the
# tail itself starts a command. A quoted start over-suppresses, which costs
# waiting. A quoted end cannot cancel a running command, because ends are paired
# to starts by the command they name and an unpaired end is dropped. What is left
# is narrower: the same command text running again while the log quotes an older
# end for it. The plugin's own record could settle even that, but it keeps only a
# coarse phase, not command ids, so the stall verdict names the doubt out loud.
COMMAND_START = re.compile(r"^\[[^\]]+\]\s+Running command:")
COMMAND_END = re.compile(r"^\[[^\]]+\]\s+Command \w+:")


def state_roots(explicit: str | None = None) -> list[str]:
    """Every root the plugin may have written to, in the order it resolves them."""
    if explicit:
        return [explicit]
    roots = []
    plugin_data = os.environ.get(PLUGIN_DATA_ENV)
    if plugin_data:
        roots.append(os.path.join(plugin_data, "state"))
    roots.append(os.path.join(tempfile.gettempdir(), "codex-companion"))
    roots.append(STATE_ROOT)
    return list(dict.fromkeys(roots))


def find_jobs(job_id: str, roots: list[str]) -> list[tuple[str, str]]:
    """Every (record, log) pair carrying this id — more than one is an ambiguity, not a pick."""
    found = []
    for root in roots:
        for record in sorted(
            glob.glob(os.path.join(root, "*", "jobs", job_id + ".json"))
        ):
            found.append((record, record[: -len(".json")] + ".log"))
    return found


def job_record(record_path: str) -> dict | None:
    """The on-disk record, or None when it is there but unreadable — a corrupt
    record is an unknown outcome, not a quiet job."""
    try:
        with open(record_path, encoding="utf-8") as f:
            loaded = json.load(f)
    except OSError:
        return None
    except ValueError:
        return None
    return loaded if isinstance(loaded, dict) else None


def heartbeat_age(log_path: str, now: float) -> float | None:
    """Seconds since the job log last grew; None when the log is absent."""
    try:
        return now - os.path.getmtime(log_path)
    except OSError:
        return None


def log_lines(log_path: str) -> list[str]:
    """Non-empty log lines, newest last, left edge intact so events can be anchored."""
    try:
        with open(log_path, encoding="utf-8", errors="replace") as f:
            return [ln.rstrip("\n") for ln in f if ln.strip()]
    except OSError:
        return []


def last_log_line(log_path: str, limit: int = 160) -> str:
    """The job's last log line — what it was doing when it went quiet."""
    lines = log_lines(log_path)
    return lines[-1].strip()[:limit] if lines else ""


def command_text(line: str) -> str:
    """The command an event line refers to, with the end line's exit suffix removed."""
    body = re.sub(r"^\[[^\]]+\]\s+(Running command:|Command \w+:)\s*", "", line)
    return re.sub(r"\s*\(exit -?\d+\)\s*$", "", body).strip()


def command_may_be_running(lines: list[str]) -> bool:
    """Whether a command might still be in flight — used only to hold a verdict back.

    Ends are matched to starts by the command they name. An end that matches
    nothing pending is a quote of an older line, not this command finishing, so
    it is dropped rather than allowed to cancel a start that is still running.
    """
    pending: list[str] = []
    for line in lines:
        if COMMAND_START.match(line):
            pending.append(command_text(line))
        elif COMMAND_END.match(line):
            text = command_text(line)
            for i in range(len(pending) - 1, -1, -1):
                if pending[i] == text:
                    del pending[i]
                    break
    return bool(pending)


def tree_age(root: str | None, now: float) -> float | None:
    """Seconds since the newest write under the job's tree; None when unknowable."""
    if not root or not os.path.isdir(root):
        return None
    newest = None
    for base, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d != ".git"]
        for name in files:
            try:
                mtime = os.path.getmtime(os.path.join(base, name))
            except OSError:
                continue
            if newest is None or mtime > newest:
                newest = mtime
    return None if newest is None else now - newest


def log_silences(log_path: str) -> list[float]:
    """Gaps between timestamped log lines — the shape of this runner's quiet spells."""
    stamps = []
    try:
        with open(log_path, encoding="utf-8", errors="replace") as f:
            for line in f:
                m = LOG_TS.match(line)
                if m:
                    stamps.append(
                        time.mktime(time.strptime(m.group(1)[:19], "%Y-%m-%dT%H:%M:%S"))
                    )
    except OSError:
        return []
    return [b - a for a, b in zip(stamps, stamps[1:], strict=False)]


def baseline_silence(jobs_dir: str, exclude: str) -> float | None:
    """Longest quiet spell among jobs that completed in THIS workspace; None with no history.

    Scoped to one workspace on purpose: a slow job in an unrelated workspace
    would otherwise raise the threshold here and hide a real stall.
    """
    worst = None
    for record_path in glob.glob(os.path.join(jobs_dir, "*.json")):
        if os.path.basename(record_path)[: -len(".json")] == exclude:
            continue
        record = job_record(record_path)
        if record is None or record.get("status") != BASELINE_STATUS:
            continue
        gaps = log_silences(record_path[: -len(".json")] + ".log")
        if gaps and (worst is None or max(gaps) > worst):
            worst = max(gaps)
    return worst


def stall_threshold(explicit: float | None, baseline: float | None) -> float:
    """Explicit wins; otherwise the floor, raised past this workspace's own worst quiet spell."""
    if explicit is not None:
        return explicit
    if baseline is None:
        return STALL_FLOOR_SECONDS
    return max(STALL_FLOOR_SECONDS, baseline * STALL_BASELINE_FACTOR)


def run_since(record: dict) -> float | None:
    """The earliest instant this run could have written anything.

    A queued job has no startedAt yet — the plugin adds it when the worker
    picks the job up — so fall back to createdAt rather than dropping the
    freshness floor entirely and accepting an earlier run's deliverable.
    """
    for field in ("startedAt", "createdAt"):
        stamp = stamp_epoch(record.get(field))
        if stamp is not None:
            return stamp
    return None


def stamp_epoch(stamp: object) -> float | None:
    """An ISO UTC stamp as epoch seconds, fraction kept; None when unusable.

    Keeps the fraction: truncating to the second lets a file written earlier in
    the same second pass as this run's output.
    """
    if not isinstance(stamp, str) or len(stamp) < 19:
        return None
    try:  # the record stamps UTC, so read it as UTC rather than through local time
        whole = float(calendar.timegm(time.strptime(stamp[:19], "%Y-%m-%dT%H:%M:%S")))
    except ValueError:
        return None
    fraction = re.match(r"\.\d+", stamp[19:])
    return whole + float(fraction.group(0)) if fraction else whole


def artifact_ready(
    path: str | None, token: str | None, since: float | None = None
) -> bool:
    """A deliverable counts once its final line is exactly the token and this run wrote it.

    `since` is the earliest instant this run could have written. With no floor
    there is nothing separating this run's output from an earlier run's, so the
    answer is no rather than a guess.
    """
    if not path or since is None:
        return False
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
        if os.path.getmtime(path) < since:
            return False  # a leftover from an earlier run is not this run's output
    except OSError:
        return False
    if not token:
        return bool(body.strip())
    # The order says the final line IS the token: no padding, no trailing blanks.
    lines = body.splitlines()
    return bool(lines) and lines[-1] == token


def cancel_command(job_id: str, root: str | None) -> str:
    """The cancel the operator would otherwise have to assemble, cwd included."""
    node = f"node {shlex.quote(COMPANION)} cancel {job_id} --json"
    return f"(cd {shlex.quote(root)} && {node})" if root else node


def verdict(
    status: str,
    age: float | None,
    tree: float | None,
    ready: bool,
    stall_seconds: float,
    hang_seconds: float,
    expects_artifact: bool = True,
    command_may_run: bool = False,
) -> tuple[int, str] | None:
    """Terminal (exit code, headline) for one poll, or None to keep watching."""
    alive_status = status in ALIVE_STATUS or not status
    if not alive_status:
        # Only the companion's own success status is success; cancel and failure
        # are what this tool exists to catch, deliverable on disk or not.
        if status != BASELINE_STATUS:
            return EXIT_NOT_COMPLETED, (
                f"not-completed: job {status} — re-issue on a fresh thread "
                "(a cancelled or failed run is not a result)"
            )
        if not (ready or not expects_artifact):
            return EXIT_ENDED_WITHOUT_ARTIFACT, (
                "ended-without-deliverable: job completed with no complete deliverable — "
                "the log's tail below is what it reported instead"
            )
        # The skill's completion is status AND a settled tree: a task can leave
        # a detached process still writing after the runner reports completed.
        if tree is None:
            return EXIT_UNVERIFIABLE, (
                "unverifiable: the job reports completed but its tree could not be "
                "read, so the work cannot be shown to have settled — check workspaceRoot"
            )
        if tree < hang_seconds:
            return None  # still settling; re-check rather than hand over mid-write
        return EXIT_DONE, "done: job completed and its tree settled"
    if not expects_artifact:
        ready = False  # nothing to be ready; only the tree and the log speak here
    settled = hang_seconds if ready else stall_seconds
    if age is not None and age < settled:
        return None
    if tree is not None and tree < settled:
        return None  # writing files is working, whatever the log says
    if command_may_run:
        # A read-only command writes nothing, so quiet tree + quiet log is also
        # what a working one looks like. The tail cannot settle it either way.
        return EXIT_UNVERIFIABLE, (
            "unverifiable: a command started and was never seen to finish, and a "
            "read-only one leaves the tree quiet too — read the tail below before "
            "cancelling anything"
        )
    if tree is None:
        # Both quiet conditions the skill requires must be observed, not assumed.
        return EXIT_UNVERIFIABLE, (
            "unverifiable: the log went quiet but this job's tree could not be read, "
            "so neither stall nor progress can be shown — check workspaceRoot below"
        )
    if ready:
        return EXIT_DONE_HUNG, (
            "done-hung: deliverable ready but the runner is still registered — "
            "verify the deliverable, then cancel the job"
        )
    return EXIT_STALL, (
        "stall: the runner went quiet and the tree stopped changing — read the tail "
        "below first, since a command whose start the log did not attribute cleanly "
        "can look the same"
    )


def evidence(
    job_id: str,
    record: dict,
    log: str,
    age: float | None,
    tree: float | None,
    threshold: float,
    baseline: float | None,
) -> str:
    """Everything the verdict rests on, so no follow-up investigation is needed."""
    root = record.get("workspaceRoot")
    quiet = "log なし" if age is None else f"{int(age)}s"
    versus = (
        f" (この workspace の完走 job の最長無音 {int(baseline)}s の "
        f"{age / baseline:.1f} 倍)"
        if baseline and age
        else ""
    )
    lines = [
        f"  job    : {job_id} status={record.get('status') or '不明'} root={root or '不明'}",
        f"  無音   : {quiet}{versus} / しきい値 {int(threshold)}s",
        f"  ツリー : {'書き込みなし' if tree is None else f'最終書き込み {int(tree)}s 前'}",
        f"  最終行 : {last_log_line(log) or '(なし)'}",
        f"  log    : {log}",
        f"  cancel : {cancel_command(job_id, root if isinstance(root, str) else None)}",
    ]
    return "\n".join(lines)


def watch(args: argparse.Namespace, roots: list[str] | None = None) -> int:
    roots = roots if roots is not None else state_roots(args.state_root)
    deadline = time.time() + args.timeout_seconds
    started = time.time()
    found: list[tuple[str, str]] = []
    while not found:
        found = find_jobs(args.job_id, roots)
        if len(found) > 1:
            print(f"ambiguous: {len(found)} records carry the id {args.job_id}")
            for record, _log in found:
                print(f"  {record}")
            return EXIT_AMBIGUOUS
        if found:
            break
        if time.time() + args.poll_seconds > deadline:
            print(f"never-registered: no state record for {args.job_id}")
            print(f"  searched: {', '.join(roots)}")
            return EXIT_NEVER_REGISTERED
        time.sleep(args.poll_seconds)
    record_path, log = found[0]
    # Scope the baseline to this job's own workspace: a slow neighbour must not
    # raise the bar here (a foreign 3600s gap once hid a two-hour stall).
    baseline = baseline_silence(os.path.dirname(record_path), args.job_id)
    threshold = stall_threshold(args.stall_seconds, baseline)
    while True:
        now = time.time()
        record = job_record(record_path)
        age = heartbeat_age(log, now)
        tree = tree_age((record or {}).get("workspaceRoot"), now)
        # Elapsed runs from the job's own start so re-arming does not reset the clock.
        elapsed = now - (stamp_epoch((record or {}).get("startedAt")) or started)
        if not os.path.exists(record_path):
            # The plugin prunes to its newest 50 jobs regardless of status, so a
            # record that was here and is gone is lost history, not a verdict.
            out = (
                EXIT_VANISHED,
                "vanished: the state record disappeared after registration — "
                "the plugin prunes old jobs, so this job's outcome is unknowable here",
            )
        elif record is None:
            out = (
                EXIT_CORRUPT,
                "corrupt: the state record is present but unreadable — the job's "
                "outcome cannot be read from it, so do not treat this as a stall",
            )
        else:
            out = verdict(
                str(record.get("status") or ""),
                age,
                tree,
                artifact_ready(args.artifact, args.token, run_since(record)),
                threshold,
                args.hang_seconds,
                expects_artifact=args.artifact is not None,
                command_may_run=command_may_be_running(log_lines(log)),
            )
        if (
            out is None
            and args.estimate_seconds
            and elapsed > args.estimate_seconds * 2
        ):
            out = (
                EXIT_OVER_ESTIMATE,
                f"over-estimate: {int(elapsed)}s elapsed against a {int(args.estimate_seconds)}s "
                "estimate — read the log against the order before waiting further",
            )
        if out is None and args.once:
            out = (EXIT_ALIVE, f"alive: still running after {int(elapsed)}s")
        if out is None and now >= deadline:
            out = (
                EXIT_TIMEOUT,
                f"timeout: still alive after {int(args.timeout_seconds)}s",
            )
        if out is not None:
            code, headline = out
            print(headline)
            print(
                evidence(args.job_id, record or {}, log, age, tree, threshold, baseline)
            )
            return code
        time.sleep(args.poll_seconds)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Watch one codex job to a terminal verdict, with its evidence."
    )
    p.add_argument("job_id", nargs="?", help="codex job id, e.g. task-abc123-def456")
    p.add_argument("--artifact", help="deliverable path the job must produce")
    p.add_argument("--token", help="final token the deliverable must end with")
    p.add_argument(
        "--stall-seconds",
        type=float,
        help="quiet time that counts as stalled; default is derived from this workspace's history",
    )
    p.add_argument("--hang-seconds", type=float, default=300.0)
    p.add_argument("--poll-seconds", type=float, default=30.0)
    p.add_argument("--timeout-seconds", type=float, default=3300.0)
    p.add_argument(
        "--estimate-seconds",
        type=float,
        help="expected run time; twice this without a verdict exits for investigation",
    )
    p.add_argument("--state-root", help="override where plugin state is searched")
    p.add_argument(
        "--once",
        action="store_true",
        help="evaluate one cadence and report alive instead of waiting",
    )
    p.add_argument("--selftest", action="store_true")
    return p


def check_durations(parser: argparse.ArgumentParser, args: argparse.Namespace) -> None:
    """NaN or a negative wait makes every deadline comparison false — refuse it up front."""
    for name in (
        "stall_seconds",
        "hang_seconds",
        "poll_seconds",
        "timeout_seconds",
        "estimate_seconds",
    ):
        value = getattr(args, name)
        if value is not None and not (math.isfinite(value) and value > 0):
            parser.error(f"--{name.replace('_', '-')} must be a positive finite number")


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    check_durations(parser, args)
    if args.selftest:
        loaded = unittest.defaultTestLoader.loadTestsFromName(__name__ + ".WatchTest")
        return (
            0 if unittest.TextTestRunner(verbosity=2).run(loaded).wasSuccessful() else 1
        )
    if not args.job_id:
        parser.print_usage(sys.stderr)
        return 2
    return watch(args)


class WatchTest(unittest.TestCase):
    """Completion rules from the codex-delegation skill. Run this file with --selftest."""

    def _state(self, workspace, job_id, status, log_age=0.0, stamps=()):
        import tempfile

        root = tempfile.mkdtemp()
        jobs = os.path.join(root, workspace, "jobs")
        os.makedirs(jobs)
        record = os.path.join(jobs, job_id + ".json")
        with open(record, "w", encoding="utf-8") as f:
            json.dump({"id": job_id, "status": status}, f)
        log = os.path.join(jobs, job_id + ".log")
        with open(log, "w", encoding="utf-8") as f:
            f.write("".join(f"[{s}Z] line\n" for s in stamps) or "x\n")
        os.utime(log, (time.time() - log_age, time.time() - log_age))
        return root, record, log

    def _code(self, status, age, ready, tree=None, tail=False):
        out = verdict(status, age, tree, ready, 420, 300, command_may_run=tail)
        self.assertIsNotNone(out, "terminal verdict を期待した")
        return out[0] if out else None

    def test_job_found_in_any_workspace(self):
        """隔離 worktree に登録された job も見つかる (本線 workspace 決め打ちにしない)。"""
        root, record, log = self._state("wt-review-deadbeef", "task-x", "running")
        self.assertEqual(find_jobs("task-x", [root]), [(record, log)])

    def test_job_absent_returns_nothing(self):
        root, _r, _l = self._state("ws", "task-x", "running")
        self.assertEqual(find_jobs("task-other", [root]), [])

    def test_duplicate_ids_are_all_returned(self):
        """同一 id が 2 件あるなら選ばずに全部返す — 黙って先頭を掴むと live job を取り違える。"""
        root, _r, _l = self._state("aaa-old", "task-dup", "cancelled")
        jobs = os.path.join(root, "zzz-live", "jobs")
        os.makedirs(jobs)
        with open(os.path.join(jobs, "task-dup.json"), "w", encoding="utf-8") as f:
            json.dump({"id": "task-dup", "status": "running"}, f)
        with open(os.path.join(jobs, "task-dup.log"), "w", encoding="utf-8") as f:
            f.write("x\n")
        self.assertEqual(len(find_jobs("task-dup", [root])), 2)

    def test_state_roots_follow_the_plugin_resolver(self):
        """plugin は CLAUDE_PLUGIN_DATA、無ければ temp dir を使う — 配布 path 決め打ちにしない。"""
        from unittest import mock

        with mock.patch.dict(os.environ, {PLUGIN_DATA_ENV: "/pd"}):
            roots = state_roots()
        self.assertEqual(roots[0], os.path.join("/pd", "state"))
        self.assertIn(os.path.join(tempfile.gettempdir(), "codex-companion"), roots)
        self.assertIn(STATE_ROOT, roots)
        self.assertEqual(state_roots("/only"), ["/only"])

    def test_queued_counts_as_alive(self):
        """companion の生存語彙は queued / running の 2 つ (source と実データで確認)。"""
        self.assertIsNone(verdict("queued", 5.0, None, False, 420, 300))

    def test_unknown_status_is_terminal(self):
        """未知の status は終了扱い — 生存側だけを列挙し、取りこぼしを待ち続けない。"""
        self.assertEqual(self._code("failed", 1.0, False), EXIT_NOT_COMPLETED)

