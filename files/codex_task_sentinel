    def test_a_deliverable_that_grows_while_read_is_bounded(self):
        """成果物も動く EOF を追わない — 追えば読み終わらず期限確認へ戻れない。"""
        from unittest import mock

        class Endless:
            def __init__(self) -> None:
                self.asked: list[int] = []

            def fileno(self) -> int:
                return 0

            def read(self, size: int) -> bytes:
                self.asked.append(size)
                return b"a" * size if len(self.asked) <= 50 else b""

            def __enter__(self):
                return self

            def __exit__(self, *_exc) -> bool:
                return False

        handle = Endless()
        size = (
            MAX_ARTIFACT_BYTES * 3 + 7
        )  # 上限を跨がないと 1 回当たりの量を pin できない
        fake = os.stat_result((stat.S_IFREG | 0o644, 0, 0, 1, 0, 0, size, 0, 0, 0))
        # reader の入口は os.open — 旧入口を mock すると test は緑のまま何も見なくなる。
        with (
            mock.patch("os.open", lambda *a, **k: 0),
            mock.patch("os.set_blocking", lambda *a, **k: None),
            mock.patch("os.fdopen", lambda *a, **k: handle),
            mock.patch("os.fstat", lambda _fd: fake),
        ):
            artifact_ready("/any/report.md", "TOKEN", 0.0)
        self.assertGreater(len(handle.asked), 1)  # 空振りせず、複数 chunk に割れたこと
        self.assertTrue(all(0 < n <= MAX_ARTIFACT_BYTES for n in handle.asked))
        self.assertEqual(sum(handle.asked), size)  # size を超えて追いかけていない

