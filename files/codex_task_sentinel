        real = scan_log

        def growing(path, *a, **k):
            out = real(path, *a, **k)
            with open(path, "a", encoding="utf-8") as stream:
                stream.write("[2026-08-09T01:45:38.190Z] Searching: newly appended\n")
            return out

        with (
            mock.patch.object(sys.modules[__name__], "scan_log", growing),
            redirect_stdout(io.StringIO()),
        ):
            code = watch(
                self._watch_args(
                    root, "task-x", once=True, stall_seconds=1.0, trust_log=True
                )
            )
        self.assertEqual(code, EXIT_ALIVE)

    def test_an_impossible_stamp_is_body_text_not_an_event(self):
