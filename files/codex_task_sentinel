STATE_ROOT = os.path.expanduser("~/.claude/plugins/data/codex-openai-codex/state")
# The plugin resolves its state root from CLAUDE_PLUGIN_DATA and falls back to
# the temp dir, so watching only the packaged path loses jobs it really started.
PLUGIN_DATA_ENV = "CLAUDE_PLUGIN_DATA"
# The cached companion carries its version in the path, so pinning one spells a
# cancel command that cannot run; the marketplace copy has no version to go stale.
COMPANION_GLOB = os.path.expanduser(
    "~/.claude/plugins/cache/openai-codex/codex/*/scripts/codex-companion.mjs"
)
COMPANION_FALLBACK = os.path.expanduser(
    "~/.claude/plugins/marketplaces/openai-codex/plugins/codex/scripts/codex-companion.mjs"
)
# The companion's own vocabulary for a job that is still going; anything else
# it writes is terminal. Listing the alive side keeps unseen end states terminal.
ALIVE_STATUS = frozenset({"queued", "running"})
# Only a job that finished on its own teaches how long healthy quiet lasts; the
# cancelled ones are the stalls this tool exists to catch (measured here: every
# completed job went quiet for at most 147s, every cancelled one for 697s+).
BASELINE_STATUS = "completed"
STALL_FLOOR_SECONDS = 420.0  # the skill's 7 min, used when history gives nothing larger
STALL_BASELINE_FACTOR = 3.0
# 秒以降を緩く受けると、 本文の [.. 00:00:01:99Z] のような不正 stamp が event に化け、
# 稼働中 command の start を偽の end で消してしまう。 runner はこの形しか書かない。
LOG_TS = re.compile(r"^\[(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?)Z\]")
# record の stamp は UTC 表記。 末尾まで固定しないと offset 付きや junk 付きが通る。
RECORD_TS = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?Z$")
# A log line is an event line plus, at worst, one shortened command; a body that
# runs longer than this is prose, and reading all of it only risks the verdict.
MAX_LOG_LINE = 8192
# 未完了 start の保持上限 — 実ログの最大は 3 件で、 これを超えるのは本文が作った偽 start。
MAX_PENDING = 512
# 成果物から読む上限。 これを超える file は末尾だけを見るので、 それより前の
# 不正 byte は検出できない (完了 token の判定には末尾で足りる)。
MAX_ARTIFACT_BYTES = 1 << 20

