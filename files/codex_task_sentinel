MAX_ARTIFACT_BYTES = 1 << 20
# record は job 1 件のメタデータ — 実機の最大は 1.3KB で、 これを超えるのは異常。
MAX_RECORD_BYTES = 1 << 20
# 1 回の走査の消費上限 — 実 size を上限にすると巨大 file 1 つで期限へ戻れない。
MAX_SCAN_BYTES = 64 << 20
# 同じ理由で entry 数も抑える — 実機の worktree は 4 桁で、超えるのは別ツリーである。
