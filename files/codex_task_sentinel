    def test_stamps_are_utc_whatever_the_local_zone(self):
        """plugin の stamp は末尾 Z の UTC — local time として読むと DST 境界で gap がずれる。"""
        original = os.environ.get("TZ")
        try:
            seen = []
            for zone in ("UTC", "America/New_York", "Asia/Tokyo"):
                os.environ["TZ"] = zone
                time.tzset()
                seen.append(
                    (
                        stamp_seconds("2026-03-08T06:30:00"),  # US DST 切替の前後
                        stamp_seconds("2026-03-08T07:30:00"),
                    )
                )
            self.assertEqual(len(set(seen)), 1, seen)
            first, second = seen[0]
            assert first is not None and second is not None
            self.assertEqual(second - first, 3600.0)
        finally:
            if original is None:
                os.environ.pop("TZ", None)
            else:
                os.environ["TZ"] = original
            time.tzset()

