        self.assertEqual(stall_threshold(None, 60.0), STALL_FLOOR_SECONDS)
        self.assertEqual(stall_threshold(None, 300.0), 900.0)
        self.assertEqual(stall_threshold(120.0, 300.0), 120.0)

    def test_tree_age_skips_git_and_reports_newest(self):
        import tempfile

        root = tempfile.mkdtemp()
        os.makedirs(os.path.join(root, ".git"))
