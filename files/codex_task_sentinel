# The skill's third condition — is a command still running — can only be guessed
# at. The plugin appends message bodies verbatim, so a body quoting a log line
# looks exactly like the event it quotes. The guess is therefore used in one
# direction only: it can suppress a verdict, never manufacture one. Suppression
# fires when a start has no matching end — commands run in parallel, so the tail
# alone misses one still running behind a neighbour's completion — or when the
# tail itself starts a command. A quoted start over-suppresses, which costs
# waiting. A quote is separated from an event by stamp order — the runner appends,
# so its stamps never go backwards, while a body citing an earlier line carries
# that older stamp — and ends are then paired to starts by the command they name.
# Measured over this machine's logs: 1150 events, none out of order, none dropped.
#
# Tracking where a body starts and ends was tried and removed: the format frames
# only the opening of a block, so following the body costs real events (a blank
# line inside a paragraph reads as the next block) to catch a case that needs a
# body to carry a stamp no earlier than every event so far — a fabricated stamp,
# not a quote. That residual is left named here rather than traded for lost events.
COMMAND_START = re.compile(r"^\[[^\]]+\]\s+Running command:")
COMMAND_END = re.compile(r"^\[[^\]]+\]\s+Command \w+:")


def state_roots(explicit: str | None = None) -> list[str]:
    """Every root the plugin may have written to, in the order it resolves them."""
    if explicit:
        return [explicit]
    roots = []
    plugin_data = os.environ.get(PLUGIN_DATA_ENV)
    if plugin_data:
        roots.append(os.path.join(plugin_data, "state"))
    roots.append(os.path.join(tempfile.gettempdir(), "codex-companion"))
    roots.append(STATE_ROOT)
    return list(dict.fromkeys(roots))


def find_jobs(job_id: str, roots: list[str]) -> tuple[list[tuple[str, str]], bool]:
    """Every (record, log) pair carrying this id, plus whether every root was readable.

    glob reports a directory it may not enter exactly as it reports an empty one,
    so an absent record and an unreadable branch would otherwise be the same
    answer — and only one of them means the launch never took.
    """
    found = []
    complete = True
    for root in roots:
        try:
            workspaces = bounded_names(root)
            if workspaces is None:
                complete = False  # 数え切れない広さから「唯一」も「不在」も言えない
                continue
        except FileNotFoundError:
            # 未作成の root は「無い」で正しいが、 走査後に現れたなら見落としである。
            if link_identity(root) is not None:
                complete = False
            continue
        except OSError:
            complete = False
            continue
        observed = []
        for workspace in workspaces:
            record = os.path.join(root, workspace, "jobs", job_id + ".json")
            # entry 自身を 1 度だけ見る — 壊れた symlink も「在る」 で、 不在ではない。
            try:
                identity = link_identity(record)
            except OSError:
                complete = False
                continue
            observed.append((record, identity))
            if identity is None:
                # 通常 file なら jobs/ を抱えられないので空で正しい。 消えた entry も
                # 辿れない link も不在の証明ではないので、 そこでは断定しない。
                workspace_path = os.path.join(root, workspace)
                if dangling(workspace_path) or dangling(
                    os.path.join(workspace_path, "jobs")
                ):
                    complete = False
                    continue
                try:
                    if link_identity(workspace_path) is None:
                        complete = False
                except OSError:
                    complete = False
                continue
            found.append((record, record[: -len(".json")] + ".log"))
        try:
            # 走査の前後で顔ぶれが変われば、 得た結果は 1 つの snapshot ではない。
            if bounded_names(root) != workspaces:
                complete = False
        except OSError:
            complete = False
        for record, identity in observed:
            # 名前一覧は proxy — 材料にした record 自身を、見た粒度のまま見直す。
            try:
                if link_identity(record) != identity:
                    complete = False
            except OSError:
                complete = False
    return found, complete


def bounded_names(root: str) -> list[str] | None:
    """Sorted entry names, or None when there are more than the cap allows.

    scandir one at a time: listdir materialises every name before any cap can
    look at the count, which is the cost the cap exists to avoid.
    """
    names = []
    with os.scandir(root) as entries:
        for entry in entries:
            if len(names) >= MAX_WORKSPACES:
                return None
            names.append(entry.name)
    return sorted(names)


def link_identity(path: str) -> tuple | None:
    """The entry itself at the grain it was read, or None when nothing is there."""
    try:
        st = os.lstat(path)
    except (FileNotFoundError, NotADirectoryError):
        return None
    return (st.st_dev, st.st_ino, st.st_mode, st.st_mtime_ns, st.st_size)


def job_record(record_path: str, job_id: str | None = None) -> dict | None:
    """The on-disk record, or None when it is there but unreadable — a corrupt
    record is an unknown outcome, not a quiet job."""
    return record_view(record_path, job_id)[1]


def record_view(path: str, job_id: str | None = None) -> tuple[tuple, dict | None]:
    """The record and a fingerprint of the very bytes it was parsed from.

    One open for both: comparing an outer fingerprint taken before and after a
    separate parse proves nothing about the bytes the parse actually saw, so
    A -> B -> A reads B's status as a stable snapshot of A.
    """
    try:
        with open_regular(path) as f:
            st = os.fstat(f.fileno())
            # log / 成果物と同じく上限を置く — record だけ無制限だと、 巨大または
            # 伸び続ける JSON ひとつで監視が読み終わらない。
            raw = f.read(MAX_RECORD_BYTES + 1)
    except FileNotFoundError:
        return ("absent",), None
    except OSError as exc:
        # 失敗どうしを 1 つに畳むと、 別々の失敗が等しくなって「不変」に化ける。
        return ("unopenable", exc.errno), None
    stamp = (st.st_dev, st.st_ino, st.st_size, hashlib.sha256(raw).digest())
    return stamp, _parse_record(raw, job_id)


def _parse_record(raw: bytes, job_id: str | None = None) -> dict | None:
    """The record these bytes hold, or None when they do not hold a usable one."""
    try:
        if len(raw) > MAX_RECORD_BYTES:
            return None
        loaded = json.loads(raw.decode("utf-8"))
    except (ValueError, RecursionError, UnicodeDecodeError):
        # 深くネストした JSON は ValueError ではなく RecursionError で来る。
        return None
    if not isinstance(loaded, dict):
        return None
    # JSON は型を約束しない。 後段は status を文字列、 workspaceRoot を path として
    # 扱うので、 違う型で来た record は読めなかったものとして exit 13 へ送る。
    for field in ("status", "workspaceRoot", "errorMessage"):
        if loaded.get(field) is not None and not isinstance(loaded[field], str):
            return None
        # JSON escape の lone surrogate は str を名乗るが、 印字時に例外で監視を終わらせる。
        try:
            str(loaded.get(field) or "").encode("utf-8")
        except UnicodeEncodeError:
            return None
    # 「field が無い」 と 「あるが読めない」 は別 — 畳むと古い createdAt へ落ちる。
    for field in ("startedAt", "createdAt"):
        if loaded.get(field) is not None and stamp_epoch(loaded[field]) is None:
            return None
    # worker が拾うのは作成後 — 逆なら record が壊れており、 古い方を鮮度の下限に
    # 使うと前 run の成果物を今回のものとして受理する。
    began, made = (
        stamp_epoch(loaded.get("startedAt")),
        stamp_epoch(loaded.get("createdAt")),
    )
    if began is not None and made is not None and began < made:
        return None
    # 空 status は alive と読まれて stall 判定まで進む。 file 名だけで id を信じると、
    # 別 job の状態をこの job の verdict にできる。
    if not (isinstance(loaded.get("status"), str) and loaded["status"].strip()):
        return None
    if job_id is not None and loaded.get("id") != job_id:
        return None
    return loaded


def open_regular(path: str):
    """A read handle on a regular file, checked on the descriptor that gets read.

    O_NONBLOCK keeps a fifo from parking the open, and fstat asks the descriptor
    rather than the name a second time — swapping the path between a stat and an
    open is exactly how a check on the name gets bypassed.
    """
    descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError(f"{path} is not a regular file")
        os.set_blocking(descriptor, True)
    except BaseException:
        os.close(descriptor)
        raise
    return os.fdopen(descriptor, "rb")


def record_gone(record_path: str) -> bool:
    """Whether the record is really absent — os.path.exists calls unreadable absent too."""
    try:
        os.lstat(record_path)
    except (FileNotFoundError, NotADirectoryError):
        # find_jobs と同じ意味で扱う — 祖先が file になったなら record は確かに無い。
        # ただし途中に辿れない link が在るなら、 消えたのではなく読めていない。
        path = os.path.dirname(record_path)
        while path and path != os.path.dirname(path):
            if dangling(path):
                return False  # 途中が辿れない — 消えたのではなく読めていない
            path = os.path.dirname(path)
        return True
    except OSError:
        return False  # 読めないだけ — 消失 (exit 10) ではなく corrupt / 検証不能の側
    return False


def file_stat(path: str | None) -> tuple[int, int, int, int] | None:
    """One snapshot of a file, identity included; None when it is absent.

    dev and ino are part of it because a replacement can carry the same mtime
    and size, and then two different files compare as one unchanged snapshot.
    mtime is nanoseconds: a second-grained one calls a rewrite within the same
    second unchanged, which is the whole question these comparisons ask.
    """
    try:
        st = os.stat(path) if path else None
    except OSError:
        return None
    return (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_size) if st else None


def record_stamp(path: str) -> tuple:
    """What the record was, bytes included — metadata alone misses a same-size rewrite."""
    return record_view(path)[0]


def dangling(path: str) -> bool:
    """Whether the entry is a link whose target cannot be reached."""
    try:
        identity = link_identity(path)
    except OSError:
        return True  # entry の種別すら読めない — 不在の証明にはならない
    if identity is None or not stat.S_ISLNK(identity[2]):
        return False
    try:
        os.stat(path)
    except OSError:
        return True
    return False


def deadline_reached(deadline: float, margin: float = 0.0) -> bool:
    """Whether the watch has run out of time — measured as elapsed, never as a clock."""
    return time.monotonic() + margin > deadline


def sleep_until(deadline: float, poll_seconds: float) -> None:
    """Wait one cadence at most, and never past the deadline the caller was promised.

    Capped because a finite but enormous cadence overflows time.sleep on some
    platforms, and a traceback is not one of the exits this tool promises.
    """
    time.sleep(
        max(0.0, min(poll_seconds, deadline - time.monotonic(), MAX_SLEEP_SECONDS))
    )


def heartbeat_age(log_path: str, now: float) -> float | None:
    """Seconds since the job log last grew; None when the log is absent."""
    try:
        return now - os.path.getmtime(log_path)
    except OSError:
        return None


def log_lines(
    log_path: str, onerror: Callable[[], None] | None = None
) -> Iterator[str]:
    """Non-empty log lines, newest last, left edge intact so events can be anchored.

    Streamed, and each line is cut at MAX_LOG_LINE: the plugin appends message
    bodies with no size limit, so one agent turn can be a single line larger than
    the memory this tool may use, and a verdict lost to MemoryError helps nobody.
    """
    try:
        # byte で読む — 置換後の文字列長で数えると、 消費 byte と一致せず
        # 上限が狂い、 未読を残したまま「全量を読んだ」 と扱いうる。
        with open_regular(log_path) as f:
            # 開いた時点の size を上限にする — 動く EOF を追うと、 追記が読みより
            # 速い log で読み終わらず、 期限確認にすら戻れない。
            size = os.fstat(f.fileno()).st_size
            budget = min(size, MAX_SCAN_BYTES)
            if budget < size:
                # 全量を読むと期限へ戻れない。 末尾だけ見て、 部分と申告する。
                f.seek(size - budget)
                if onerror is not None:
                    onerror()
            dropping = False
            while budget > 0:
                chunk = f.readline(min(MAX_LOG_LINE, budget))
                if not chunk:
                    return
                budget -= len(chunk)
                whole = chunk.endswith(b"\n")
                if dropping:  # 長すぎる行の残り — 頭の 1 片だけを 1 行として扱う
                    dropping = not whole
                    continue
                dropping = not whole
                line = chunk.rstrip(b"\n").decode("utf-8", "replace")
                if line.strip():
                    yield line
    except FileNotFoundError:
        # 辿れない link は「まだ書かれていない」 ではない — 短い view として申告する。
        if dangling(log_path) and onerror is not None:
            onerror()
        return
    except OSError:
        # 途中で読めなくなった view は短い。 未完了 start を落として stall 抑止を
        # 消しうるので、 「読めた分」 を全量として扱わせない。
        if onerror is not None:
            onerror()
        return


def _tee(lines: Iterator[str], sink: collections.deque) -> Iterator[str]:
    """Pass lines through while the sink keeps a window of the most recent ones."""
    for line in lines:
        sink.append(line)
        yield line


def scan_log(
    log_path: str, count: int = 6, limit: int = 200
) -> tuple[list[str], list[str], bool]:
    """One pass giving (unfinished commands, bounded tail, whole log read) from one snapshot.

    Reading twice lets the runner append in between, so a verdict could rest on a
    quiet log while the evidence beside it shows the command that arrived after —
    with --trust-log that pairs a cancel instruction with proof of work.
    """
    tail: collections.deque = collections.deque(maxlen=count)
    whole = True

    def truncated() -> None:
        nonlocal whole
        whole = False

    pending = pending_commands(_tee(log_lines(log_path, truncated), tail))
    return pending, [ln.strip()[:limit] for ln in tail], whole


def command_text(line: str) -> str:
    """The command an event line refers to, with the end line's exit suffix removed."""
    body = re.sub(r"^\[[^\]]+\]\s+(Running command:|Command \w+:)\s*", "", line)
    return re.sub(r"\s*\(exit -?\d+\)\s*$", "", body).strip()


def stamp_seconds(stamp: str) -> float | None:
    """Epoch seconds for a log stamp, or None when it only looks like a date.

    The regex matches on character shape, and message bodies reach the log
    verbatim, so a fixture like [9999-99-99T99:99:99.000Z] is ordinary input.
    Parsing it where the caller cannot see costs the whole watch.
    """
    try:
        # 末尾 Z のとおり UTC — mktime は local time として読むため、 DST 境界を挟む
        # 2 点の差がその分ずれ、 baseline と stall 判定が動く。
        whole = calendar.timegm(time.strptime(stamp[:19], "%Y-%m-%dT%H:%M:%S"))
        # 小数を捨てると gap が最大 1 秒短くなり、 その 3 倍だけ threshold が下がる。
        return whole + float("0" + stamp[19:].rstrip("Z") or 0)
    except (ValueError, OverflowError):
        return None


def event_lines(lines: Iterator[str] | list[str]) -> Iterator[str]:
    """Log lines the runner itself wrote, in order.

    Events are appended, so their stamps never go backwards. A message body that
    quotes an earlier log line carries that older stamp, which is what separates
    the quote from the event it otherwise looks exactly like.
    """
    high = ""
    for line in lines:
        m = LOG_TS.match(line)
        if not m or stamp_seconds(m.group(1)) is None:
            continue  # 形だけ日付に見える本文 — 採用すると以降の event を丸ごと落とす
        if m.group(1) < high:
            continue
        high = m.group(1)
        yield line


def pending_commands(lines: Iterator[str] | list[str]) -> list[str]:
    """Commands started and never seen to finish, oldest first.

    Ends are matched to starts by the command they name; the plugin shortens that
    text to 96 characters, so two long commands can share a key. An end matching
    nothing pending is dropped rather than allowed to cancel a running start.
    Held to MAX_PENDING: a body can forge any number of starts, and each is short
    enough to pass the per-line bound while the list itself grows without one.
    """
    pending: list[str] = []
    for line in event_lines(lines):
        if COMMAND_START.match(line):
            if len(pending) < MAX_PENDING:
                pending.append(command_text(line))
        elif COMMAND_END.match(line):
            text = command_text(line)
            for i in range(len(pending) - 1, -1, -1):
                if pending[i] == text:
                    del pending[i]
                    break
    return pending


def command_may_be_running(lines: Iterator[str] | list[str]) -> bool:
    """Whether a command might still be in flight — used only to hold a verdict back."""
    return bool(pending_commands(lines))


def tree_age(root: str | None, now: float) -> float | None:
    """Seconds since the newest write under the job's tree; None when unknowable."""
    if not isinstance(root, str) or not root or not os.path.isdir(root):
        return None
    newest = None
    unreadable = False
    budget = MAX_TREE_ENTRIES
    # 削除・rename・空 dir の作成は、 どの file の mtime にも残らず親 dir にだけ残る。
    # dirs も測る — 辿らない directory symlink は base として現れないので、
    # files だけ見ていると entry 自体が走査から漏れる。
    pending, measured = [root], [root]
    while pending:
        try:
            # os.walk は 1 dir を list 化してから渡すので、 巨大な dir では上限が効かない。
            with os.scandir(pending.pop()) as entries:
                for entry in entries:
                    budget -= 1
                    if budget < 0:
                        return None  # 走査しきれない広さ — 静穏の根拠にならない
                    if entry.name == ".git":
                        continue
                    measured.append(entry.path)
                    if entry.is_dir(follow_symlinks=False):
                        pending.append(entry.path)
        except FileNotFoundError:
            # 走査中に消えた dir は file と同じく 「たった今の書き込み」。
            newest = now if newest is None else max(newest, now)
        except OSError:
            unreadable = True  # 走査できなかった subtree の中は、書き込み中かもしれない
    for path in measured:
        # lstat で entry 自身を測る — getmtime は link を辿るので、 tree の外の
        # 頻繁に更新される target が job の活動として数えられてしまう。 ただし
        # root 自身が symlink なら、 監視対象はその target dir そのものである。
        try:
            mtime = (os.stat(path) if path == root else os.lstat(path)).st_mtime
        except FileNotFoundError:
            mtime = now  # 一覧にあった entry が消えた = たった今の書き込み
        except OSError:
            mtime = None
        if mtime is None:
            unreadable = True
            continue
        if newest is None or mtime > newest:
            newest = mtime
    if unreadable:
        return None
    return None if newest is None else now - newest


def longest_silence(log_path: str) -> float | None:
    """The runner's longest quiet spell in this log; None when it holds no pair of stamps.

    Reads the same stamp-ordered view the command pairing uses: a quoted line
    would otherwise open a fake gap and teach the baseline that this workspace
    routinely goes quiet for as long as that quote is old. Carries one stamp at
    a time — a completed log is hundreds of thousands of short event lines, and
    a list per line is the same exhaustion a huge single line was.
    """
    worst = None
    previous = None
    whole = True

    def truncated() -> None:
        nonlocal whole  # 短い view の最大 gap は、その log の最大 gap ではない
        whole = False

    for line in event_lines(log_lines(log_path, truncated)):
        m = LOG_TS.match(line)
        stamp = stamp_seconds(m.group(1)) if m else None
        if stamp is None:
            continue
        if previous is not None and (worst is None or stamp - previous > worst):
            worst = stamp - previous
        previous = stamp
    return worst if whole else None


def baseline_silence(
    jobs_dir: str, exclude: str, now: float, settle_seconds: float = 0.0
) -> tuple[float | None, bool]:
    """Longest quiet spell among completed jobs here, and whether all were counted.

    Scoped to one workspace on purpose: a slow job in an unrelated workspace
    would otherwise raise the threshold here and hide a real stall.
    """
    worst = None
    peers = []
    # glob は候補名を一括で作るので、 数え切る前に 1 件ずつ受け取って打ち切る。
    with os.scandir(jobs_dir) as entries:
        for entry in entries:
            if not entry.name.endswith(".json"):
                continue
            if len(peers) >= MAX_PEERS:
                return None, False  # 数え切れない — 読めた分は全体の最大値ではない
            peers.append(entry.path)
    for record_path in sorted(peers):
        peer_id = os.path.basename(record_path)[: -len(".json")]
        if peer_id == exclude:
            continue
        record = job_record(record_path, peer_id)
        if record is None or record.get("status") != BASELINE_STATUS:
            continue
        peer_log = record_path[: -len(".json")] + ".log"
        # completed と書かれてから最終 block が append されるまでの窓で読むと、
        # その peer の本当の gap を欠いた低い baseline になる。 落ち着くまで数えない。
        # log だけ見ると、 古い log を持つ peer が今 completed になった窓を通す。
        before = file_stat(peer_log)
        marked = file_stat(record_path)
        if before is None or marked is None:
            continue
        if now - max(before[2], marked[2]) / 1e9 < settle_seconds:
            continue
        quiet = longest_silence(peer_log)
        if file_stat(peer_log) != before or file_stat(record_path) != marked:
            continue  # 読んでいる間に伸びた peer は、この poll の手本にならない
        if quiet is not None and (worst is None or quiet > worst):
            worst = quiet
    return worst, True


def stall_threshold(explicit: float | None, baseline: float | None) -> float:
    """Explicit wins; otherwise the floor, raised past this workspace's own worst quiet spell."""
    if explicit is not None:
        return explicit
    if baseline is None:
        return STALL_FLOOR_SECONDS
    return max(STALL_FLOOR_SECONDS, baseline * STALL_BASELINE_FACTOR)


def run_since(record: dict) -> float | None:
    """The earliest instant this run could have written anything; None before it ran.

    startedAt is added when the worker picks the job up, so a job still queued has
    written nothing — falling back to createdAt would let a file someone else
    touched after the job was created count as this run's deliverable.
    """
    return stamp_epoch(record.get("startedAt"))


def stamp_epoch(stamp: object) -> float | None:
    """An ISO UTC stamp as epoch seconds, fraction kept; None when unusable.

    Keeps the fraction: truncating to the second lets a file written earlier in
    the same second pass as this run's output.
    """
    # fullmatch で終端まで固定する — `$` は末尾の改行の手前にも一致してしまう。
    matched = RECORD_TS.fullmatch(stamp) if isinstance(stamp, str) else None
    if not matched:
        return None  # 末尾まで見ないと +09:00 や junk 付きを UTC として採ってしまう
    try:  # the record stamps UTC, so read it as UTC rather than through local time
        whole = float(
            calendar.timegm(time.strptime(matched.group(1), "%Y-%m-%dT%H:%M:%S"))
        )
    except ValueError:
        return None
    return whole + float(matched.group(2)) if matched.group(2) else whole


def artifact_ready(
    path: str | None, token: str | None, since: float | None = None
) -> bool | None:
    """Whether the deliverable is this run's finished output; None when it cannot be read.

    `since` is the earliest instant this run could have written. With no floor
    there is nothing separating this run's output from an earlier run's, so the
    answer is no rather than a guess.
    """
    if not path or since is None:
        return False
    decoder = codecs.getincrementaldecoder("utf-8")()
    body = ""
    # 保持するのは末尾だけなので、 「どこかに中身があったか」 は読みながら覚えておく。
    seen_content = False
    try:
        # 本文と鮮度は同じ descriptor の同じ瞬間から取る — path で stat し直すと、
        # 置換された別 inode の mtime が古い本文の完了 token と組になりうる。
        with open_regular(path) as f:
            before = os.fstat(f.fileno())
            # 全体を先頭から strict decode するので途中の不正 byte も落ちる。 保持は
            # 末尾だけ — 全量を持つと巨大な成果物ひとつで MemoryError になる。
            # 読む総量は開いた時点の size まで — 動く EOF を追うと読み終わらない。
            if before.st_size > MAX_SCAN_BYTES:
                return None  # 読み切れない大きさ — 完成とも未完成とも言えない
            remaining = before.st_size
            while remaining > 0 and (
                chunk := f.read(min(MAX_ARTIFACT_BYTES, remaining))
            ):
                remaining -= len(chunk)
                body += decoder.decode(chunk)
                seen_content = seen_content or bool(body.strip())
                body = body[-MAX_ARTIFACT_BYTES:]
            body += decoder.decode(b"", True)
            seen_content = seen_content or bool(body.strip())
            body = body[-MAX_ARTIFACT_BYTES:]
            after = os.fstat(f.fileno())
    except FileNotFoundError:
        # 辿れない link は entry が在る — 無いのではなく読めないので 3 値の None。
        return None if dangling(path) else False
    except UnicodeDecodeError:
        # 置換して読むと、 binary の末尾行が token と一致して完成品に化ける。
        return False
    except OSError:
        return None  # 在るのに読めない — 「成果物なし」と断定してよい根拠がない
    if (before.st_mtime_ns, before.st_size) != (after.st_mtime_ns, after.st_size):
        return False  # 読んでいる間に伸びた = まだ書かれている最中
    try:
        # 読み終えた inode が今も その path か — 読取中だけ在った成果物を ready に
        # すると、 外側の「不在 → 不在」比較では変化として拾えない。
        named = os.stat(path)
    except OSError:
        return False
    if (named.st_dev, named.st_ino) != (after.st_dev, after.st_ino):
        return False
    if after.st_mtime < since:
        return False  # a leftover from an earlier run is not this run's output
    if not token:
        return seen_content
    # The order says the final line IS the token: no padding, no trailing blanks.
    lines = body.splitlines()
    return bool(lines) and lines[-1] == token


def version_key(path: str) -> tuple[int, ...]:
    """The version directory of a cached plugin path, ordered numerically not lexically."""
    part = path.split(os.sep)[-3] if path.count(os.sep) >= 3 else ""
    return tuple(int(x) if x.isdigit() else 0 for x in part.split("."))


def companion_path() -> str | None:
    """The companion this machine actually has; None when neither copy is present."""

    def usable(path: str) -> bool:
        # node に渡す script — 在るだけでは足りず、 読める通常 file である必要がある。
        return os.path.isfile(path) and os.access(path, os.R_OK)

    found = [path for path in glob.glob(COMPANION_GLOB) if usable(path)]
    if found:
        return max(found, key=version_key)
    return COMPANION_FALLBACK if usable(COMPANION_FALLBACK) else None


def cancel_command(job_id: str, root: str | None) -> str:
    """The cancel the operator would otherwise have to assemble, cwd included."""
    companion = companion_path()
    if companion is None:
        # 在りかを言えないなら、 動かない command を印字するより言えないと言う。
        return f"codex plugin's companion script not found — cancel {job_id} from the plugin"
    # job id も quote する — 印字した command はそのまま shell に貼られる。
    node = f"node {shlex.quote(companion)} cancel {shlex.quote(job_id)} --json"
    # 無い dir へ cd する command を出しても実行できない — 出せる形だけを出す。
    # 存在するだけでは足りない — 検索権が無い dir への cd は Permission denied になる。
    if not (root and os.path.isdir(root) and os.access(root, os.X_OK)):
        return node
    return f"(cd {shlex.quote(root)} && {node})"


def verdict(
    status: str,
    age: float | None,
    tree: float | None,
    ready: bool | None,
    stall_seconds: float,
    hang_seconds: float,
    expects_artifact: bool = True,
    command_may_run: bool = False,
    trust_log: bool = False,
) -> tuple[int, str] | None:
    """Terminal (exit code, headline) for one poll, or None to keep watching."""
    alive_status = status in ALIVE_STATUS or not status
    if not alive_status:
        # Only the companion's own success status is success; cancel and failure
        # are what this tool exists to catch, deliverable on disk or not.
        if status != BASELINE_STATUS:
            # Say when a complete deliverable is nonetheless sitting there: the
            # run is still not a result, but re-issuing blind wastes what exists.
            left = " — a complete deliverable is present, so read it before re-issuing"
            return EXIT_NOT_COMPLETED, (
                f"not-completed: job {status} — re-issue on a fresh thread "
                f"(a cancelled or failed run is not a result){left if ready else ''}"
            )
    # cancel / 失敗は成果物を読めるかに関わらず結果ではないので、 その先で見る。
    # 生存中も completed も、 読めない成果物からは done も stall も言えない。
    if expects_artifact and ready is None:
        return EXIT_UNVERIFIABLE, (
            "unverifiable: the deliverable is there but could not be read, so it can "
            "be shown neither finished nor missing — check the path below"
        )
    if not alive_status:
        # The skill's completion is status AND a settled tree: a task can leave
        # a detached process still writing after the runner reports completed.
        # That gates the missing-deliverable verdict too — the writer still going
        # may be the one about to finish it.
        if tree is None:
            return EXIT_UNVERIFIABLE, (
                "unverifiable: the job reports completed but its tree could not be "
                "read, so the work cannot be shown to have settled — check workspaceRoot"
            )
        if tree < hang_seconds:
            return None  # still settling; re-check rather than hand over mid-write
        if not (ready or not expects_artifact):
            return EXIT_ENDED_WITHOUT_ARTIFACT, (
                "ended-without-deliverable: job completed with no complete deliverable — "
                "the log's tail below is what it reported instead"
            )
        return EXIT_DONE, "done: job completed and its tree settled"
    if not expects_artifact:
        ready = False  # nothing to be ready; only the tree and the log speak here
    settled = hang_seconds if ready else stall_seconds
    if age is not None and age < settled:
        return None
    if tree is not None and tree < settled:
        return None  # writing files is working, whatever the log says
    if command_may_run:
        # A read-only command writes nothing, so quiet tree + quiet log is also
        # what a working one looks like. The tail cannot settle it either way.
        return EXIT_UNVERIFIABLE, (
            "unverifiable: a command started and was never seen to finish, and a "
            "read-only one leaves the tree quiet too — read the tail below before "
            "cancelling anything"
        )
    if tree is None:
        # Both quiet conditions the skill requires must be observed, not assumed.
        return EXIT_UNVERIFIABLE, (
            "unverifiable: the log went quiet but this job's tree could not be read, "
            "so neither stall nor progress can be shown — check workspaceRoot below"
        )
    if not trust_log:
        # The same log bytes can spell a real event or a body quoting one, so a
        # quiet log is handed over with its tail instead of as an order to cancel.
        return EXIT_UNVERIFIABLE, (
            "unverifiable: log and tree are both quiet, which is what a hung runner "
            "and a command the log never attributed both look like — read the tail "
            "below and cancel with the command shown if it is really hung "
            "(--trust-log makes this a stall verdict instead)"
        )
    if ready:
        return EXIT_DONE_HUNG, (
            "done-hung: deliverable ready but the runner is still registered — "
            "verify the deliverable, then cancel the job"
        )
    return EXIT_STALL, (
        "stall: the runner went quiet and the tree stopped changing — read the tail "
        "below first, since a command whose start the log did not attribute cleanly "
        "can look the same"
    )


def printable(text: object) -> str:
    """External text with control characters escaped — it is printed to a terminal.

    The plugin appends message bodies verbatim, so a body carrying CR or an escape
    sequence can erase the headline above it or forge a cancel line beneath it.
    """
    return "".join(
        ch if ch.isprintable() or ch == " " else f"\\x{ord(ch):02x}" for ch in str(text)
    )


def evidence(
    job_id: str,
    record: dict,
    log: str,
    age: float | None,
    tree: float | None,
    threshold: float,
    baseline: float | None,
    artifact: str | None = None,
    ready: bool | None = False,
    unfinished: list[str] | None = None,
    tail: list[str] | None = None,
    whole_log: bool = True,
) -> str:
    """Everything the verdict rests on, so no follow-up investigation is needed."""
    root = record.get("workspaceRoot")
    quiet = "log なし" if age is None else f"{int(age)}s"
    versus = (
        f" (この workspace の完走 job の最長無音 {int(baseline)}s の "
        f"{age / baseline:.1f} 倍)"
        if baseline and age
        else ""
    )
    shown = tail or ["(なし)"]
    # exit 14 は ready を verdict へ畳むので、畳んだ値をここで戻さないと成果物あり / なしが読めない。
    state = "unreadable" if ready is None else ("ready" if ready else "not ready")
    made = f"{state} {printable(artifact)}" if artifact else "指定なし"
    lines = [
        f"  job    : {printable(job_id)} "
        f"status={printable(record.get('status') or '不明')} "
        f"root={printable(root or '不明')}",
        # 読み切れなかった view の静穏と tail を、 完全なものとして見せない。
        f"  無音   : {quiet}{versus} / しきい値 {int(threshold)}s"
        + ("" if whole_log else " (log を最後まで読めず)"),
        # None は 「静穏」 ではなく 「読めなかった」 — headline と強さを揃える。
        f"  ツリー : {'不明 (workspaceRoot を読めないか対象 file なし)' if tree is None else f'最終書き込み {int(tree)}s 前'}",
        f"  成果物 : {made}",
        f"  末尾   : {printable(shown[0])}",
        *(f"           {printable(ln)}" for ln in shown[1:]),
    ]
    if unfinished:
        rest = f" 他 {len(unfinished) - 5} 件" if len(unfinished) > 5 else ""
        lines.append(f"  未完了 : {printable(' / '.join(unfinished[:5]))}{rest}")
    # 失敗理由は record が持っている — 出さなければ呼び手が同じ file を手で開き直すだけ。
    failure = record.get("errorMessage")
    if isinstance(failure, str) and failure.strip():
        lines.append(f"  エラー : {printable(failure.strip()[:200])}")
    lines += [
        f"  log    : {printable(log)}",
        f"  cancel : {printable(cancel_command(job_id, root if isinstance(root, str) else None))}",
    ]
    return "\n".join(lines)


def carrying_records(
    found: list[tuple[str, str]], job_id: str
) -> tuple[list[tuple[str, str]], bool]:
    """Candidates whose body really claims the id, and whether all were readable."""
    carried = []
    readable = True
    for pair in found:
        before = record_stamp(pair[0])
        stamp, loaded = record_view(pair[0])
        # 判断に使った bytes そのものが、 前後どちらとも同じであることを要求する。
        if (
            loaded is None
            or before[0] in ("absent", "unopenable")
            or stamp != before
            or record_stamp(pair[0]) != before
        ):
            readable = False  # 読めなかっただけ — 名乗っていない証明にはならない
            continue
        if loaded.get("id") == job_id:
            carried.append(pair)
    return carried, readable


def watch(args: argparse.Namespace, roots: list[str] | None = None) -> int:
    roots = roots if roots is not None else state_roots(args.state_root)
    deadline = time.monotonic() + args.timeout_seconds
    started = time.monotonic()
    found: list[tuple[str, str]] = []
    seen_pairs: set[tuple[str, str]] = set()
    while not found:
        found, complete = find_jobs(args.job_id, roots)
        if found:
            # file 名の一致は所属の証明ではない — 本文が名乗るものだけを候補にする。
            # 読めなかった候補は「別 job」の証明にならないので、その回は絞らない。
            carried, all_carried = carrying_records(found, args.job_id)
            found = carried if all_carried else found
            if len(found) > 1:
                print(
                    f"ambiguous: {len(found)} records carry the id "
                    f"{printable(args.job_id)}"
                )
                for record, _log in found:
                    print(f"  {printable(record)}")
                return EXIT_AMBIGUOUS
        if found and complete:
            # 「その 1 件が過去にも見えた」 では足りない — A→B と替わった後の B も通る。
            if seen_pairs - {found[0]}:
                # 前に見たのと別の record — 同じ id でも同じ job とは限らない。
                print(
                    f"unverifiable: {printable(args.job_id)} resolved to a different "
                    f"record than the one seen earlier"
                )
                for pair in sorted(seen_pairs | {found[0]}):
                    print(f"  {printable(pair[0])}")
                return EXIT_UNVERIFIABLE
            break
        # 走査しきれていない 1 件は「唯一」の証明にならないが、 どれを見たかは事実。
        # bool に畳むと、 後から別 path の同名 record へ黙ってすり替わる。
        seen_pairs.update(found)
        found = []
        if args.once:
            # --once は 1 cadence で返す約束。 ただし走査が不完全、 または一度でも
            # record を見ているなら 「未登録」 とは言えない。
            if complete and not seen_pairs:
                print(f"alive: {printable(args.job_id)} is not registered yet")
                print(f"  searched: {printable(', '.join(roots))}")
                return EXIT_ALIVE
            print(
                f"unverifiable: {printable(args.job_id)} could not be shown "
                f"unregistered in one cadence"
            )
            print(f"  searched: {printable(', '.join(roots))}")
            return EXIT_UNVERIFIABLE
        # 終局は実期限で決める — margin を足すと、 待つと約束した時間内の登録を取り逃す。
        if deadline_reached(deadline):
            if not complete or seen_pairs:
                # 走査しきれていない、 または一度は見えた — どちらも
                # 「登録されていない」 とは言えない。
                print(
                    f"unverifiable: the state tree could not be read in full or the "
                    f"record was seen and then lost, so {printable(args.job_id)} "
                    f"cannot be shown to be unregistered"
                )
                print(f"  searched: {printable(', '.join(roots))}")
                return EXIT_UNVERIFIABLE
            print(f"never-registered: no state record for {printable(args.job_id)}")
            print(f"  searched: {printable(', '.join(roots))}")
            return EXIT_NEVER_REGISTERED
        sleep_until(deadline, args.poll_seconds)
    record_path, log = found[0]
    if deadline_reached(deadline):
        # 登録待ちを抜けた時点で期限なら、 1 度も観測せずに新しい poll を始めない。
        print(
            f"timeout: registered but not observed within {int(args.timeout_seconds)}s"
        )
        print(f"  job    : {printable(args.job_id)} record={printable(record_path)}")
        return EXIT_TIMEOUT
    jobs_dir = os.path.dirname(record_path)
    # 同じ path が別 inode へ差し替わっても、 内容が同じなら record 比較では気付けない。
    record_inode = (file_stat(record_path) or (None, None))[:2]
    last_report: tuple[str, str] | None = None
    while True:
        # 期限に達していたら新しい poll を始めない — 期限後の状態から出た verdict が
        # timeout に勝ってしまう。 一貫した poll が 1 度も無い場合は下の破棄分岐が
        # 理由付きの exit 14 を返すので、 ここは判定を持てた場合だけを引き受ける。
        if last_report is not None and deadline_reached(deadline):
            print(
                f"timeout: no terminal verdict within {int(args.timeout_seconds)}s "
                f"(record says {last_report[0]})"
            )
            print(last_report[1])
            return EXIT_TIMEOUT
        now = time.time()
        # Scope the baseline to this job's own workspace: a slow neighbour must not
        # raise the bar here (a foreign 3600s gap once hid a two-hour stall). Read
        # it every poll — a peer's record goes completed before its last block is
        # appended, so a baseline taken once can be missing that job's real gap.
        baseline, counted_all = baseline_silence(
            jobs_dir, args.job_id, now, args.hang_seconds
        )
        threshold = stall_threshold(args.stall_seconds, baseline)
        record_before = record_stamp(record_path)
        record_view_stamp, record = record_view(record_path, args.job_id)
        # 1 poll 1 走査 — verdict も evidence も同じ結果を使い、読み直さない。 走査の
        # 前後で観測対象が動いたら、 その poll は古い無音と新しい本文の混成になる。
        before = (file_stat(log), file_stat(args.artifact))
        unfinished, tail, whole_log = scan_log(log)
        log_incomplete = not whole_log
        age = heartbeat_age(log, now)
        tree = tree_age((record or {}).get("workspaceRoot"), now)
        ready = artifact_ready(args.artifact, args.token, run_since(record or {}))
        # Elapsed runs from the job's own start so re-arming does not reset the clock;
        # without that stamp it is this watch's own elapsed, which no clock change moves.
        job_started = stamp_epoch((record or {}).get("startedAt"))
        elapsed = (
            now - job_started if job_started is not None else time.monotonic() - started
        )
        # 監視開始後に同じ id の record が増えても、 固定した path だけ見ていては気付けない。
        seen, scanned_all = find_jobs(args.job_id, roots)
        duplicates: list[tuple[str, str]] = []
        if seen:
            carried, all_carried = carrying_records(seen, args.job_id)
            seen = carried if all_carried else seen
            duplicates = seen if len(seen) > 1 else []
        # plugin は record を completed に書いてから final output を append する。
        # その窓に入った poll は、 古い running のまま静穏を読んで stall と言える。
        # 前後一致は中間値との一致を証明しない — parse が見た bytes も同じと要求する。
        record_changed = (
            record_stamp(record_path) != record_before
            or record_view_stamp != record_before
        )
        changed = (
            (file_stat(log), file_stat(args.artifact)) != before
            or record_changed
            # os.walk は snapshot ではないので、 列挙済み file への書き込みは
            # 走査し直さない限りこの poll から丸ごと抜け落ちる。
            or tree_age((record or {}).get("workspaceRoot"), now) != tree
            # threshold の出どころも同じ poll のもの — peer が後から伸びると、
            # 古い低い bar と新しい対象 snapshot の組で stall を断定できる。
            or baseline_silence(jobs_dir, args.job_id, now, args.hang_seconds)[0]
            != baseline
        )
        # 「動いた」 と 「読めなかった」 は別の理由 — 畳むと headline がどちらも
        # 「読取中に変わった」 になり、 安定して読めない log が活動に化ける。
        record_moved = (
            not scanned_all
            or seen != [(record_path, log)]
            # watch 全体の同一性 — mtime と size は heartbeat で動くのが正常である。
            or (file_stat(record_path) or (None, None))[:2] != record_inode
        )
        # 全ての read を終えた後に評価する — 途中の一時点では跨ぎを取りこぼす。
        observed_late = deadline_reached(deadline)
        unreadable = log_incomplete or record_moved or not counted_all
        # cancel / 失敗は他を読めるかに依らず結果ではない — 静穏 gate より先に置く。
        settled = str((record or {}).get("status") or "")
        # 完了は「成果物 + disk の record」で決まる — log の可読性はその条件にない。
        decided_by_record = (
            record is not None
            and not record_moved
            and not record_changed
            and settled
            and settled not in ALIVE_STATUS
        )
        if record_gone(record_path):
            # The plugin prunes to its newest 50 jobs regardless of status, so a
            # record that was here and is gone is lost history, not a verdict.
            out = (
                EXIT_VANISHED,
                "vanished: the state record disappeared after registration — "
                "the plugin prunes old jobs, so this job's outcome is unknowable here",
            )
        elif decided_by_record:
            out = verdict(
                settled,
                age,
                tree,
                ready,
                threshold,
                args.hang_seconds,
                expects_artifact=args.artifact is not None,
                command_may_run=bool(unfinished),
                trust_log=args.trust_log,
            )
        elif changed or unreadable:
            # 走査中に動いた観測は古い無音と新しい本文の混成 — その組で判定しない。
            # corrupt より先に見る: 読めたり読めなかったりする record は変化であって、
            # 確定した corrupt ではない。
            out = None
        elif record is None:
            out = (
                EXIT_CORRUPT,
                "corrupt: the state record is present but unreadable — the job's "
                "outcome cannot be read from it, so do not treat this as a stall",
            )
        else:
            out = verdict(
                str(record.get("status") or ""),
                age,
                tree,
                ready,
                threshold,
                args.hang_seconds,
                expects_artifact=args.artifact is not None,
                command_may_run=bool(unfinished),
                trust_log=args.trust_log,
            )
        if duplicates and not observed_late:
            print(
                f"ambiguous: {len(duplicates)} records carry the id "
                f"{printable(args.job_id)}"
            )
            for duplicate, _log in duplicates:
                print(f"  {printable(duplicate)}")
            return EXIT_AMBIGUOUS
        if out is not None and observed_late:
            out = None  # 期限後に初めて見た状態は、 期限内の終局判定にならない
        # 破棄した poll をそのまま下の分岐へ流すと、 混成した snapshot が exit 12 / 7 / 11 の
        # evidence として出る。 期限前なら取り直し、 期限か --once なら理由を名指しで返す。
        if out is None and (changed or unreadable):
            if not (args.once or deadline_reached(deadline)):
                sleep_until(deadline, args.poll_seconds)
                continue
            out = (
                (
                    EXIT_UNVERIFIABLE,
                    "unverifiable: the log or the state tree could not be read in full, "
                    "so nothing observed here settles what the job is doing",
                )
                if unreadable
                else (
                    EXIT_ALIVE if args.once else EXIT_UNVERIFIABLE,
                    f"{'alive' if args.once else 'unverifiable'}: the job's state "
                    f"changed while it was being read, so no single observation backs "
                    f"a verdict (record says {(record or {}).get('status') or '不明'})",
                )
            )
        if (
            out is None
            and not observed_late
            and args.estimate_seconds
            and elapsed > args.estimate_seconds * 2
        ):
            out = (
                EXIT_OVER_ESTIMATE,
                f"over-estimate: {int(elapsed)}s elapsed against a {int(args.estimate_seconds)}s "
                "estimate — read the log against the order before waiting further",
            )
        # completed でもツリーが落ち着くまでは verdict を保留するので、 保留を告げる
        # headline は record の語をそのまま出す — 言い切ると直下の evidence と食い違う。
        # headline へそのまま入るので、 保持する時点で escape しておく。
        recorded = printable((record or {}).get("status") or "不明")
        if out is None and args.once and not observed_late:
            out = (
                EXIT_ALIVE,
                f"alive: no terminal verdict yet after {int(elapsed)}s "
                f"(record says {recorded})",
            )
        if out is None and deadline_reached(deadline):
            out = (
                EXIT_TIMEOUT,
                f"timeout: no terminal verdict within {int(args.timeout_seconds)}s "
                f"(record says {recorded})",
            )
        if out is not None:
            code, headline = out
            print(printable(headline))
            print(
                evidence(
                    args.job_id,
                    record or {},
                    log,
                    age,
                    tree,
                    threshold,
                    baseline,
                    args.artifact,
                    ready,
                    unfinished,
                    tail,
                    whole_log,
                )
            )
            return code
        last_report = (
            recorded,
            evidence(
                args.job_id,
                record or {},
                log,
                age,
                tree,
                threshold,
                baseline,
                args.artifact,
                ready,
                unfinished,
                tail,
                whole_log,
            ),
        )
        sleep_until(deadline, args.poll_seconds)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Watch one codex job to a terminal verdict, with its evidence."
    )
    p.add_argument("job_id", nargs="?", help="codex job id, e.g. task-abc123-def456")
    p.add_argument("--artifact", help="deliverable path the job must produce")
    p.add_argument("--token", help="final token the deliverable must end with")
    p.add_argument(
        "--stall-seconds",
        type=float,
        help="quiet time that counts as stalled; default is derived from this workspace's history",
    )
    p.add_argument("--hang-seconds", type=float, default=300.0)
    p.add_argument("--poll-seconds", type=float, default=30.0)
    p.add_argument("--timeout-seconds", type=float, default=3300.0)
    p.add_argument(
        "--estimate-seconds",
        type=float,
        help="expected run time; twice this without a verdict exits for investigation",
    )
    p.add_argument("--state-root", help="override where plugin state is searched")
    p.add_argument(
        "--once",
        action="store_true",
        help="evaluate one cadence and report alive instead of waiting",
    )
    p.add_argument(
        "--trust-log",
        action="store_true",
        help="let a quiet log become a stall verdict; off by default because the "
        "log cannot separate an event from a message quoting one",
    )
    p.add_argument("--selftest", action="store_true")
    return p


def check_arguments(parser: argparse.ArgumentParser, args: argparse.Namespace) -> None:
    """NaN or a negative wait makes every deadline comparison false — refuse it up front."""
    if args.token and not args.artifact:
        # 成果物が無ければ token を照合する相手がいない。 黙って無視すると、
        # 完了 token を指定した呼び手が「検査された」 と読んだまま exit 0 を受け取る。
        parser.error("--token needs --artifact: there is nothing to check it against")
    for name in (
        "stall_seconds",
        "hang_seconds",
        "poll_seconds",
        "timeout_seconds",
        "estimate_seconds",
    ):
        value = getattr(args, name)
        if value is not None and not (math.isfinite(value) and value > 0):
            parser.error(f"--{name.replace('_', '-')} must be a positive finite number")


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    check_arguments(parser, args)
    if args.selftest:
        loaded = unittest.defaultTestLoader.loadTestsFromName(__name__ + ".WatchTest")
        return (
            0 if unittest.TextTestRunner(verbosity=2).run(loaded).wasSuccessful() else 1
        )
    if not args.job_id:
        parser.print_usage(sys.stderr)
        return 2
    return watch(args)


class WatchTest(unittest.TestCase):
    """Completion rules from the codex-delegation skill. Run this file with --selftest."""

    def _state(self, workspace, job_id, status, log_age=0.0, stamps=()):
        import tempfile

        root = tempfile.mkdtemp()
        jobs = os.path.join(root, workspace, "jobs")
        os.makedirs(jobs)
        record = os.path.join(jobs, job_id + ".json")
        with open(record, "w", encoding="utf-8") as f:
            json.dump({"id": job_id, "status": status}, f)
        log = os.path.join(jobs, job_id + ".log")
        with open(log, "w", encoding="utf-8") as f:
            f.write("".join(f"[{s}Z] line\n" for s in stamps) or "x\n")
        os.utime(log, (time.time() - log_age, time.time() - log_age))
        return root, record, log

    def _code(self, status, age, ready, tree=None, tail=False, trust=True):
        out = verdict(
            status, age, tree, ready, 420, 300, command_may_run=tail, trust_log=trust
        )
        self.assertIsNotNone(out, "terminal verdict を期待した")
        return out[0] if out else None

    def test_job_found_in_any_workspace(self):
        """隔離 worktree に登録された job も見つかる (本線 workspace 決め打ちにしない)。"""
        root, record, log = self._state("wt-review-deadbeef", "task-x", "running")
        self.assertEqual(find_jobs("task-x", [root]), ([(record, log)], True))

    def test_job_absent_returns_nothing(self):
        root, _r, _l = self._state("ws", "task-x", "running")
        self.assertEqual(find_jobs("task-other", [root]), ([], True))

    def test_duplicate_ids_are_all_returned(self):
        """同一 id が 2 件あるなら選ばずに全部返す — 黙って先頭を掴むと live job を取り違える。"""
        root, _r, _l = self._state("aaa-old", "task-dup", "cancelled")
        jobs = os.path.join(root, "zzz-live", "jobs")
        os.makedirs(jobs)
        with open(os.path.join(jobs, "task-dup.json"), "w", encoding="utf-8") as f:
            json.dump({"id": "task-dup", "status": "running"}, f)
        with open(os.path.join(jobs, "task-dup.log"), "w", encoding="utf-8") as f:
            f.write("x\n")
        self.assertEqual(len(find_jobs("task-dup", [root])[0]), 2)

    def test_state_roots_follow_the_plugin_resolver(self):
        """plugin は CLAUDE_PLUGIN_DATA、無ければ temp dir を使う — 配布 path 決め打ちにしない。"""
        from unittest import mock

        with mock.patch.dict(os.environ, {PLUGIN_DATA_ENV: "/pd"}):
            roots = state_roots()
        self.assertEqual(roots[0], os.path.join("/pd", "state"))
        self.assertIn(os.path.join(tempfile.gettempdir(), "codex-companion"), roots)
        self.assertIn(STATE_ROOT, roots)
        self.assertEqual(state_roots("/only"), ["/only"])

    def test_queued_counts_as_alive(self):
        """companion の生存語彙は queued / running の 2 つ (source と実データで確認)。"""
        self.assertIsNone(verdict("queued", 5.0, None, False, 420, 300))

    def test_unknown_status_is_terminal(self):
        """未知の status は終了扱い — 生存側だけを列挙し、取りこぼしを待ち続けない。"""
        self.assertEqual(self._code("failed", 1.0, False), EXIT_NOT_COMPLETED)

    def test_failure_and_cancel_are_not_success_even_with_a_deliverable(self):
        """cancel / 失敗は結果ではない — 成果物が転がっていても成功に昇格させない。"""
        self.assertEqual(self._code("failed", 1.0, True), EXIT_NOT_COMPLETED)
        self.assertEqual(self._code("cancelled", 1.0, True), EXIT_NOT_COMPLETED)

    def test_a_present_deliverable_is_named_even_when_the_run_failed(self):
        """完成した成果物があるなら言う — 黙って再発注させると書けたものを捨てる。"""
        out = verdict("failed", 1.0, None, True, 420, 300)
        assert out is not None
        self.assertIn("deliverable is present", out[1])
        bare = verdict("failed", 1.0, None, False, 420, 300)
        assert bare is not None
        self.assertNotIn("deliverable is present", bare[1])

    def test_terminal_status_with_deliverable_is_done(self):
        """completed だけでは足りない — skill の完了は status とツリー静穏の AND。"""
        self.assertEqual(self._code("completed", 1.0, True, tree=600.0), EXIT_DONE)

    def test_completed_with_a_live_tree_keeps_watching(self):
        """detached process がまだ書いている間に受け入れレビューへ渡さない。"""
        self.assertIsNone(verdict("completed", 1.0, 1.0, True, 420, 300))

    def test_completed_with_an_unreadable_tree_is_unverifiable(self):
        self.assertEqual(self._code("completed", 1.0, True), EXIT_UNVERIFIABLE)

    def test_completed_without_deliverable_waits_for_a_settled_tree(self):
        """成果物なしの断定にも静穏したツリーが要る — まだ書いている writer がそれを置くかもしれない。"""
        self.assertEqual(
            self._code("completed", 1.0, False, tree=600.0),
            EXIT_ENDED_WITHOUT_ARTIFACT,
        )
        self.assertIsNone(verdict("completed", 1.0, 1.0, False, 420, 300))
        out = verdict("completed", 1.0, None, False, 420, 300)
        assert out is not None
        self.assertEqual(out[0], EXIT_UNVERIFIABLE)

    def test_completion_without_an_expected_deliverable_is_done(self):
        """成果物を指定しない発注では、completed とツリー静穏で成功を表現できる。"""
        out = verdict("completed", 1.0, 600.0, False, 420, 300, expects_artifact=False)
        assert out is not None
        self.assertEqual(out[0], EXIT_DONE)

    def test_a_job_not_yet_started_owns_no_deliverable(self):
        """worker が拾う前の job は何も書けない — createdAt を下限にすると他人の file を通す。"""
        stamp = "2026-08-08T11:43:06.921Z"
        self.assertIsNone(run_since({"createdAt": stamp}))  # queued のまま
        self.assertEqual(
            run_since({"createdAt": "2026-08-08T00:00:00Z", "startedAt": stamp}),
            stamp_epoch(stamp),
        )
        self.assertIsNone(run_since({}))
        # 下限が無ければ ready にならないので、queued が done-hung へは進めない。
        out = verdict("queued", 900.0, 900.0, False, 420, 300, trust_log=True)
        self.assertNotEqual(out and out[0], EXIT_DONE_HUNG)

    def test_no_freshness_floor_means_not_ready(self):
        """下限が読めないなら、今回書かれた成果物だと示せない。"""
        import tempfile

        p = os.path.join(tempfile.mkdtemp(), "report.md")
        with open(p, "w", encoding="utf-8") as f:
            f.write("body\nREPORT_COMPLETE\n")
        self.assertFalse(artifact_ready(p, "REPORT_COMPLETE", since=None))
        self.assertFalse(artifact_ready(p, "REPORT_COMPLETE", since=time.time() + 60))
        self.assertTrue(artifact_ready(p, "REPORT_COMPLETE", since=time.time() - 60))

    def test_running_with_fresh_log_keeps_watching(self):
        """走行中は None — 「id が status 出力に無い」等の間接判定で完了にしない。"""
        self.assertIsNone(verdict("running", 5.0, None, False, 420, 300))

    def test_deliverable_plus_frozen_log_is_done_hung(self):
        """完了後 hang: 成果物は揃ったが runner が居座る分岐 (running[] 消滅を待たない)。"""
        self.assertEqual(self._code("running", 600.0, True, tree=600.0), EXIT_DONE_HUNG)

    def test_done_hung_needs_a_quiet_tree_too(self):
        """成果物を書いた後に test を回している job を「居座り」と誤判定しない。"""
        self.assertIsNone(verdict("running", 600.0, 10.0, True, 420, 300))

    def test_quiet_log_but_active_tree_keeps_watching(self):
        """skill の 2 条件目: ファイルを書いている job は stall ではない。"""
        self.assertIsNone(verdict("running", 500.0, 10.0, False, 420, 300))

    def test_quiet_log_and_quiet_tree_is_stall(self):
        self.assertEqual(self._code("running", 500.0, False, tree=500.0), EXIT_STALL)

    def test_a_quiet_log_does_not_order_a_cancel_by_default(self):
        """log は event と引用を分けられない — 既定では cancel 導線 (exit 4/3) を出さない。"""
        self.assertEqual(
            self._code("running", 600.0, False, tree=600.0, trust=False),
            EXIT_UNVERIFIABLE,
        )
        self.assertEqual(
            self._code("running", 600.0, True, tree=600.0, trust=False),
            EXIT_UNVERIFIABLE,
        )

    def test_missing_log_counts_as_frozen(self):
        self.assertEqual(self._code("running", None, False, tree=500.0), EXIT_STALL)

    def test_a_command_start_at_the_tail_blocks_a_stall_call(self):
        """read-only command は何も書かない — ツリー静穏だけで stall と断ずると働く job を切る。"""
        self.assertEqual(
            self._code("running", 600.0, False, tree=600.0, tail=True),
            EXIT_UNVERIFIABLE,
        )

    def test_a_quoted_tail_can_only_suppress_never_assert(self):
        """引用と event は区別できない以上、この材料で stall を作らせない (抑制のみ)。"""
        out = verdict("running", 600.0, 600.0, False, 420, 300, command_may_run=True)
        assert out is not None
        self.assertNotEqual(out[0], EXIT_STALL)

    def test_parallel_completion_does_not_bury_a_running_command(self):
        """別 command の完了が末尾に来ても、未完了の開始が残っていれば抑制する。"""
        lines = [
            "[2026-08-09T00:00:00.000Z] Running command: rg -n pattern",
            "[2026-08-09T00:00:01.000Z] Running command: ls",
            "[2026-08-09T00:00:02.000Z] Command completed: ls (exit 0)",
        ]
        self.assertTrue(command_may_be_running(lines))

