#!/usr/bin/env python3
"""Return a deterministic verdict for one delegated job and its deliverable."""

from __future__ import annotations

import argparse
from collections import deque
import glob
import json
import os
import sys
import time
from typing import NamedTuple

ALIVE_STATUSES = frozenset({"queued", "running"})


class Verdict(NamedTuple):
    code: int
    name: str
    records: list[str]
    record: dict[str, object] | None
    age: float | None
    ready: bool | None
    reason: str


def default_roots() -> list[str]:
    roots: list[str] = []
    plugin_data = os.environ.get("CLAUDE_PLUGIN_DATA")
    if plugin_data:
        roots.append(os.path.join(os.path.expanduser(plugin_data), "state"))
    roots.extend(
        sorted(glob.glob(os.path.expanduser("~/.claude/plugins/data/*/state")))
    )
    return list(dict.fromkeys(roots))


def find_records(job_id: str, roots: list[str]) -> list[str]:
    records: list[str] = []
    for root in roots:
        pattern = os.path.join(root, "*", "jobs", f"{glob.escape(job_id)}.json")
        records.extend(glob.glob(pattern))
    return sorted(set(records))


def read_record(path: str) -> dict[str, object] | None:
    try:
        with open(path, encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict):
        return None
    return {str(key): item for key, item in value.items()}


def artifact_ready(path: str, token: str) -> bool:
    if not os.path.isfile(path):
        return False
    last: str | None = None
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle.read().splitlines():
                if line.strip():
                    last = line
    except (OSError, UnicodeError):
        return False
    return last == token


def heartbeat_age(record_path: str, job_id: str, artifact: str) -> float:
    paths = (
        record_path,
        os.path.join(os.path.dirname(record_path), f"{job_id}.log"),
        artifact,
    )
    mtimes: list[float] = []
    for path in paths:
        try:
            mtimes.append(os.path.getmtime(path))
        except OSError:
            pass
    if not mtimes:
        return float("inf")
    return max(0.0, time.time() - max(mtimes))


def log_tail(path: str) -> list[str]:
    tail: deque[str] = deque(maxlen=5)
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                tail.append(line.rstrip("\r\n"))
    except (OSError, UnicodeError):
        return []
    return [line[:200] for line in tail]


def evaluate(
    job_id: str,
    artifact: str,
    token: str,
    roots: list[str],
    stall_seconds: float,
) -> Verdict:
    records = find_records(job_id, roots)
    if len(records) != 1:
        return Verdict(6, "unresolved", records, None, None, None, "record-count")

    record_path = records[0]
    record = read_record(record_path)
    if record is None:
        return Verdict(6, "unresolved", records, None, None, None, "record-unreadable")

    raw_status = record.get("status", "")
    status = raw_status if isinstance(raw_status, str) else str(raw_status)
    age = heartbeat_age(record_path, job_id, artifact)
    ready = artifact_ready(artifact, token)

    if status in ALIVE_STATUSES:
        if age > stall_seconds:
            return Verdict(4, "undecided", records, record, age, ready, "stall")
        return Verdict(1, "alive", records, record, age, ready, "heartbeat-fresh")
    if status == "completed":
        if ready:
            return Verdict(0, "done", records, record, age, ready, "complete")
        return Verdict(3, "no-deliverable", records, record, age, ready, "artifact")
    return Verdict(5, "failed", records, record, age, ready, "terminal-status")


def emit(verdict: Verdict, job_id: str) -> None:
    print(f"verdict={verdict.name}")
    print(f"record={','.join(verdict.records)}")
    if verdict.code == 0:
        return

    status = "unknown"
    if verdict.record is not None:
        value = verdict.record.get("status", "")
        if isinstance(value, str) and value:
            status = value.replace("\r", " ").replace("\n", " ")
    print(f"status={status}")
    age = "unknown" if verdict.age is None else f"{verdict.age:.3f}"
    print(f"heartbeat_age={age}")
    if verdict.ready is None:
        deliverable = "unknown"
    else:
        deliverable = "ready" if verdict.ready else "not-ready"
    print(f"deliverable={deliverable}")
    print(f"reason={verdict.reason}")
    print("log_tail:")
    if len(verdict.records) == 1:
        log_path = os.path.join(os.path.dirname(verdict.records[0]), f"{job_id}.log")
        for line in log_tail(log_path):
            print(line)


def undecided(verdict: Verdict, reason: str) -> Verdict:
    return Verdict(
        4,
        "undecided",
        verdict.records,
        verdict.record,
        verdict.age,
        verdict.ready,
        reason,
    )


def watch(
    job_id: str,
    artifact: str,
    token: str,
    roots: list[str],
    stall_seconds: float,
    poll_seconds: float,
    timeout_seconds: float,
    estimate_seconds: float | None,
    once: bool,
) -> int:
    started = time.monotonic()
    while True:
        verdict = evaluate(job_id, artifact, token, roots, stall_seconds)
        if once or verdict.code != 1:
            emit(verdict, job_id)
            return verdict.code
        elapsed = time.monotonic() - started
        if estimate_seconds is not None and elapsed > 2 * estimate_seconds:
            verdict = undecided(verdict, "estimate")
        elif elapsed > timeout_seconds:
            verdict = undecided(verdict, "timeout")
        if verdict.code != 1:
            emit(verdict, job_id)
            return verdict.code
        time.sleep(max(0.0, poll_seconds))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Check one delegated job.")
    result.add_argument("job_id")
    result.add_argument("--artifact", required=True)
    result.add_argument("--token", required=True)
    result.add_argument("--state-root", action="append", dest="state_roots")
    result.add_argument("--stall-seconds", type=float, default=420)
    result.add_argument("--poll-seconds", type=float, default=30)
    result.add_argument("--timeout-seconds", type=float, default=3600)
    result.add_argument("--estimate-seconds", type=float)
    result.add_argument("--once", action="store_true")
    return result


def main() -> int:
    args = parser().parse_args()
    roots = args.state_roots or default_roots()
    roots = [os.path.expanduser(root) for root in roots]
    return watch(
        args.job_id,
        args.artifact,
        args.token,
        roots,
        args.stall_seconds,
        args.poll_seconds,
        args.timeout_seconds,
        args.estimate_seconds,
        args.once,
    )


if __name__ == "__main__":
    sys.exit(main())
