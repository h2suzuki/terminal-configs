        self.assertIsNone(job_record(p))

        # 有限 file の verdict だけでは、 全量一括 read への退行を素通りさせる。
        class Growing:
            def __init__(self) -> None:
                self.asked: list[int | None] = []

            def read(self, size=None) -> bytes:
                self.asked.append(size)
                return b"a" * (size if size else MAX_RECORD_BYTES * 4)

            def fileno(self) -> int:
                return 0

            def __enter__(self):
                return self

            def __exit__(self, *_exc) -> bool:
                return False

        handle = Growing()
        with mock.patch(__name__ + ".open_regular", lambda _p: handle):
            self.assertIsNone(job_record(p))
        self.assertEqual(handle.asked, [MAX_RECORD_BYTES + 1])

