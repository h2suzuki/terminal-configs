#!/usr/bin/env python3
"""Watch one codex job to a terminal verdict (done / done-hung / stall / ended / vanished).

Hand-written watch loops keep breaking in the same two ways, so the completion
rules from the codex-delegation skill live here as code instead:

- The job id is looked up by scanning every workspace state dir. A job started
  in an isolated worktree registers under that worktree, so asking the
  companion from the main checkout reports "nothing running" while it runs.
- Completion is decided by the deliverable plus the job record on disk, never
  by "the id no longer appears in the status output" — a finished id stays
  visible under latestFinished, so that test can never become true.
- Every exit is a verdict. A frozen heartbeat is reported, not waited on, so
  silence can never be mistaken for progress.

Usage:
  claude_codex_watch <job-id> [--artifact PATH] [--token STR]
                     [--stall-seconds N] [--hang-seconds N]
                     [--poll-seconds N] [--timeout-seconds N]
  claude_codex_watch --selftest

Exit: 0 done, 3 done-hung (deliverable ready, runner not deregistered),
4 stall, 5 ended without the deliverable, 6 never registered, 7 timeout.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import sys
import time
import unittest

STATE_ROOT = os.path.expanduser("~/.claude/plugins/data/codex-openai-codex/state")
TERMINAL_STATUS = frozenset({"completed", "failed", "cancelled", "canceled", "error"})

EXIT_DONE = 0
EXIT_DONE_HUNG = 3
EXIT_STALL = 4
EXIT_ENDED_WITHOUT_ARTIFACT = 5
EXIT_NEVER_REGISTERED = 6
EXIT_TIMEOUT = 7


def job_paths(job_id: str, state_root: str = STATE_ROOT) -> tuple[str, str] | None:
    """(record, log) for the job in whichever workspace registered it, else None."""
    for record in sorted(
        glob.glob(os.path.join(state_root, "*", "jobs", job_id + ".json"))
    ):
        return record, record[: -len(".json")] + ".log"
    return None


def job_status(record_path: str) -> str:
    """Status from the on-disk record; '' when it is unreadable (treated as alive)."""
    try:
        with open(record_path, encoding="utf-8") as f:
            return str(json.load(f).get("status") or "")
    except (OSError, ValueError):
        return ""


def heartbeat_age(log_path: str, now: float) -> float | None:
    """Seconds since the job log last grew; None when the log is absent."""
    try:
        return now - os.path.getmtime(log_path)
    except OSError:
        return None


def artifact_ready(path: str | None, token: str | None) -> bool:
    """A deliverable counts only once it is complete — the token guards half-written files."""
    if not path:
        return False
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return False
    return body.strip().endswith(token) if token else bool(body.strip())


def verdict(
    status: str,
    age: float | None,
    ready: bool,
    stall_seconds: float,
    hang_seconds: float,
) -> tuple[int, str] | None:
    """Terminal (exit code, message) for one poll, or None to keep watching."""
    frozen = age is None or age >= hang_seconds
    if ready and (status in TERMINAL_STATUS or frozen):
        if status in TERMINAL_STATUS:
            return EXIT_DONE, f"done: deliverable ready, job {status}"
        return EXIT_DONE_HUNG, (
            f"done-hung: deliverable ready but the runner is still registered and its log "
            f"has been silent for {int(age or 0)}s — verify the deliverable and cancel the job"
        )
    if status in TERMINAL_STATUS:
        return EXIT_ENDED_WITHOUT_ARTIFACT, (
            f"ended-without-deliverable: job {status} but the deliverable is missing or "
            f"incomplete — read the job log for what it reported instead"
        )
    if age is None or age >= stall_seconds:
        silence = "never appeared" if age is None else f"silent for {int(age)}s"
        return EXIT_STALL, (
            f"stall: job log {silence} with no deliverable — check the log, "
            f"then cancel and re-issue on a fresh thread"
        )
    return None


def watch(args: argparse.Namespace, state_root: str = STATE_ROOT) -> int:
    deadline = time.time() + args.timeout_seconds
    paths = None
    while paths is None:
        paths = job_paths(args.job_id, state_root)
        if paths is not None:
            break
        if time.time() + args.poll_seconds > deadline:
            print(f"never-registered: no state record for {args.job_id}")
            return EXIT_NEVER_REGISTERED
        time.sleep(args.poll_seconds)
    record, log = paths
    while time.time() < deadline:
        now = time.time()
        out = verdict(
            job_status(record),
            heartbeat_age(log, now),
            artifact_ready(args.artifact, args.token),
            args.stall_seconds,
            args.hang_seconds,
        )
        if out is not None:
            code, message = out
            print(f"{message} (log: {log})")
            return code
        time.sleep(args.poll_seconds)
    print(f"timeout: still alive after {int(args.timeout_seconds)}s (log: {log})")
    return EXIT_TIMEOUT


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Watch one codex job to a terminal verdict."
    )
    p.add_argument("job_id", nargs="?", help="codex job id, e.g. task-abc123-def456")
    p.add_argument("--artifact", help="deliverable path the job must produce")
    p.add_argument("--token", help="final token the deliverable must end with")
    p.add_argument("--stall-seconds", type=float, default=420.0)
    p.add_argument("--hang-seconds", type=float, default=300.0)
    p.add_argument("--poll-seconds", type=float, default=30.0)
    p.add_argument("--timeout-seconds", type=float, default=3300.0)
    p.add_argument("--selftest", action="store_true")
    return p.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.selftest:
        loaded = unittest.defaultTestLoader.loadTestsFromName(__name__ + ".WatchTest")
        return (
            0 if unittest.TextTestRunner(verbosity=2).run(loaded).wasSuccessful() else 1
        )
    if not args.job_id:
        print(
            "usage: claude_codex_watch <job-id> [--artifact PATH] [--token STR]",
            file=sys.stderr,
        )
        return 2
    return watch(args)


class WatchTest(unittest.TestCase):
    """Completion rules from the codex-delegation skill. Run: claude_codex_watch --selftest"""

    def _state(self, workspace, job_id, status, log_age=0.0):
        import tempfile

        root = tempfile.mkdtemp()
        jobs = os.path.join(root, workspace, "jobs")
        os.makedirs(jobs)
        record = os.path.join(jobs, job_id + ".json")
        with open(record, "w", encoding="utf-8") as f:
            json.dump({"id": job_id, "status": status}, f)
        log = os.path.join(jobs, job_id + ".log")
        with open(log, "w", encoding="utf-8") as f:
            f.write("x\n")
        os.utime(log, (time.time() - log_age, time.time() - log_age))
        return root, record, log

    def test_job_found_in_any_workspace(self):
        """隔離 worktree に登録された job も見つかる (本線 workspace 決め打ちにしない)。"""
        root, record, log = self._state("wt-review-deadbeef", "task-x", "running")
        self.assertEqual(job_paths("task-x", root), (record, log))

    def test_job_absent_returns_none(self):
        root, _r, _l = self._state("ws", "task-x", "running")
        self.assertIsNone(job_paths("task-other", root))

    def _code(self, status, age, ready):
        out = verdict(status, age, ready, 420, 300)
        self.assertIsNotNone(out, "terminal verdict を期待した")
        return out[0] if out else None

    def test_terminal_status_with_deliverable_is_done(self):
        self.assertEqual(self._code("completed", 1.0, True), EXIT_DONE)

    def test_running_with_fresh_log_keeps_watching(self):
        """走行中は None — 「id が status 出力に無い」等の間接判定で完了にしない。"""
        self.assertIsNone(verdict("running", 5.0, False, 420, 300))

    def test_deliverable_plus_frozen_log_is_done_hung(self):
        """完了後 hang: 成果物は揃ったが runner が居座る分岐 (running[] 消滅を待たない)。"""
        self.assertEqual(self._code("running", 600.0, True), EXIT_DONE_HUNG)

    def test_frozen_log_without_deliverable_is_stall(self):
        self.assertEqual(self._code("running", 500.0, False), EXIT_STALL)

    def test_terminal_status_without_deliverable_is_reported(self):
        """read-only で起動して報告書を書けなかった回を、完了と読み違えない。"""
        self.assertEqual(
            self._code("completed", 1.0, False), EXIT_ENDED_WITHOUT_ARTIFACT
        )

    def test_missing_log_counts_as_frozen(self):
        self.assertEqual(self._code("running", None, False), EXIT_STALL)

    def test_unreadable_record_is_treated_as_alive(self):
        self.assertEqual(job_status("/nonexistent/x.json"), "")
        self.assertIsNone(verdict("", 5.0, False, 420, 300))

    def test_artifact_requires_the_token(self):
        import tempfile

        p = os.path.join(tempfile.mkdtemp(), "report.md")
        with open(p, "w", encoding="utf-8") as f:
            f.write("half written\n")
        self.assertFalse(artifact_ready(p, "REPORT_COMPLETE"))
        with open(p, "a", encoding="utf-8") as f:
            f.write("REPORT_COMPLETE\n")
        self.assertTrue(artifact_ready(p, "REPORT_COMPLETE"))

    def test_absent_artifact_is_not_ready(self):
        self.assertFalse(artifact_ready("/nonexistent/report.md", None))
        self.assertFalse(artifact_ready(None, None))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
