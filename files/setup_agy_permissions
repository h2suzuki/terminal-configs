#!/usr/bin/env python3
"""Merge the agent-coord permission into Antigravity CLI's user settings."""

import argparse
import json
import os
import stat
import sys
import tempfile
from pathlib import Path

GRANT = "mcp(agent-coord_agent_coord/*)"


def configure(path, sandbox_auto=False, shared_policy=None):
    if path.is_symlink():
        raise ValueError(f"Refusing symlink settings file: {path}")
    original = path.read_text() if path.exists() else None
    data = json.loads(original) if original is not None else {}
    if not isinstance(data, dict):
        raise TypeError("settings must be a JSON object")
    permissions = data.setdefault("permissions", {})
    if not isinstance(permissions, dict):
        raise TypeError("permissions must be a JSON object")
    for key in ("allow", "deny", "ask"):
        rules = permissions.get(key, [])
        if not isinstance(rules, list) or not all(isinstance(r, str) for r in rules):
            raise ValueError(f"permissions.{key} must be a list of strings")
    for key in ("deny", "ask"):
        if any(
            r == "mcp(*)" or r.startswith("mcp(agent-coord_agent_coord/")
            for r in permissions.get(key, [])
        ):
            print(
                f"Warning: existing {key} rules take precedence; preserved.",
                file=sys.stderr,
            )
    allowed = permissions.setdefault("allow", [])
    additions = {"allow": [GRANT]}
    if shared_policy is not None:
        policy = json.loads(shared_policy.read_text())
        if not isinstance(policy, dict) or set(policy) - {"allow", "deny", "ask"}:
            raise ValueError("shared policy must contain only allow/deny/ask lists")
        for key, rules in policy.items():
            if not isinstance(rules, list) or not all(
                isinstance(r, str) for r in rules
            ):
                raise ValueError(f"shared policy {key} must be a list of strings")
            additions.setdefault(key, []).extend(rules)
    changed = False
    for key, rules in additions.items():
        destination = allowed if key == "allow" else permissions.setdefault(key, [])
        for rule in rules:
            for action in ("read_file", "write_file"):
                prefix = action + "(~/"
                if rule.startswith(prefix) and rule.endswith(")"):
                    rule = (
                        action + "(" + str(Path.home() / rule[len(prefix) : -1]) + ")"
                    )
            if rule not in destination:
                destination.append(rule)
                changed = True
    if sandbox_auto:
        for key, value in {
            "toolPermission": "proceed-in-sandbox",
            "enableTerminalSandbox": True,
        }.items():
            if data.get(key) != value:
                data[key] = value
                changed = True
    if not changed:
        return False
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    mode = stat.S_IMODE(path.stat().st_mode) if original is not None else 0o600
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=".settings-",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
            os.fchmod(stream.fileno(), mode)
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        if (path.read_text() if path.exists() else None) != original:
            raise ValueError(
                "settings changed during setup; retry after agy stops writing"
            )
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--sandbox-auto",
        action="store_true",
        help="Auto-proceed inside the terminal sandbox; retain explicit deny/ask rules",
    )
    parser.add_argument(
        "--shared-policy",
        type=Path,
        help="Merge the reviewed Codex/Claude-equivalent permissions JSON",
    )
    parser.add_argument(
        "--settings",
        type=Path,
        default=Path.home() / ".gemini/antigravity-cli/settings.json",
    )
    args = parser.parse_args()
    try:
        changed = configure(args.settings, args.sandbox_auto, args.shared_policy)
    except (OSError, ValueError, TypeError) as error:
        print(f"setup_agy_permissions: {error}", file=sys.stderr)
        return 1
    print(
        f"Antigravity settings {'updated' if changed else 'already configured'}: {args.settings}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
