{
  "permissions": {
    "allow": [
      "mcp__mytask__TaskCreate",
      "mcp__mytask__TaskUpdate",
      "mcp__mytask__TaskList"
    ],
    "deny": [
      "TaskCreate",
      "TaskGet",
      "TaskUpdate",
      "TaskList",
      "TodoWrite"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|shell_command|apply_patch|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [ { "type": "command", "command": "/usr/local/bin/scratch_file_management hook", "timeout": 30 } ]
      },
      {
        "matcher": "^(Read|Edit|NotebookEdit)$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/read_before_edit.py check" } ]
      },
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/check_dangling_refs.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/memory_routing_gate.py guard" },
          { "type": "command", "command": "/etc/claude-code/hooks/skill_reminder_gate.py gate" },
          { "type": "command", "command": "/etc/claude-code/hooks/comment_rationale_gate.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/codex_order_scaffold.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/deny_llm_call_in_hook.py" }
        ]
      },
      {
        "matcher": "^mcp__playwright__browser_run_code_unsafe$",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/playwright_listener_gate.py" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/avoid_cd.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/sandbox_server_gate.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/deny_compound_git_add.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/deny_compound_git_commit.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/todos_structure_gate.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/deny_command_patterns.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/skill_reminder_gate.py commit-gate" },
          { "type": "command", "command": "/etc/claude-code/hooks/check_commit_format.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/deny_unsafe_git_reset.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/sandbox_exclusion_guard.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/root_dir_guard.py" },
          { "type": "mcp_tool", "server": "jev", "tool": "context_gate", "if": "Bash(git *)", "timeout": 60,
            "input": { "command": "${tool_input.command}", "cwd": "${cwd}", "session_id": "${session_id}" } }
        ]
      },
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/subagent_gate_warn.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/subagent_model_gate.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/subagent_watch_reminder.py" }
        ]
      },
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/declare_and_proceed_gate.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/question_research_gate.py" }
        ]
      },
      {
        "matcher": "^SendMessage$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/cross_session_send_gate.py" } ]
      },
      {
        "matcher": "^EnterWorktree$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/worktree_home.py" } ]
      },
      {
        "matcher": "^(Grep|Read)$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/codegraph_first_gate.py" } ]
      },
      {
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/codex_delegation_surface.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/codex_delegation_gate.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/sandbox_shadow_nudge.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Skill$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/skill_reminder_gate.py record-skill" } ]
      },
      {
        "matcher": "^(Read|Write|Edit|NotebookEdit)$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/read_before_edit.py record" } ]
      },
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/check_skill_writing.py" } ]
      },
      {
        "matcher": "^Write$",
        "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/memory_routing_gate.py sync" } ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/codex_broker_sweep.py", "timeout": 120 },
          { "type": "command", "command": "/etc/claude-code/hooks/sandbox_exclusion_guard.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/root_dir_guard.py" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/detect_cwd_pollution.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/sandbox_exclusion_guard.py" },
          { "type": "command", "command": "/etc/claude-code/hooks/root_dir_guard.py" }
        ]
      }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/codex_delegation_surface.py", "asyncRewake": true } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/sandbox_exclusion_guard.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude_md_lint.py", "timeout": 120 } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/feature_findings_build.py", "timeout": 30 } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/session_resume_context.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/reap_orphan_helpers.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/codex_broker_sweep.py", "timeout": 120 } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/memory_sync_pull.py" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/check_uncommitted_at_handoff.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/codex_delegation_surface.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/plan_first_nudge.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/primary_source_nudge.py" } ] }
    ],
    "MessageDisplay": [
      { "hooks": [ { "type": "command", "command": "/usr/local/bin/claude_court_guard --hook" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/stop_checks.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/question_research_gate.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/sandbox_shadow_nudge.py" } ] },
      { "hooks": [ { "type": "command", "command": "/usr/local/bin/scratch_file_management hook", "timeout": 30 } ] },
      { "hooks": [ { "type": "command", "command": "/usr/local/bin/claude_court_guard --hook" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/session_cleanup.py" } ] },
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/reap_orphan_helpers.py" } ] }
    ],
    "WorktreeCreate": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/worktree_home.py" } ] }
    ],
    "WorktreeRemove": [
      { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/worktree_home.py" } ] }
    ]
  }
}
