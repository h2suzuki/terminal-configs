#!/bin/bash

# Installs Claude Code extensions. Run by the base setup as the login user
# (via setup_user_environment); also re-runnable standalone for recovery.


command -v tty      >/dev/null || { echo "Cannot find tty";         exit 1; }
command -v claude   >/dev/null || { echo "Cannot find claude";      exit 1; }


if tty -s >/dev/null; then
    COLOR_CLEAR="\033[0m"
    COLOR_RED="\033[31m"
    COLOR_GREEN="\033[32m"
    COLOR_YELLOW="\033[33m"
else
    COLOR_CLEAR=
    COLOR_RED=
    COLOR_GREEN=
    COLOR_YELLOW=
fi


run()
{
    local RETVAL

    echo -e "=> ${COLOR_YELLOW}${@}${COLOR_CLEAR}"
    eval "${@}"
    RETVAL=$?

    if [ $RETVAL -eq 0 ]; then
        echo -e "[ ${COLOR_GREEN}OK${COLOR_CLEAR} ]\n"
    else
        echo -e "[ ${COLOR_RED}ERROR($RETVAL)${COLOR_CLEAR} ]\n"
        exit $RETVAL
    fi
}



# Make sure the copy source exists
[ -d /etc/claude-code/ ]                || { echo "/etc/claude-code/ not found";                exit 1; }
[ -d /etc/claude-code/hooks/ ]          || { echo "/etc/claude-code/hooks/ not found";          exit 1; }
[ -d /etc/claude-code/skills/ ]         || { echo "/etc/claude-code/skills/ not found";         exit 1; }
[ -d /etc/claude-code/skel/ ]           || { echo "/etc/claude-code/skel/ not found";           exit 1; }
[ -d /etc/claude-code/skel/skills/ ]    || { echo "/etc/claude-code/skel/skills/ not found";    exit 1; }
[ -d /etc/claude-code/skel/hooks/ ]     || { echo "/etc/claude-code/skel/hooks/ not found";     exit 1; }



# Deploy the user hooks from /etc/claude-code/skel/
pushd /etc/claude-code/skel/hooks/ >/dev/null

run install --directory ~/.claude/hooks/
run find ~/.claude/hooks/ -maxdepth 1 -type f -delete '||' true
run install check_commit_author.py    ~/.claude/hooks/check_commit_author.py
run install check_push_prompting.py   ~/.claude/hooks/check_push_prompting.py
run install memory_surface.py         ~/.claude/hooks/memory_surface.py
run install subagent_gate_suggest.py  ~/.claude/hooks/subagent_gate_suggest.py
run install title_icon.py             ~/.claude/hooks/title_icon.py
run "claude_user_hooks install --fragment - < ../extensions.json"

popd >/dev/null


# Deploy the user skills from /etc/claude-code/skel/
pushd /etc/claude-code/skel/skills/ >/dev/null

run install --directory ~/.claude/skills/
run find ~/.claude/skills/ -maxdepth 1 -xtype l -delete '||' true
for skill_dir in *; do
    [ -n "$skill_dir" ] || continue
    [ -d "$skill_dir" ] || continue
    rm -rf ~/.claude/skills/"$skill_dir"
    run cp -r --preserve=mode "$skill_dir" ~/.claude/skills/
done

popd >/dev/null


# Symlink the managed skills
pushd /etc/claude-code/skills/ >/dev/null

for skill_dir in *; do
    [ -n "$skill_dir" ] || continue
    [ -d "$skill_dir" ] || continue
    rm -rf ~/.claude/skills/"${skill_dir}"
    run ln -sfn "/etc/claude-code/skills/$skill_dir" ~/.claude/skills/
done

popd >/dev/null


# Initialize the RAG memory for this user
run install --mode 0755 --directory ~/.claude/hooks/state

# Clone the canonical memory repo (soft-fail: without working gh auth the
# memory feature stays closed until this script is re-run)
MEMORY_REPO=/var/lib/claude-rag-memory/claude-lessons-learned
MEMORY_ROOT="$(dirname "$MEMORY_REPO")"
command -v flock >/dev/null 2>&1 || { echo "flock not found"; exit 1; }
# The base installer (claude_rag_memory_builder) owns this dir; the lock fd below needs it
if [ ! -d "$MEMORY_ROOT" ] || [ ! -r "$MEMORY_ROOT" ]; then
    echo -e "${COLOR_RED}$MEMORY_ROOT missing or unreadable — run the base installer first${COLOR_CLEAR}" >&2
    exit 1
fi
# flock the parent dir fd (no lock file, works for root and user phases alike):
# concurrent re-runs must not treat each other's half-made clone as broken
(
    # -E 100 tells "someone holds it" apart from a real flock failure (EBADF / ENOLCK)
    flock -n -E 100 9 || {
        [ $? -eq 100 ] || exit 1
        echo -e "${COLOR_YELLOW}memory dir locked by another install — waiting up to 330s${COLOR_CLEAR}"
        # 330s > the clone's own 300s cap: a longer wait means the holder is stuck, not busy
        flock -w 330 -E 100 9 || {
            echo -e "${COLOR_RED}memory dir lock timeout — another install_claude_extensions is running; aborting${COLOR_CLEAR}" >&2
            exit 1
        }
    }
    if ! git -C "$MEMORY_REPO" rev-parse --git-dir >/dev/null 2>&1; then
        # Salvage a missing-.git leftover instead of deleting it
        [ -e "$MEMORY_REPO" ] && run mv "$MEMORY_REPO" "$MEMORY_REPO.broken.$(date +%s)"
        # 9<&-: a long-lived child (credential daemon etc) must not inherit the lock fd
        if GIT_TERMINAL_PROMPT=0 timeout 300 git clone -c core.sharedRepository=all \
            https://github.com/h2suzuki/claude-lessons-learned.git "$MEMORY_REPO" 9<&-; then
            # An empty repo clones with an unborn HEAD; pin the branch name
            git -C "$MEMORY_REPO" rev-parse -q --verify HEAD >/dev/null \
                || run git -C "$MEMORY_REPO" symbolic-ref HEAD refs/heads/main
            run chmod -R a+rwX "$MEMORY_REPO"
            # Top stays 0755: new top-level dirs land via an owner-run pull
            run chmod 0755 "$MEMORY_REPO"
        else
            rm -rf "$MEMORY_REPO"
            echo -e "${COLOR_RED}memory repo clone failed — run 'gh auth login' then re-run this script${COLOR_CLEAR}\n"
        fi
    fi
) 9< "$MEMORY_ROOT" || exit 1

# Sweep control files this tooling no longer uses (left behind by older deploys)
rm -f "$MEMORY_REPO".{lock,push.lock,install.lock,last-pull,push-failed,index-retry,pull-attempt,missing-warned,sync.log.1} \
      "$MEMORY_ROOT/memory_index.sqlite3.lock"

# Index every scope present in the clone
if [ -d "$MEMORY_REPO/.git" ]; then
    run claude_memory_sync --full
fi



. $HOME/.nvm/nvm.sh


# Fail fast: every claude call below parses $PWD/.mcp.json (claude requires a mcpServers record)
if [ -f .mcp.json ] && ! python3 -c 'import json; assert isinstance(json.load(open(".mcp.json"))["mcpServers"], dict)'; then
    run "ls -l .mcp.json >&2"
    echo -e "${COLOR_RED}invalid .mcp.json in $PWD — aborting${COLOR_CLEAR}" >&2
    exit 1
fi


# Seed the registry first: never-launched users have no marketplace, so bare `update` fails (re-add is idempotent, exit 0)
run claude plugin marketplace add anthropics/claude-plugins-official
run claude plugin marketplace update claude-plugins-official

# LSP servers
run npm install -g typescript-language-server typescript
run npm install -g pyright
# run go install golang.org/x/tools/gopls@latest
# run rustup component add rust-analyzer

# LSP server plugins
run claude plugin install clangd-lsp@claude-plugins-official        # clangd is installed by APT
run claude plugin install typescript-lsp@claude-plugins-official
run claude plugin install pyright-lsp@claude-plugins-official
#run claude plugin install gopls-lsp@claude-plugins-official
#run claude plugin install rust-analyzer-lsp@claude-plugins-official

# Security-guidance plugin (disabled by default)
run claude plugin install security-guidance@claude-plugins-official
run claude plugin disable security-guidance@claude-plugins-official

# Figma plugin
run claude plugin install figma@claude-plugins-official
run claude plugin update figma@claude-plugins-official

# Agent-browser
run CI=1 npm install -g agent-browser
run agent-browser install --with-deps
run npx -y skills add vercel-labs/agent-browser --skill agent-browser --agent claude-code --global --yes

# Playwright MCP
claude mcp remove playwright --scope user
run claude mcp add --scope user playwright -- npx -y @playwright/mcp@latest --browser chrome --headless --isolated

# Codex plugin
run claude plugin marketplace add openai/codex-plugin-cc
run claude plugin install codex@openai-codex

claude mcp remove codex --scope user    # Codex MCP is supersedded by Codex plugin

# CodeGraph MCP
claude mcp remove codegraph --scope user
run npm install -g @colbymchenry/codegraph
run claude mcp add codegraph --scope user -- codegraph serve --mcp

# Cloud Run MCP
claude mcp remove cloud-run --scope user
run claude mcp add cloud-run --scope user -- npx -y @google-cloud/cloud-run-mcp

# Toolbox MCP (launcher derives BIGQUERY_PROJECT, required at startup, from gcloud)
claude mcp remove toolbox --scope user
run claude mcp add toolbox --scope user -- toolbox_bigquery_mcp

# my-task MCP (session-local work-item tracker)
claude mcp remove mytask --scope user
run claude mcp add mytask --scope user -- claude_mytask_mcp

# Vercel CLI
run npm install -g @vercel/vc-native


run claude mcp list
run claude plugin list


echo ''
echo '*** Post-install login -- type /mcp and /doctor in Claude Code console for OAuth2 ***'
echo ''

# END
