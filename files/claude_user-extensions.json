{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "~/.claude/hooks/check_commit_author.py h2suzuki@gmail.com" } ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [ { "type": "command", "command": "~/.claude/hooks/check_push_prompting.py" } ]
      },
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/title_icon.py" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/title_icon.py" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "/usr/local/bin/claude_hook_bundle --timeout 60 --file ~/.claude/hooks/stop.hooks", "timeout": 90 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "/usr/local/bin/claude_hook_bundle --timeout 25 --file ~/.claude/hooks/user_prompt_submit.hooks", "timeout": 30 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/memory_surface.py", "asyncRewake": true } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/title_icon.py" } ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/title_icon.py" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/title_icon.py" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/title_icon.py" } ] }
    ]
  }
}
