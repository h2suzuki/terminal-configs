    def test_codex_stdio_create_update_and_resume(self):
        command = [
            sys.executable,
            "-B",
            str(Path(__file__).resolve()),
            "--client",
            "codex",
        ]
        calls = [
            {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}},
            {"jsonrpc": "2.0", "id": 2, "method": "tools/list"},
        ]
        for name, arguments in [
            ("TaskCreate", {"content": "Verify Codex task tracking"}),
            ("TaskUpdate", {"id": "1", "status": "in_progress"}),
            ("TaskUpdate", {"id": "1", "status": "completed"}),
        ]:
            calls.append(
                {
                    "jsonrpc": "2.0",
                    "id": len(calls) + 1,
                    "method": "tools/call",
                    "params": {
                        "name": name,
                        "arguments": arguments,
                        "_meta": {"threadId": "stdio-thread"},
                    },
                }
            )
        result = subprocess.run(
            command,
            input="".join(json.dumps(call) + "\n" for call in calls),
            capture_output=True,
            text=True,
            check=True,
            cwd=self.temp_dir,
        )
        responses = [json.loads(line)["result"] for line in result.stdout.splitlines()]
        self.assertEqual(len(responses), 5)
        self.assertIn("review your own plan", responses[0]["instructions"])
        self.assertEqual(len(responses[1]["tools"]), 3)
        self.assertTrue(all(not response["isError"] for response in responses[2:]))
        resumed = subprocess.run(
            command,
            input=json.dumps(
                {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "tools/call",
                    "params": {
                        "name": "TaskList",
                        "arguments": {"completed_limit": 5},
                        "_meta": {"threadId": "stdio-thread"},
                    },
                }
            )
            + "\n",
            capture_output=True,
            text=True,
            check=True,
            cwd=self.temp_dir,
        )
        self.assertIn("✅", resumed.stdout)
        self.assertIn("Verify Codex task tracking", resumed.stdout)


def _main(argv: list[str] | None = None) -> int:
    global CLIENT
    args = sys.argv[1:] if argv is None else argv
    if args == ["--selftest"]:
        suite = unittest.defaultTestLoader.loadTestsFromTestCase(MyTasksTest)
        result = unittest.TextTestRunner().run(suite)
        return 0 if result.wasSuccessful() else 1
    if args == ["--client", "codex"]:
        CLIENT = "codex"
    elif args:
        print("Usage: mytask [--client codex | --selftest]", file=sys.stderr)
        return 2
    serve(sys.stdin, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(_main())
