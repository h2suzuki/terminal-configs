#!/usr/bin/env python3
"""Serve session-local work items through a small stdlib-only MCP server."""

from __future__ import annotations

import glob
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unittest
from contextvars import ContextVar
from datetime import datetime
from pathlib import Path
from typing import TextIO, cast
from unittest import mock

Task = dict[str, object]

VERSION = "1.4.0"
CLIENT = "claude"
CODEX_THREAD: ContextVar[str | None] = ContextVar("codex_thread", default=None)
DEFAULT_PROTOCOL_VERSION = "2025-11-25"
TIME_FORMAT = "%Y-%m-%d %H:%M"
STATUSES = ("pending", "in_progress", "delegated", "blocked", "completed", "cancelled")
CLOSED_STATUSES = frozenset({"completed", "cancelled"})
EMOJI = {
    "pending": "◻️",
    "in_progress": "▶️",
    "delegated": "🤖",
    "blocked": "🚧",
    "completed": "✅",
    "cancelled": "✖️",
}
TASK_ID = re.compile(r"^[0-9]+(?:-[0-9]+)*$")

TOOLS = [
    {
        "name": "TaskList",
        "description": "List unfinished session work items in ID order. completed_limit optionally adds the most recently closed (completed or cancelled) items (default 0, maximum 100). Runs a court-bug contamination check and prepends a warning if the session transcript looks contaminated (#64108).",
        "inputSchema": {"type": "object", "properties": {"completed_limit": {"type": "integer", "minimum": 0, "maximum": 100, "default": 0}}, "additionalProperties": False},
    },
    {
        "name": "TaskCreate",
        "description": "Add a work item (status pending). Use `parent` (any existing task id) for hierarchical numbering: 4 -> 4-1 -> 4-1-2. Returns only the created item with its automatically assigned ID.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "content": {"type": "string"},
                "activeForm": {"type": "string"},
                "parent": {"type": "string"},
            },
            "required": ["content"],
            "additionalProperties": False,
        },
    },
    {
        "name": "TaskUpdate",
        "description": "Update a work item's status and return only that item plus any auto-demoted IDs. Keep exactly one in_progress at a time (TodoWrite semantics): starting a new item auto-demotes the previous in_progress to pending. Use delegated for items a subagent or another session is working on; any number may be delegated and they are never auto-demoted. `owner` names the delegate (only kept while delegated). Use cancelled for items no longer needed; like completed, it closes the item.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "id": {"type": "string"},
                "status": {"type": "string", "enum": list(STATUSES)},
                "owner": {"type": "string"},
            },
            "required": ["id", "status"],
            "additionalProperties": False,
        },
    },
]


def _now() -> datetime:
    return datetime.now()


def _session_id() -> str | None:
    if CLIENT == "codex":
        return CODEX_THREAD.get()
    value = os.environ.get("CLAUDE_CODE_SESSION_ID")
    return value if value else None


def _task_path(session_id: str) -> Path:
    if CLIENT == "codex":
        return Path.cwd() / "drafts" / "tasks" / f"codex-{session_id}.json"
    root = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    return Path(root) / "drafts" / "tasks" / f"{session_id}.json"


def read_tasks(path: Path) -> list[Task]:
    """Read a task array, treating missing or malformed data as empty."""
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(raw, list):
            return []
        return [cast(Task, item) for item in raw if isinstance(item, dict)]
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        return []


def write_tasks(path: Path, tasks: list[Task]) -> str | None:
    """Write the whole task array and return an error message on failure."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(tasks, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
    except (OSError, UnicodeError, TypeError, ValueError) as error:
        return f"Could not save tasks: {error}"
    return None


def _sort_key(task: Task) -> tuple[int, tuple[int, ...], str]:
    task_id = str(task.get("id", ""))
    if TASK_ID.fullmatch(task_id):
        return (0, tuple(int(part) for part in task_id.split("-")), "")
    return (1, (), task_id)


def render_tasks(tasks: list[Task], completed_limit: int = 0) -> str:
    """Show unfinished work plus an optional recent completion window."""
    active = [
        task
        for task in tasks
        if task.get("status") in STATUSES and task.get("status") not in CLOSED_STATUSES
    ]
    completed = sorted(
        (task for task in tasks if task.get("status") in CLOSED_STATUSES),
        key=lambda task: (str(task.get("completed_at", "")), _sort_key(task)),
        reverse=True,
    )[:completed_limit]
    lines: list[str] = []
    for task in sorted(active + completed, key=_sort_key):
        task_id = str(task.get("id", ""))
        status = str(task.get("status", ""))
        content = str(task.get("content", ""))
        created = task.get("created")
        suffix = f" ({created})" if isinstance(created, str) and created else ""
        owner = task.get("owner")
        if status == "delegated" and isinstance(owner, str) and owner:
            suffix = f" [{owner}]{suffix}"
        indent = "  " * task_id.count("-") if TASK_ID.fullmatch(task_id) else ""
        lines.append(f"{indent}{task_id} {EMOJI[status]} {content}{suffix}")
    return "\n".join(lines) if lines else "(no active tasks)"


def _load_session_tasks() -> tuple[Path | None, list[Task], str | None]:
    session_id = _session_id()
    if session_id is None:
        return (
            None,
            [],
            "Session identity is unavailable; cannot access session tasks.",
        )
    path = _task_path(session_id)
    return path, read_tasks(path), None


def task_list(completed_limit: int = 0) -> tuple[str, bool]:
    _path, tasks, error = _load_session_tasks()
    if error:
        return error, True
    return render_tasks(tasks, completed_limit), False


def _next_top_id(tasks: list[Task]) -> str:
    ids = [
        int(str(task.get("id"))) for task in tasks if str(task.get("id", "")).isdigit()
    ]
    return str(max(ids, default=0) + 1)


def _next_subtask_id(tasks: list[Task], parent: str) -> str:
    numbers: list[int] = []
    for task in tasks:
        task_id = str(task.get("id", ""))
        prefix, separator, number = task_id.rpartition("-")
        if separator and prefix == parent and TASK_ID.fullmatch(task_id):
            numbers.append(int(number))
    return f"{parent}-{max(numbers, default=0) + 1}"


def task_create(arguments: dict[str, object]) -> tuple[str, bool]:
    path, tasks, error = _load_session_tasks()
    if error or path is None:
        return error or "Session task path is unavailable.", True
    content = cast(str, arguments["content"])
    parent = cast(str | None, arguments.get("parent"))
    if parent is not None:
        exists = any(
            str(task.get("id", "")) == parent and TASK_ID.fullmatch(parent)
            for task in tasks
        )
        if not exists:
            return (
                f"Error: parent task {parent!r} was not found.\n{render_tasks(tasks)}",
                True,
            )
        task_id = _next_subtask_id(tasks, parent)
    else:
        task_id = _next_top_id(tasks)
    stamp = _now().strftime(TIME_FORMAT)
    task: Task = {
        "id": task_id,
        "content": content,
        "status": "pending",
        "created": stamp,
        "updated": stamp,
    }
    if "activeForm" in arguments:
        task["activeForm"] = arguments["activeForm"]
    tasks.append(task)
    if save_error := write_tasks(path, tasks):
        return f"Error: {save_error}\n{render_tasks(tasks)}", True
    return render_tasks([task]), False


def task_update(arguments: dict[str, object]) -> tuple[str, bool]:
    path, tasks, error = _load_session_tasks()
    if error or path is None:
        return error or "Session task path is unavailable.", True
    task_id = cast(str, arguments["id"])
    status = cast(str, arguments["status"])
    target = next((task for task in tasks if str(task.get("id", "")) == task_id), None)
    if target is None:
        return f"Error: task {task_id!r} was not found.\n{render_tasks(tasks)}", True
    stamp = _now().strftime(TIME_FORMAT)
    demoted: list[str] = []
    if status == "in_progress":
        for task in tasks:
            if task is not target and task.get("status") == "in_progress":
                task["status"] = "pending"
                task["updated"] = stamp
                demoted.append(str(task.get("id", "")))
    target["status"] = status
    target["updated"] = stamp
    owner = arguments.get("owner")
    if status == "delegated" and isinstance(owner, str) and owner:
        target["owner"] = owner
    elif status != "delegated":
        target.pop("owner", None)
    if status in CLOSED_STATUSES:
        target["completed_at"] = stamp
    else:
        target.pop("completed_at", None)
    if save_error := write_tasks(path, tasks):
        return f"Error: {save_error}\n{render_tasks(tasks)}", True
    rendered = render_tasks([target], completed_limit=1)
    if demoted:
        ids = ", ".join(demoted)
        rendered = f"Auto-demoted in_progress task(s) {ids} to pending.\n{rendered}"
    return rendered, False


def scan_court_guard() -> list[str]:
    """Return warnings from transcript scans, silently skipping all failures."""
    if CLIENT == "codex":
        return []
    session_id = _session_id()
    if session_id is None:
        return []
    paths = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session_id}.jsonl"))
    command = shutil.which("claude_court_guard")
    candidates = [command] if command else []
    if "/usr/local/bin/claude_court_guard" not in candidates:
        candidates.append("/usr/local/bin/claude_court_guard")
    warnings: list[str] = []
    for path in paths:
        for binary in candidates:
            try:
                result = subprocess.run(
                    [binary, path], capture_output=True, text=True, check=False
                )
            except (OSError, UnicodeError, TypeError, ValueError):
                continue
            if result.returncode == 2:
                for line in result.stderr.splitlines():
                    message = line.removeprefix("court-guard: ").strip()
                    if message:
                        warnings.append(
                            f"⚠️ court-guard: {message} — session 汚染の疑い、reset 推奨"
                        )
            break
    return warnings


def _tool_result(text: str, is_error: bool) -> dict[str, object]:
    warnings = scan_court_guard()
    if warnings:
        text = "\n".join([*warnings, text])
    return {"content": [{"type": "text", "text": text}], "isError": is_error}


def _argument_error(name: str, arguments: object) -> str | None:
    if not isinstance(arguments, dict):
        return "Tool arguments must be an object."
    typed_arguments = cast(dict[str, object], arguments)
    keys = set(typed_arguments)
    if name == "TaskList":
        if unknown := keys - {"completed_limit"}:
            return f"Unknown argument(s): {', '.join(sorted(unknown))}."
        limit = arguments.get("completed_limit", 0)
        if type(limit) is not int or not 0 <= limit <= 100:
            return "completed_limit must be an integer between 0 and 100."
        return None
    if name == "TaskCreate":
        allowed = {"content", "activeForm", "parent"}
        if unknown := keys - allowed:
            return f"Unknown argument(s): {', '.join(sorted(unknown))}."
        if not isinstance(arguments.get("content"), str):
            return "TaskCreate requires string argument 'content'."
        for key in ("activeForm", "parent"):
            if key in typed_arguments and not isinstance(typed_arguments[key], str):
                return f"TaskCreate argument {key!r} must be a string."
        return None
    if name == "TaskUpdate":
        allowed = {"id", "status", "owner"}
        if unknown := keys - allowed:
            return f"Unknown argument(s): {', '.join(sorted(unknown))}."
        if not isinstance(arguments.get("id"), str):
            return "TaskUpdate requires string argument 'id'."
        if arguments.get("status") not in STATUSES:
            return f"TaskUpdate requires status {', '.join(STATUSES)}."
        if "owner" in typed_arguments and not isinstance(typed_arguments["owner"], str):
            return "TaskUpdate argument 'owner' must be a string."
    return None


def _call_tool(params: object) -> dict[str, object]:
    if CLIENT != "codex":
        return _call_session_tool(params)
    # Like agent-coord, use Codex's per-call metadata, not inherited environment.
    # Never retain a previous call's identity when metadata is missing.
    meta = params.get("_meta") if isinstance(params, dict) else None
    thread = meta.get("threadId") if isinstance(meta, dict) else None
    if not isinstance(thread, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", thread):
        return _tool_result(
            "Codex _meta.threadId is missing or invalid; no task data accessed.", True
        )
    token = CODEX_THREAD.set(thread)
    try:
        return _call_session_tool(params)
    finally:
        CODEX_THREAD.reset(token)


def _call_session_tool(params: object) -> dict[str, object]:
    if not isinstance(params, dict) or not isinstance(params.get("name"), str):
        return _tool_result("Tool call requires a string 'name'.", True)
    typed_params = cast(dict[str, object], params)
    name = cast(str, typed_params["name"])
    arguments = typed_params.get("arguments", {})
    if name not in {"TaskList", "TaskCreate", "TaskUpdate"}:
        return _tool_result(f"Unknown tool: {name}", True)
    if error := _argument_error(name, arguments):
        return _tool_result(error, True)
    typed_arguments = cast(dict[str, object], arguments)
    if name == "TaskList":
        text, is_error = task_list(cast(int, typed_arguments.get("completed_limit", 0)))
    elif name == "TaskCreate":
        text, is_error = task_create(typed_arguments)
    else:
        text, is_error = task_update(typed_arguments)
    return _tool_result(text, is_error)


def _response(request_id: object, result: object) -> dict[str, object]:
    return {"jsonrpc": "2.0", "id": request_id, "result": result}


def _error(request_id: object, code: int, message: str) -> dict[str, object]:
    return {
        "jsonrpc": "2.0",
        "id": request_id,
        "error": {"code": code, "message": message},
    }


def dispatch(message: object) -> dict[str, object] | None:
    """Dispatch one parsed JSON-RPC message without touching transport streams."""
    if not isinstance(message, dict) or "id" not in message:
        return None
    request_id = message.get("id")
    method = message.get("method")
    try:
        if method == "initialize":
            params = message.get("params")
            protocol = (
                params.get("protocolVersion")
                if isinstance(params, dict)
                and isinstance(params.get("protocolVersion"), str)
                else DEFAULT_PROTOCOL_VERSION
            )
            return _response(
                request_id,
                {
                    "protocolVersion": protocol,
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": "mytask", "version": VERSION},
                    "instructions": (
                        "Read the mytask skill before planning work. Use this ledger to "
                        "remember user requests, break large work into concrete steps, "
                        "and review your own plan against the request as facts change. "
                        "Keep requests, corrections, and deferred work recorded; verify "
                        "completion before updating status. Self-review does not require "
                        "asking the user to approve every plan."
                    ),
                },
            )
        if method == "tools/list":
            return _response(request_id, {"tools": TOOLS})
        if method == "tools/call":
            return _response(request_id, _call_tool(message.get("params")))
        if method == "ping":
            return _response(request_id, {})
        return _error(request_id, -32601, "Method not found")
    except (OSError, UnicodeError, TypeError, ValueError, KeyError):
        return _error(request_id, -32603, "Internal error")


def serve(stdin: TextIO, stdout: TextIO) -> None:
    """Process newline-delimited JSON-RPC until EOF."""
    for line in stdin:
        try:
            message = json.loads(line)
        except (json.JSONDecodeError, TypeError, ValueError):
            continue
        response = dispatch(message)
        if response is not None:
            stdout.write(json.dumps(response, ensure_ascii=False) + "\n")
            stdout.flush()


class MyTasksTest(unittest.TestCase):
    def setUp(self):
        self.temp_dir = self.enterContext(tempfile.TemporaryDirectory())
        self.enterContext(
            mock.patch.dict(
                os.environ,
                {
                    "CLAUDE_PROJECT_DIR": self.temp_dir,
                    "CLAUDE_CODE_SESSION_ID": "test-session",
                },
                clear=False,
            )
        )
        self.path = _task_path("test-session")

    def test_create_adds_pending_created_and_subtask_ids(self):
        with mock.patch(f"{__name__}._now", return_value=datetime(2026, 7, 14, 9, 5)):
            self.assertFalse(task_create({"content": "Parent"})[1])
            self.assertFalse(task_create({"content": "Child", "parent": "1"})[1])
        tasks = read_tasks(self.path)
        self.assertEqual([task["id"] for task in tasks], ["1", "1-1"])
        self.assertEqual(tasks[0]["status"], "pending")
        self.assertEqual(tasks[0]["created"], "2026-07-14 09:05")
        self.assertEqual(tasks[0]["updated"], "2026-07-14 09:05")

    def test_status_changes_stamp_updated_on_target_and_demoted(self):
        for content in ("One", "Two"):
            with mock.patch(
                f"{__name__}._now", return_value=datetime(2026, 7, 14, 9, 5)
            ):
                task_create({"content": content})
        task_update({"id": "1", "status": "in_progress"})
        with mock.patch(f"{__name__}._now", return_value=datetime(2026, 7, 14, 11, 30)):
            task_update({"id": "2", "status": "in_progress"})
        tasks = read_tasks(self.path)
        self.assertEqual(tasks[0]["status"], "pending")
        self.assertEqual(tasks[0]["updated"], "2026-07-14 11:30")
        self.assertEqual(tasks[1]["updated"], "2026-07-14 11:30")
        self.assertEqual(tasks[1]["created"], "2026-07-14 09:05")

    def test_update_completion_and_single_in_progress(self):
        tasks: list[Task] = [
            {"id": "1", "content": "One", "status": "in_progress"},
            {"id": "2", "content": "Two", "status": "pending"},
        ]
        self.assertIsNone(write_tasks(self.path, tasks))
        text, is_error = task_update({"id": "2", "status": "in_progress"})
        updated = read_tasks(self.path)
        self.assertFalse(is_error)
        self.assertEqual(updated[0]["status"], "pending")
        self.assertIn("Auto-demoted", text)
        with mock.patch(f"{__name__}._now", return_value=datetime(2026, 7, 14, 10, 0)):
            task_update({"id": "2", "status": "completed"})
        self.assertEqual(read_tasks(self.path)[1]["completed_at"], "2026-07-14 10:00")
        task_update({"id": "2", "status": "pending"})
        self.assertNotIn("completed_at", read_tasks(self.path)[1])

    def test_delegated_items_stay_beside_the_single_in_progress(self):
        with mock.patch(f"{__name__}._now", return_value=datetime(2026, 7, 14, 9, 5)):
            for content in ("Watch", "Fix A", "Fix B"):
                task_create({"content": content})
        task_update({"id": "2", "status": "delegated", "owner": "agent-a"})
        task_update({"id": "3", "status": "delegated"})
        text, error = task_update({"id": "1", "status": "in_progress"})
        self.assertFalse(error)
        self.assertNotIn("Auto-demoted", text)
        self.assertEqual(
            render_tasks(read_tasks(self.path)).splitlines(),
            [
                "1 ▶️ Watch (2026-07-14 09:05)",
                "2 🤖 Fix A [agent-a] (2026-07-14 09:05)",
                "3 🤖 Fix B (2026-07-14 09:05)",
            ],
        )
        # Taking an item back clears the delegate so a stale owner is never shown.
        task_update({"id": "2", "status": "in_progress"})
        tasks = read_tasks(self.path)
        self.assertNotIn("owner", tasks[1])
        self.assertEqual(
            [task["status"] for task in tasks], ["pending", "in_progress", "delegated"]
        )
        delegate = {"id": "1", "status": "delegated"}
        self.assertIsNotNone(_argument_error("TaskUpdate", {**delegate, "owner": 1}))
        self.assertIsNone(_argument_error("TaskUpdate", {**delegate, "owner": "x"}))

    def test_nested_numbering_rendering_and_update(self):
        task_create({"content": "Parent"})
        task_create({"content": "Child", "parent": "1"})
        task_create({"content": "Grandchild", "parent": "1-1"})
        task_update({"id": "1-1-1", "status": "completed"})
        text, error = task_create({"content": "Grandchild two", "parent": "1-1"})
        self.assertFalse(error)
        self.assertIn("    1-1-2 ◻️ Grandchild two", text)
        task_create({"content": "Great grandchild", "parent": "1-1-2"})
        task_create({"content": "Sibling", "parent": "1"})
        task_create({"content": "Next parent"})
        self.assertEqual(
            [task["id"] for task in read_tasks(self.path)],
            ["1", "1-1", "1-1-1", "1-1-2", "1-1-2-1", "1-2", "2"],
        )
        text, error = task_update({"id": "1-1-2-1", "status": "in_progress"})
        self.assertFalse(error)
        self.assertIn("      1-1-2-1 ▶️ Great grandchild", text)
        before = self.path.read_text()
        self.assertTrue(task_create({"content": "Missing", "parent": "1-9"})[1])
        self.assertEqual(self.path.read_text(), before)

    def test_cancelled_closes_like_completed(self):
        tasks: list[Task] = [
            {"id": "1", "content": "Dropped", "status": "pending"},
            {"id": "2", "content": "Open", "status": "pending"},
        ]
        self.assertIsNone(write_tasks(self.path, tasks))
        with mock.patch(f"{__name__}._now", return_value=datetime(2026, 7, 14, 10, 0)):
            text, error = task_update({"id": "1", "status": "cancelled"})
        self.assertFalse(error)
        self.assertTrue(text.startswith("1 ✖️ Dropped"))
        self.assertEqual(read_tasks(self.path)[0]["completed_at"], "2026-07-14 10:00")
        self.assertEqual(task_list()[0], "2 ◻️ Open")
        self.assertEqual(task_list(1)[0], "1 ✖️ Dropped\n2 ◻️ Open")
        self.assertIsNone(
            _argument_error("TaskUpdate", {"id": "1", "status": "cancelled"})
        )

    def test_nested_numeric_order_and_hidden_ids_are_not_reused(self):
        ids = ["4-10", "4-1-10", "5", "4-1-2", "4-1", "4", "4-2"]
        tasks = [{"id": value, "content": "Item", "status": "pending"} for value in ids]
        self.assertEqual(
            [line.split()[0] for line in render_tasks(tasks).splitlines()],
            ["4", "4-1", "4-1-2", "4-1-10", "4-2", "4-10", "5"],
        )
        tasks[1].update(status="completed", completed_at="2000-01-01 00:00")
        write_tasks(self.path, tasks)
        self.assertNotIn("4-1-10", task_list()[0])
        text, error = task_create({"content": "After hidden", "parent": "4-1"})
        self.assertFalse(error)
        self.assertIn("4-1-11 ◻️ After hidden", text)

    def test_filter_order_rendering_and_legacy_fields(self):
        tasks: list[Task] = [
            {"id": "2", "content": "Second", "status": "blocked"},
            {"id": "1-2", "content": "Child two", "status": "pending"},
            {"id": "1", "content": "First", "status": "in_progress"},
            {
                "id": "1-1",
                "content": "Child one",
                "status": "completed",
                "completed_at": "2026-07-14 01:00",
            },
            {
                "id": "3",
                "content": "Old",
                "status": "completed",
                "completed_at": "2026-07-13 23:59",
            },
            {"id": "4", "content": "Legacy", "status": "completed"},
        ]
        self.assertEqual(
            render_tasks(tasks).splitlines(),
            [
                "1 ▶️ First",
                "  1-2 ◻️ Child two",
                "2 🚧 Second",
            ],
        )

    def test_compact_responses_and_recent_completion_window(self):
        tasks = [
            {"id": str(i), "content": "Old completion", "status": "completed",
             "completed_at": "2026-07-14 01:00"}
            for i in range(1, 101)
        ]
        # Completion recency, not ID, decides which completed entries are shown.
        tasks[0]["completed_at"] = "2026-07-15 01:00"
        tasks.append({"id": "101", "content": "Still blocked", "status": "blocked"})
        write_tasks(self.path, tasks)
        self.assertEqual(task_list()[0], "101 🚧 Still blocked")
        recent = task_list(5)[0].splitlines()
        self.assertEqual([line.split()[0] for line in recent],
                         ["1", "97", "98", "99", "100", "101"])
        created, error = task_create({"content": "New request"})
        self.assertFalse(error)
        self.assertEqual(len(created.splitlines()), 1)
        self.assertTrue(created.startswith("102 ◻️ New request"))
        updated, error = task_update({"id": "102", "status": "completed"})
        self.assertFalse(error)
        self.assertEqual(len(updated.splitlines()), 1)
        self.assertTrue(updated.startswith("102 ✅ New request"))
        self.assertEqual(task_list()[0], "101 🚧 Still blocked")
        self.assertEqual(len(read_tasks(self.path)), 102)
        for invalid in [-1, 101, True, "5", None]:
            self.assertIsNotNone(_argument_error("TaskList", {"completed_limit": invalid}))
        self.assertIsNone(_argument_error("TaskList", {"completed_limit": 5}))

    def test_protocol_sequence_unknown_method_and_notifications(self):
        with mock.patch(f"{__name__}.scan_court_guard", return_value=[]):
            initialized = dispatch(
                {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {"protocolVersion": "test-version"},
                }
            )
            self.assertEqual(
                self._nested(initialized, "result", "protocolVersion"), "test-version"
            )
            self.assertIsNone(
                dispatch({"jsonrpc": "2.0", "method": "notifications/initialized"})
            )
            listed = dispatch({"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
            tools = self._nested(listed, "result", "tools")
            self.assertIsInstance(tools, list)
            self.assertEqual(len(cast(list[object], tools)), 3)
            created = dispatch(
                {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                        "name": "TaskCreate",
                        "arguments": {"content": "Protocol task"},
                    },
                }
            )
            self.assertFalse(self._nested(created, "result", "isError"))
            listed_tasks = dispatch(
                {
                    "jsonrpc": "2.0",
                    "id": 4,
                    "method": "tools/call",
                    "params": {"name": "TaskList", "arguments": {}},
                }
            )
            result = self._nested(listed_tasks, "result")
            self.assertIn("Protocol task", json.dumps(result))
        unknown = dispatch({"jsonrpc": "2.0", "id": 5, "method": "nope"})
        self.assertEqual(self._nested(unknown, "error", "code"), -32601)
        self.assertIsNone(dispatch({"jsonrpc": "2.0", "method": "ping"}))

    @staticmethod
    def _nested(value: object, *keys: str) -> object:
        for key in keys:
            if not isinstance(value, dict):
                raise AssertionError(f"Expected object before key {key!r}")
            value = cast(dict[str, object], value)[key]
        return value

