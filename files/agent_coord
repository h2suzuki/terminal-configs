def parse_cli(argv: list[str] | None) -> argparse.Namespace:
    """Shared flags keep SUPPRESS defaults (set_defaults would leak into every subparser), so fill them here."""
    args = build_parser().parse_args(argv)
    for key, value in (("sid", None), ("json", False), ("no_autostart", False)):
        vars(args).setdefault(key, value)
    return args


def cli_params(args: argparse.Namespace) -> Json:
    skip = {"sid", "json", "no_autostart", "command", "action"}
    return {
        k: v
        for k, v in vars(args).items()
        if k not in skip and v is not None and v is not False
    }


def daemonize_serve(home: Path) -> int:
    try:
        Client(home / "coord.sock").close()  # autostart spawns the daemon and waits
    except CoordError as error:
        print(
            f"daemon did not come up ({error}); see {home / 'daemon.log'}",
            file=sys.stderr,
        )
        return 1
    print(f"daemon started (home {home})")
    return 0


def doctor(sid: str | None, autostart: bool) -> int:
    identity = git_identity(os.getcwd())
    print(
        f"home: {coord_home()}  socket: {sock_path()}  exists: {sock_path().exists()}"
    )
    print(
        f"caller: client={detect_client()} sid={sid or '(none: pass --as or set CLAUDE_CODE_SESSION_ID)'}"
    )
    print(
        f"cwd identity: project={identity['project']} repo_top={identity['repo_top']} checkout={identity['checkout']} branch={identity['branch']}"
    )
    try:
        client = Client(autostart=autostart)
    except CoordError as error:
        print(f"connect: FAILED: {error}")
        return 1
    pong = client.call("ping")
    print(f"connect: ok (daemon pid {pong['pid']} version {pong['version']})")
    if sid:
        try:
            me = client.call("whoami", sid=sid)
            print(
                f"session: registered as {me['session']['name']} (unread {me['unread']})"
            )
        except CoordError as error:
            print(f"session: {error}")
    print(
        "notifications: Claude Code hooks inject unread nudges at prompt/tool boundaries; no in-flight interrupt"
    )
    client.close()
    return 0


def main(argv: list[str] | None = None) -> int:
    args = parse_cli(argv)
    home = coord_home()
    if args.command == "serve":
        return daemonize_serve(home) if args.daemon else serve(home)
    if args.command == "mcp":
        return run_mcp(sys.stdin, sys.stdout)
    if args.command == "hook":
        return hook_main(args.event, sys.stdin, sys.stdout)
    sid = detect_sid(args.sid)
    if args.command == "doctor":
        return doctor(sid, not args.no_autostart)
    try:
        client = Client(
            autostart=not args.no_autostart
            and args.command not in ("stop", "status", "watch")
        )
    except CoordError as error:
        print(f"agent_coord: {error}", file=sys.stderr)
        return 2
    try:
        if args.command == "stop":
            client.call("shutdown")
            print("stopping")
            return 0
        if args.command == "watch":
            return watch(client, args.interval)
        result = run_command(client, args, sid)
    except CoordError as error:
        print(f"agent_coord: {error}", file=sys.stderr)
        if args.json and error.data:
            print(json.dumps(error.data, ensure_ascii=False))
        return 3 if error.code == -32010 else 1
    finally:
        client.close()
    print(pretty(result) if args.json else render_tool(args.command, result))
    return 0


def run_command(client: Client, args: argparse.Namespace, sid: str | None) -> Json:
    params = cli_params(args)
    if args.command == "join":
        return client.call(
            "join",
            sid=sid,
            client=params.pop("client", None) or detect_client(),
            native_id=native_id(),
            cwd=params.pop("cwd", None) or os.getcwd(),
            **params,
        )
    method = args.command.replace("-", "_")
    if args.command == "worktree":
        method = f"worktree_{args.action.replace('-', '_')}"
    return client.call(method, sid=sid, **params)


def watch(client: Client, interval: float) -> int:
    status = Client(autostart=False)  # the subscribed socket only streams events

    def draw() -> None:
        text = render_status(status.call("status"))
        sys.stdout.write(
            "\033[2J\033[H"
            + text
            + f"\n\n{datetime.now():%H:%M:%S} watching (ctrl-c to stop)\n"
        )
        sys.stdout.flush()

    draw()
    client.call("subscribe")
    client.sock.settimeout(None)
    try:
        while True:
            if select.select([client.sock], [], [], interval)[0]:
                if not client.file.readline():
                    print("coordinator closed the stream", file=sys.stderr)
                    return 1
            draw()
    except KeyboardInterrupt:
        return 0
    finally:
        status.close()


if __name__ == "__main__":
    sys.exit(main())
