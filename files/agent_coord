def parse_cli(argv: list[str] | None) -> argparse.Namespace:
    args = build_parser().parse_args(argv)
    for key, value in (("sid", None), ("json", False), ("no_autostart", False)):
        vars(args).setdefault(key, value)
    return args


def cli_params(args: argparse.Namespace) -> Json:
    skip = {"sid", "json", "no_autostart", "command", "action", "client"}
    return {
        k: v
        for k, v in vars(args).items()
        if k not in skip and v is not None and v is not False
    }


def daemonize_serve(home: Path) -> int:
    try:
        Client(home / "coord.sock").close()
    except CoordError as error:
        print(
            f"daemon did not come up ({error}); see {home / 'daemon.log'}",
            file=sys.stderr,
        )
        return 1
    print(f"daemon started (home {home})")
    return 0


def doctor(identity: Identity, autostart: bool, out: TextIO = sys.stdout) -> int:
    """Each lane on its own line: connect (CLI/MCP), session, notify, enforcement, sandbox."""
    adapter = adapter_for(identity.client)
    lines = [
        f"home: {coord_home()}  socket: {sock_path()}  exists: {sock_path().exists()}"
    ]
    try:
        client = Client(autostart=autostart)
    except CoordError as error:
        lines.append(f"connect: FAILED: {error}")
        out.write("\n".join(lines) + "\n")
        return 1
    pong = client.call("ping")
    mismatch = (
        "" if pong["version"] == VERSION else f" (CLI is {VERSION}: restart the daemon)"
    )
    lines.append(
        f"connect: ok (daemon pid {pong['pid']} version {pong['version']}{mismatch})"
    )
    sid = (
        session_id_for(identity.client, identity.native_id)
        if identity.native_id
        else "-"
    )
    lines.append(
        f"session: client={identity.client} native_id={identity.native_id or '(none: joins as anon)'} sid={sid}"
    )
    if identity.client == "claude-code" and identity.native_id:
        found = ClaudeCodeAdapter().inbox(identity.native_id)
        lines.append(
            f"notify: push via inbox socket {found[0] if found else '(session not in the registry: pull only)'}"
        )
    elif identity.client == "codex":
        lines.append("notify: push via `codex queue --thread`")
    else:
        lines.append(
            f"notify: pull (hooks / polling only) for client {identity.client}"
        )
    lines.append(f"enforcement: {adapter.enforcement} for client {identity.client}")
    sandboxed = os.environ.get("CLAUDE_CODE_SANDBOX") or os.environ.get("SANDBOX")
    lines.append(
        f"sandbox: {'sandboxed shell' if sandboxed else 'host shell'}; socket reached at {sock_path()}"
    )
    client.close()
    out.write("\n".join(lines) + "\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = parse_cli(argv)
    home = coord_home()
    if args.command == "serve":
        return daemonize_serve(home) if args.daemon else serve(home)
    if args.command == "mcp":
        return run_mcp(sys.stdin, sys.stdout, args.client)
    if args.command == "hook":
        return hook_main(args.client, args.event, sys.stdin, sys.stdout)
    identity = identity_from_env()
    if args.command == "doctor":
        return doctor(identity, not args.no_autostart)
    try:
        client = Client(
            autostart=not args.no_autostart
            and args.command not in ("stop", "status", "watch")
        )
    except CoordError as error:
        print(f"agent_coord: {error}", file=sys.stderr)
        return 2
    try:
        if args.command == "stop":
            client.call("shutdown")
            print("stopping")
            return 0
        if args.command == "watch":
            return watch(client, args.interval)
        result = run_command(client, args, identity)
    except CoordError as error:
        print(f"agent_coord: {error}", file=sys.stderr)
        if args.json and error.data:
            print(json.dumps(error.data, ensure_ascii=False))
        return 3 if error.code == -32010 else 1
    finally:
        client.close()
    print(pretty(result) if args.json else render_tool(args.command, result))
    return 0


READ_ONLY = frozenset({"status", "sessions", "history", "requests", "resources"})


def run_command(client: Client, args: argparse.Namespace, identity: Identity) -> Json:
    params = cli_params(args)
    command = args.command
    if command == "join":
        cwd = params.pop("cwd", None)
        return client.call(
            "join",
            client=identity.client,
            native_id=identity.native_id,
            cwd=cwd or identity.cwd,
            **params,
        )
    if command == "force-release" or (
        command == "worktree" and args.action == "force-release"
    ):
        method = (
            "force_release" if command == "force-release" else "worktree_force_release"
        )
        return client.call(method, user_action=True, **params)
    sid: str | None = None
    if command not in READ_ONLY:
        if args.sid:
            client.call(
                "attach",
                sid=args.sid,
                token=os.environ.get("AGENT_COORD_TOKEN"),
                native_id=identity.native_id,
            )
            sid = args.sid
        else:
            sid = ensure_session(client, identity)["session"]["sid"]
    method = {"transfer": "resource_transfer", "accept": "resource_accept"}.get(
        command, command.replace("-", "_")
    )
    if command == "worktree":
        method = f"worktree_{args.action.replace('-', '_')}"
    return client.call(method, sid=sid, **params)


def watch(client: Client, interval: float) -> int:
    status = Client(autostart=False)
    lines: queue.Queue[str] = queue.Queue()

    def reader() -> None:
        while line := client.file.readline():
            lines.put(line)
        lines.put("")

    def draw() -> None:
        stamp = f"{datetime.now():%H:%M:%S} watching (ctrl-c to stop)"
        sys.stdout.write(
            "\033[2J\033[H" + render_status(status.call("status")) + f"\n\n{stamp}\n"
        )
        sys.stdout.flush()

    client.call("subscribe")
    client.sock.settimeout(None)
    threading.Thread(target=reader, daemon=True).start()
    try:
        draw()
        while True:
            try:
                line = lines.get(timeout=interval)
            except queue.Empty:
                draw()
                continue
            while line and not lines.empty():  # coalesce a burst into one redraw
                line = lines.get_nowait()
            if line == "":
                print("coordinator closed the stream", file=sys.stderr)
                return 1
            draw()
    except KeyboardInterrupt:
        return 0
    finally:
        status.close()


if __name__ == "__main__":
    sys.exit(main())
