MCP_TOOL_NAMES = frozenset(t["name"] for t in MCP_TOOLS)


class McpAdapter:
    """stdio MCP server that forwards every tool call to the daemon as one session."""

    def __init__(self, client: Client, sid: str, cwd: str):
        self.client = client
        self.sid = sid
        self.cwd = cwd
        self.joined = False

    def ensure_joined(self) -> Json:
        result = self.client.call(
            "join",
            sid=self.sid,
            client=detect_client(),
            native_id=native_id(),
            cwd=self.cwd,
            model=os.environ.get("CLAUDE_MODEL"),
        )
        self.joined = True
        return result

    def call_tool(self, name: str, arguments: Json) -> Json:
        if not self.joined:
            self.ensure_joined()
        if name == "worktree":
            action = str(arguments.pop("action", ""))
            method = f"worktree_{action}"
            if method not in METHODS or action == "force_release":
                raise CoordError(f"unknown worktree action {action!r}", -32602)
            return self.client.call(method, sid=self.sid, **arguments)
        if name not in MCP_TOOL_NAMES:
            raise CoordError(f"unknown tool {name}", -32601)
        result = self.client.call(name, sid=self.sid, **arguments)
        if name == "leave":
            self.joined = False
        return result

    def dispatch(self, message: Json) -> Json | None:
        if "id" not in message:
            return None
        req_id, method = message.get("id"), message.get("method")
        if method == "initialize":
            params = message.get("params") or {}
            protocol = (
                params.get("protocolVersion")
                if isinstance(params.get("protocolVersion"), str)
                else MCP_PROTOCOL_VERSION
            )
            return rpc_result(
                req_id,
                {
                    "protocolVersion": protocol,
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": "agent-coord", "version": VERSION},
                },
            )
        if method == "tools/list":
            return rpc_result(req_id, {"tools": MCP_TOOLS})
        if method == "ping":
            return rpc_result(req_id, {})
        if method == "tools/call":
            params = message.get("params") or {}
            name = params.get("name")
            arguments = params.get("arguments") or {}
            if not isinstance(name, str) or not isinstance(arguments, dict):
                text = "tool call needs a name and an object of arguments"
                return rpc_result(req_id, tool_result(text, True))
            try:
                result = self.call_tool(name, dict(arguments))
            except CoordError as error:
                return rpc_result(
                    req_id, tool_result(f"error {error.code}: {error}", True)
                )
            return rpc_result(req_id, tool_result(render_tool(name, result), False))
        return rpc_error(req_id, -32601, "Method not found")


def tool_result(text: str, is_error: bool) -> Json:
    return {"content": [{"type": "text", "text": text}], "isError": is_error}


def render_event(event: Json) -> str:
    body = event["body"]
    who = body.get("from_name") or event["actor"] or "?"
    scope = event["scope_kind"] + (
        f":{event['scope_key']}" if event["scope_kind"] != "all" else ""
    )
    head = f"#{event['seq']} {fmt_time(event['ts'])} [{event['kind']}] {who} -> {scope}"
    if event["kind"] == "message":
        return f"{head}\n    {body.get('text', '')}"
    if event["kind"] == "request_open":
        return f"{head} {body.get('req_id', '')}: {body.get('subject', '')}\n    {body.get('text', '')}".rstrip()
    detail = {
        k: v
        for k, v in body.items()
        if k not in ("from_name",) and v not in (None, "", False)
    }
    return f"{head} {json.dumps(detail, ensure_ascii=False)}"


def render_catchup(result: Json) -> str:
    events = result["events"]
    if not events:
        return f"No unread events (cursor {result['cursor']})."
    lines = [render_event(e) for e in events]
    lines.append(
        f"-- {len(events)} event(s){' (more pending)' if result['more'] else ''}. Ack with ack_through={result['last_seq']} on your next catchup, or ack(through={result['last_seq']})."
    )
    return "\n".join(lines)


def render_history(result: Json) -> str:
    return "\n".join(render_event(e) for e in result["events"]) or "No events."


def render_identity(result: Json) -> str:
    s = result["session"]
    return (
        f"{s['sid']} name={s['name']} client={s['client']} project={s['project']}\n"
        f"repo_top={s['repo_top']} checkout={s['checkout']} branch={s['branch']} edit_worktree={s['edit_worktree']}\n"
        f"peers in project: {', '.join(p['name'] for p in result['peers_same_project']) or 'none'} ({result['peers_total']} total)\n"
        f"held: {[r['key'] for r in result['held_resources']]} worktrees: {result['owned_worktrees']} open requests: {len(result['open_requests'])} unread: {result['unread']}"
    )


def render_tool(name: str, result: Json) -> str:
    renderers = {
        "catchup": render_catchup,
        "history": render_history,
        "status": render_status,
        "sessions": lambda r: render_sessions(r["sessions"]),
        "join": render_identity,
        "whoami": render_identity,
    }
    return renderers.get(name, pretty)(result)


def run_mcp(stdin: TextIO, stdout: TextIO) -> int:
    sid = detect_sid() or f"{detect_client()}-{short_id()}"
    cwd = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    try:
        client = Client()
    except CoordError as error:
        print(f"agent_coord mcp: {error}", file=sys.stderr)
        return 1
    adapter = McpAdapter(client, sid, cwd)
    try:
        adapter.ensure_joined()
    except CoordError as error:
        print(f"agent_coord mcp: join failed: {error}", file=sys.stderr)
    for line in stdin:
        try:
            message = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        if not isinstance(message, dict):
            continue
        response = adapter.dispatch(message)
        if response is not None:
            stdout.write(json_line(response))
            stdout.flush()
    return 0


# ---------------------------------------------------------------- hooks (Claude Code)


def hook_main(event_name: str, stdin: TextIO, stdout: TextIO) -> int:
    """Claude Code hook entry: join on start, nudge on unread, deny edits outside the claimed worktree."""
    try:
        payload = json.loads(stdin.read() or "{}")
    except (json.JSONDecodeError, ValueError):
        payload = {}
    client_name = detect_client()
    native = payload.get("session_id") or native_id()
    prefix = "codex" if client_name == "codex" else "cc"
    sid = f"{prefix}-{native}" if native else detect_sid()
    if not sid:
        return 0
    cwd = payload.get("cwd") or os.getcwd()
    try:
        client = Client(autostart=event_name != "SessionEnd")
    except CoordError as error:
        print(f"agent_coord hook: {error}", file=sys.stderr)
        return 0
    try:
        if event_name == "SessionStart":
            joined = client.call(
                "join", sid=sid, client=client_name, native_id=native, cwd=cwd
            )
            peers = ", ".join(p["name"] for p in joined["peers_same_project"]) or "none"
            emit_hook(
                stdout,
                event_name,
                additionalContext=f"[agent-coord] joined as {sid} ({joined['session']['name']}). Same-project peers: {peers}. Unread: {joined['unread']}. Tools: mcp agent_coord (send/catchup/acquire/worktree) or `agent_coord` CLI.",
            )
        elif event_name == "SessionEnd":
            client.call("update", sid=sid, status="done")
        elif event_name == "PreToolUse":
            tool_input = payload.get("tool_input") or {}
            target = tool_input.get("file_path") or tool_input.get("notebook_path")
            if target:
                verdict = client.call("edit_check", sid=sid, path=target)
                if not verdict["allow"]:
                    emit_hook(
                        stdout,
                        event_name,
                        permissionDecision="deny",
                        permissionDecisionReason=f"[agent-coord] {verdict['reason']}",
                    )
        else:
            nudge = client.call("nudge", sid=sid)
            if nudge.get("text"):
                emit_hook(stdout, event_name, additionalContext=nudge["text"])
    except CoordError as error:
        if error.code != -32001:
            print(f"agent_coord hook: {error}", file=sys.stderr)
    finally:
        client.close()
    return 0


def emit_hook(stdout: TextIO, event_name: str, **fields: str) -> None:
    stdout.write(
        json_line({"hookSpecificOutput": {"hookEventName": event_name, **fields}})
    )


# ---------------------------------------------------------------- CLI rendering


def table(rows: list[list[str]], header: list[str]) -> str:
    widths = [max(len(str(r[i])) for r in [header, *rows]) for i in range(len(header))]

    def line(cells: list[str]) -> str:
        return "  ".join(str(c).ljust(widths[i]) for i, c in enumerate(cells)).rstrip()

    return "\n".join(
        [line(header), line(["-" * w for w in widths]), *[line(r) for r in rows]]
    )


def render_sessions(sessions: list[Json]) -> str:
    if not sessions:
        return "No sessions."
    rows = [
        [
            s["sid"],
            s["name"] or "-",
            s["client"] or "-",
            s["status"] or "-",
            (s["task"] or "-")[:40],
            s["project"] or "-",
            os.path.basename(s["checkout"] or s["cwd"] or "-")
            + (f"@{s['branch']}" if s.get("branch") else ""),
            f"{s.get('connections', '?')}c",
            s["updated_ago"],
            str(s.get("unread", "")),
        ]
        for s in sessions
    ]
    return table(
        rows,
        [
            "sid",
            "name",
            "client",
            "status",
            "task",
            "project",
            "checkout",
            "conn",
            "updated",
            "unread",
        ],
    )


def render_status(status: Json) -> str:
    service = status["service"]
    parts = [
        f"agent_coord {service['version']} pid {service['pid']} up since {fmt_time(service['started_at'])}; {service['events']} events, {service['connections']} live connection(s); home {service['home']}",
        "",
        "Sessions (self-reported status/task; 'updated' = last self report, conn = live connections)",
        render_sessions(status["sessions"]),
    ]
    if status["resources"]:
        parts += [
            "",
            "Resources",
            table(
                [
                    [
                        r["key"],
                        r["owner"] or "-",
                        r["purpose"] or "-",
                        fmt_time(r["acquired_at"]),
                        r["state"] or "-",
                        str(r["generation"]),
                    ]
                    for r in status["resources"]
                ],
                ["key", "owner", "purpose", "since", "state", "gen"],
            ),
        ]
    if status["worktrees"]:
        parts += [
            "",
            "Worktrees",
            table(
                [
                    [
                        w["path"],
                        w["owner"] or "-",
                        "enforce" if w["enforce"] else "coop",
                        fmt_time(w["claimed_at"]),
                        w["pending_to"] or "-",
                    ]
                    for w in status["worktrees"]
                ],
                ["path", "owner", "mode", "since", "pending_to"],
            ),
        ]
    if status["requests"]:
        parts += [
            "",
            "Open requests",
            table(
                [
                    [
                        r["req_id"],
                        r["sender"],
                        f"{r['scope_kind']}:{r['scope_key']}"[:40],
                        r["subject"][:40],
                        fmt_time(r["created_at"]),
                    ]
                    for r in status["requests"]
                ],
                ["id", "from", "to", "subject", "opened"],
            ),
        ]
    return "\n".join(parts)


