def check_arguments(schema: Json, arguments: Json) -> None:
    properties = schema.get("properties", {})
    for key in schema.get("required", []):
        if key not in arguments:
            raise CoordError(f"argument {key!r} is required", -32602)
    for key, value in arguments.items():
        spec = properties.get(key)
        if spec is None:
            raise CoordError(f"unknown argument {key!r}", -32602)
        expected = JSON_TYPES.get(spec.get("type", ""))
        if expected and (
            not isinstance(value, expected)
            or (expected is int and isinstance(value, bool))
        ):
            raise CoordError(f"argument {key!r} must be {spec['type']}", -32602)
        if "enum" in spec and value not in spec["enum"]:
            raise CoordError(f"argument {key!r} must be one of {spec['enum']}", -32602)


class McpAdapter:
    """stdio MCP server: one session identity, every tool call forwarded to the daemon."""

    def __init__(self, client: Client, identity: Identity):
        self.client = client
        self.identity = identity
        self.sid: str | None = None
        self.acting_as: str | None = None

    def ensure_joined(self) -> str:
        if self.sid is None:
            joined = ensure_session(
                self.client, self.identity, model=os.environ.get("CLAUDE_MODEL")
            )
            self.sid = joined["session"]["sid"]
            self.acting_as = self.sid
        return self.sid

    def bind_thread(self, meta: Json) -> None:
        """Codex omits the thread id from the MCP env but carries it per call in _meta.threadId
        (openai/codex#18093); adopt it so we act as the session the hook joined, not an anon one."""
        thread = meta.get("threadId") if isinstance(meta, dict) else None
        if thread and not self.identity.native_id:
            self.identity = replace(self.identity, native_id=str(thread))
            self.sid = None

    def call_tool(self, name: str, arguments: Json) -> Json:
        if self.identity.client == "antigravity" and self.sid is None:
            raise CoordError("Antigravity call has no bound conversation", -32602)
        spec = next((t for t in MCP_TOOLS if t["name"] == name), None)
        if spec is None:
            raise CoordError(f"unknown tool {name}", -32601)
        arguments = {k: v for k, v in arguments.items() if k not in RESERVED_ARGS}
        as_sid = arguments.pop("as", None)
        check_arguments(spec["inputSchema"], arguments)
        sid = self.ensure_joined()
        # Shared by the parent and its children: re-attach whenever the target
        # differs from what a prior call (its own or another's) left this bound as.
        target = str(as_sid) if as_sid else sid
        if target != self.acting_as:
            self.client.call("attach", sid=target, native_id=self.identity.native_id)
            self.acting_as = target
        if name == "wait":
            return wait_for_events(
                self.client,
                target,
                arguments.get("timeout", WAIT_DEFAULT),
                arguments.get("after"),
            )
        result = self.client.call(name, sid=target, **arguments)
        if name == "leave":
            if target == sid:
                self.sid = None
            self.acting_as = None
        return result

    def bind_antigravity(self, meta: Json) -> None:
        # CLI 1.2.8 sends the native conversation ID in each tools/call's _meta.
        self.sid = None
        native = meta.get(AGY_CONVERSATION_META) if isinstance(meta, dict) else None
        if not isinstance(native, str) or not native.strip():
            raise CoordError(
                "Antigravity MCP conversation metadata missing; cannot select an inbox",
                -32602,
            )
        sid = session_id_for("antigravity", native)
        attached = self.client.call("attach", sid=sid, native_id=native)
        self.identity = Identity("antigravity", native, attached["session"]["cwd"])
        self.sid = sid
        self.acting_as = sid

    def dispatch(self, message: Json) -> Json | None:
        if "id" not in message:
            return None
        req_id, method = message.get("id"), message.get("method")
        params = message.get("params") or {}
        if method == "initialize":
            requested = params.get("protocolVersion")
            protocol = requested if isinstance(requested, str) else MCP_PROTOCOL_VERSION
            return rpc_result(
                req_id,
                {
                    "protocolVersion": protocol,
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": "agent-coord", "version": VERSION},
                },
            )
        if method == "tools/list":
            return rpc_result(req_id, {"tools": MCP_TOOLS})
        if method == "ping":
            return rpc_result(req_id, {})
        if method == "tools/call":
            self.bind_thread(params.get("_meta") or {})
            name, arguments = params.get("name"), params.get("arguments") or {}
            if not isinstance(name, str) or not isinstance(arguments, dict):
                return rpc_result(
                    req_id,
                    tool_result(
                        "tool call needs a name and an object of arguments", True
                    ),
                )
            try:
                if self.identity.client == "antigravity":
                    self.bind_antigravity(params.get("_meta") or {})
                result = self.call_tool(name, dict(arguments))
            except CoordError as error:
                return rpc_result(
                    req_id, tool_result(f"error {error.code}: {error}", True)
                )
            except Exception as error:  # the adapter must outlive any single bad call
                return rpc_result(req_id, tool_result(f"error: {error!r}", True))
            return rpc_result(req_id, tool_result(render_tool(name, result), False))
        return rpc_error(req_id, -32601, "Method not found")


def tool_result(text: str, is_error: bool) -> Json:
    return {"content": [{"type": "text", "text": text}], "isError": is_error}


def run_mcp(stdin: TextIO, stdout: TextIO, client_name: str | None = None) -> int:
    identity = identity_from_env(client_name)
    try:
        client = Client()
    except CoordError as error:
        print(f"agent_coord mcp: {error}", file=sys.stderr)
        return 1
    adapter = McpAdapter(client, identity)
    # Codex has no native id in env; it defers to the first call's _meta.threadId
    if identity.native_id:
        try:
            adapter.ensure_joined()
        except CoordError as error:
            print(f"agent_coord mcp: join failed: {error}", file=sys.stderr)
    for line in stdin:
        try:
            message = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        if not isinstance(message, dict):
            continue
        response = adapter.dispatch(message)
        if response is not None:
            stdout.write(json_line(response))
            stdout.flush()
    client.close()
    return 0


# ---------------------------------------------------------------- hooks


def hook_main(client_name: str, event: str, stdin: TextIO, stdout: TextIO) -> int:
    """Hook entry for every client: the adapter translates payload and output, the daemon decides."""
    adapter = adapter_for(client_name)
    try:
        payload = json.loads(stdin.read() or "{}")
    except (json.JSONDecodeError, ValueError):
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    native = adapter.hook_native(payload)
    if not native:
        if output := adapter.hook_silence(event):
            stdout.write(json_line(output))
        return 0
    identity = Identity(
        adapter.name, str(native), adapter.hook_cwd(payload) or os.getcwd()
    )
    role = adapter.hook_role(event)
    try:
        # Interrupt is cleanup for a user-cancelled turn. An offline daemon has
        # no live turn to clear, and starting one can outlast this hook's 3s cap.
        client = Client(autostart=role != "end" and event != "Interrupt")
    except CoordError as error:
        print(f"agent_coord hook: {error}", file=sys.stderr)
        if output := adapter.hook_silence(event):
            stdout.write(json_line(output))
        return 0
    try:
        output = hook_dispatch(client, adapter, identity, event, role, payload)
    except CoordError as error:
        output = adapter.hook_silence(event)
        print(f"agent_coord hook: {error}", file=sys.stderr)
    finally:
        client.close()
    if output is not None:
        stdout.write(json_line(output))
    return 0


def adopt_spawner(
    client: Client,
    adapter: ClientAdapter,
    identity: Identity,
    session: Json,
    root_sid: str | None,
    payload: Json,
) -> None:
    """Move a subagent under the agent that spawned it: its client records that only
    after SubagentStart returns, so the session first joins under the root."""
    if not root_sid or session.get("parent_sid") != root_sid:
        return
    spawner = adapter.hook_spawn_parent(payload)
    if not spawner:
        return
    parent_sid = session_id_for(identity.client, spawner)
    if parent_sid == root_sid:
        return
    try:
        client.call("reparent", sid=session["sid"], parent_sid=parent_sid)
    except CoordError:
        pass  # an unknown or departed spawner leaves the root in place


def hook_dispatch(
    client: Client,
    adapter: ClientAdapter,
    identity: Identity,
    event: str,
    role: str,
    payload: Json,
) -> Json | None:
    sid = session_id_for(identity.client, str(identity.native_id))
    turn_id = payload.get("turn_id")
    turn_id = str(turn_id) if turn_id else None
    if role == "end":
        try:
            client.call("attach", sid=sid, native_id=identity.native_id)
        except CoordError as error:
            # Claude Code repeats SubagentStop with a fresh agent_id while a subagent is
            # still running; a stop for a session nobody joined must record nothing.
            if error.code == -32001 and str(error).startswith("unknown session"):
                return adapter.hook_silence(event)
    parent_native = adapter.hook_parent_native(payload)
    parent_sid = None
    if parent_native:
        parent_identity = Identity(identity.client, parent_native, identity.cwd)
        parent_sid = session_id_for(identity.client, parent_native)
        ensure_session(client, parent_identity)
    if role == "start":
        joined = ensure_session(client, identity, parent_sid=parent_sid)
        if adapter.name == "codex":
            compact = event == "SessionStart" and payload.get("source") == "compact"
            client.call(
                "activity",
                sid=sid,
                active=event == "SubagentStart" or compact,
                turn_id=turn_id,
            )
            if compact:
                nudge = client.call("nudge", sid=sid)
                if nudge.get("text"):
                    joined = {**joined, "compact_nudge": nudge["text"]}
        context = joined_text(joined, sid)
        if joined.get("compact_nudge"):
            context += "\n" + joined["compact_nudge"]
        return adapter.hook_context(
            event,
            context,
        )
    if role == "start-or-nudge":
        try:
            client.call("attach", sid=sid, native_id=identity.native_id)
        except CoordError as error:
            if error.code != -32001:
                raise
            return adapter.hook_context(
                event,
                joined_text(
                    ensure_session(client, identity, parent_sid=parent_sid), sid
                ),
            )
        nudge = client.call("nudge", sid=sid)
        return (
            adapter.hook_context(event, nudge["text"])
            if nudge.get("text")
            else adapter.hook_silence(event)
        )
    current = ensure_session(
        client, identity, parent_sid=parent_sid, claim_parent=False
    )
    adopt_spawner(client, adapter, identity, current["session"], parent_sid, payload)
    if event == "Stop":
        stopped = client.call(
            "stop_nudge",
            sid=sid,
            stop_hook_active=payload.get("stop_hook_active"),
            turn_id=turn_id,
        )
        if stopped.get("text"):
            return adapter.hook_continue(event, stopped["text"])
        if adapter.name == "codex":
            client.call("activity", sid=sid, active=False, turn_id=turn_id)
        return adapter.hook_silence(event)
    if role == "end":
        client.call("update", sid=sid, status="done")
        client.call("leave", sid=sid)
        return adapter.hook_silence(event)
    if role == "idle":
        client.call(
            "activity",
            sid=sid,
            active=False,
            turn_id=turn_id,
            interrupted=event == "Interrupt",
        )
        return adapter.hook_silence(event)
    auto_wake = (
        adapter.name == "codex"
        and event == "UserPromptSubmit"
        and isinstance(payload.get("prompt"), str)
        and bool(
            WAKE_RE.fullmatch(payload["prompt"])
            or LEGACY_WAKE_RE.fullmatch(payload["prompt"])
        )
    )
    if adapter.name == "codex" and not auto_wake:
        client.call("activity", sid=sid, active=True, turn_id=turn_id)
    nudge = client.call(
        "nudge",
        sid=sid,
        wake_prompt=payload.get("prompt")
        if adapter.name == "codex" and event == "UserPromptSubmit"
        else None,
        activate_turn=auto_wake,
        turn_id=turn_id,
    )
    return (
        adapter.hook_context(event, nudge["text"])
        if nudge.get("text")
        else adapter.hook_silence(event)
    )


def joined_text(joined: Json, sid: str) -> str:
    session = joined["session"]
    peers = ", ".join(p["name"] for p in joined.get("peers_same_project", [])) or "none"
    parent = f" Parent: {session['parent_sid']}." if session.get("parent_sid") else ""
    child_note = (
        f" Your agent_coord calls act as parent {session['parent_sid']} unless you pass"
        f' --as {sid} (CLI) or as="{sid}" (MCP); message your parent or sibling'
        " subagents with SendMessage, not agent_coord."
        if session.get("parent_sid") and session["client"] == "claude-code"
        else ""
    )
    return (
        f"[agent-coord] joined as {sid} ({session['name']}). Same-project peers: {peers}."
        f"{parent} Unread: {joined.get('unread', 0)}."
        " Tools: mcp agent_coord (send/catchup/acquire) or `agent_coord` CLI."
        f"{child_note}"
    )


# ---------------------------------------------------------------- rendering


def table(rows: list[list[str]], header: list[str]) -> str:
    widths = [max(len(str(r[i])) for r in [header, *rows]) for i in range(len(header))]

    def line(cells: list[str]) -> str:
        return "  ".join(str(c).ljust(widths[i]) for i, c in enumerate(cells)).rstrip()

    return "\n".join(
        [line(header), line(["-" * w for w in widths]), *[line(r) for r in rows]]
    )


def render_event(event: Json) -> str:
    body = event["body"]
    who = body.get("from_name") or event["actor"] or "?"
    scope = event["scope_kind"] + (
        f":{event['scope_key']}" if event["scope_kind"] != "all" else ""
    )
    flag = " (backfill)" if event.get("backfill") else ""
    if event.get("sender_offline"):
        flag += " (sender offline; no reply expected)"
    head = f"#{event['seq']} {fmt_time(event['ts'])} [{event['kind']}]{flag} {who} -> {scope}"
    if event["kind"] == "message":
        return f"{head}\n    {body.get('text', '')}"
    if event["kind"] == "request_open":
        return f"{head} {body.get('req_id', '')}: {body.get('subject', '')}\n    {body.get('text', '')}".rstrip()
    detail = {
        k: v for k, v in body.items() if k != "from_name" and v not in (None, "", False)
    }
    return f"{head} {json.dumps(detail, ensure_ascii=False)}"


def render_catchup(result: Json) -> str:
    events = result["events"]
    lines = [render_event(e) for e in events] or [
        f"No unread events (cursor {result['cursor']})."
    ]
    if result.get("gap"):
        gap = result["gap"]
        lines.insert(
            0,
            f"-- events up to seq {gap['through']} were dropped ({gap['reason']}); check status for the current state",
        )
    if events:
        more = " (more pending)" if result["more"] else ""
        lines.append(
            f"-- {len(events)} event(s){more}. Ack with ack(through={result['last_seq']}) or catchup(ack_through={result['last_seq']})."
        )
    return "\n".join(lines)


def render_wait(result: Json) -> str:
    events = result["events"]
    if not events:
        return (
            f"No new events within {result['timeout']:g}s"
            f" (after seq {result['baseline']})."
        )
    trailer = (
        f"-- {len(events)} new event(s). Ack with ack(through={result['last_seq']})."
    )
    return "\n".join([render_event(e) for e in events] + [trailer])


def render_identity(result: Json) -> str:
    s = result["session"]
    held = [f"{r['key']}@{r['owner']}" for r in result["resources_held"]]
    children = [
        p["sid"]
        for p in result["peers_same_project"]
        if p.get("parent_sid") == s["sid"]
    ]
    return (
        f"{s['sid']} name={s['name']} client={s['client']} project={s['project']}\n"
        f"parent={s.get('parent_sid') or '-'} children={', '.join(children) or '-'}\n"
        f"repo_top={s['repo_top']} checkout={s['checkout']} branch={s['branch']}\n"
        f"peers in project: {', '.join(p['name'] for p in result['peers_same_project']) or 'none'} ({result['peers_total']} total)\n"
        f"held on host: {held} open requests: {len(result['open_requests'])} unread: {result['unread']}"
    )


def render_sessions(sessions: list[Json]) -> str:
    if not sessions:
        return "No sessions."
    rows = [
        [
            s["sid"],
            s["name"] or "-",
            s["client"] or "-",
            s["status"] or "-",
            s.get("parent_sid") or "-",
            (s["task"] or "-")[:40],
            s["project"] or "-",
            os.path.basename(s["checkout"] or s["cwd"] or "-")
            + (f"@{s['branch']}" if s.get("branch") else ""),
            f"{s.get('connections', '?')}c",
            s["updated_ago"],
            s["seen_ago"],
            s["capabilities"]["notify"],
            " ".join(f"{n} {state}" for state, n in s.get("deliveries", {}).items())
            or "0",
        ]
        for s in sessions
    ]
    header = [
        "sid",
        "name",
        "client",
        "status",
        "parent",
        "task",
        "project",
        "checkout",
        "conn",
        "reported",
        "seen",
        "notify",
        "unread",
    ]
    return table(rows, header)


def render_status(status: Json) -> str:
    service = status["service"]
    parts = [
        f"agent_coord {service['version']} pid {service['pid']} up since {fmt_time(service['started_at'])};"
        f" {service['events']} events ({service['retained']} retained), {service['connections']} live connection(s); home {service['home']}",
        "",
        "Sessions ('reported' = age of the last self-report, 'seen' = age of the last call observed; notify push = idle sessions get woken, pull = hooks only)",
        render_sessions(status["sessions"]),
    ]
    if status["resources"] or status["waiters"]:
        waiting: dict[str, list[str]] = {}
        for w in status["waiters"]:
            waiting.setdefault(w["key"], []).append(w["sid"])
        rows = [
            [
                r["key"],
                r["owner"] or "-",
                r["purpose"] or "-",
                fmt_time(r["acquired_at"]),
                r["state"] or "-",
                str(r["generation"]),
                ", ".join(waiting.get(r["key"], [])) or "-",
                r["pending_to"] or "-",
            ]
            for r in status["resources"]
        ]
        for key, sids in waiting.items():
            if not any(r["key"] == key for r in status["resources"]):
                rows.append([key, "-", "-", "-", "free", "-", ", ".join(sids), "-"])
        parts += [
            "",
            "Resources",
            table(
                rows,
                [
                    "key",
                    "owner",
                    "purpose",
                    "since",
                    "state",
                    "gen",
                    "waiting",
                    "pending_to",
                ],
            ),
        ]
    if status["requests"]:
        parts += [
            "",
            "Open requests",
            table(
                [
                    [
                        r["req_id"],
                        r["sender"],
                        f"{r['scope_kind']}:{r['scope_key']}"[:40],
                        r["subject"][:40],
                        fmt_time(r["created_at"]),
                    ]
                    for r in status["requests"]
                ],
                ["id", "from", "to", "subject", "opened"],
            ),
        ]
    return "\n".join(parts)


def render_tool(name: str, result: Json) -> str:
    renderers: dict[str, Callable[[Json], str]] = {
        "catchup": render_catchup,
        "wait": render_wait,
        "history": lambda r: (
            "\n".join(render_event(e) for e in r["events"]) or "No events."
        ),
        "status": render_status,
        "sessions": lambda r: render_sessions(r["sessions"]),
        "join": render_identity,
        "whoami": render_identity,
    }
    return renderers.get(name, pretty)(result)


# ---------------------------------------------------------------- CLI


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--as",
        dest="sid",
        default=argparse.SUPPRESS,
        help="act as this session id (needs AGENT_COORD_TOKEN or the matching native id)",
    )
    common.add_argument(
        "--json",
        action="store_true",
        default=argparse.SUPPRESS,
        help="machine-readable output",
    )
    common.add_argument(
        "--no-autostart",
        action="store_true",
        default=argparse.SUPPRESS,
        help="fail instead of starting the daemon",
    )
    parser = argparse.ArgumentParser(
        prog="agent_coord",
        description="Coordinate agent sessions on this host.",
        parents=[common],
    )
    top = parser.add_subparsers(dest="command", required=True)

    def sub(name: str, **kw: Any) -> argparse.ArgumentParser:
        return top.add_parser(name, parents=[common], **kw)

    p = sub("serve", help="run the coordinator daemon")
    p.add_argument("--daemon", action="store_true", help="detach into the background")
    sub("stop", help="stop the daemon (ledger is kept)")
    sub(
        "doctor",
        help="diagnose the connect / session / notify / sandbox lanes",
    )
    p = sub("mcp", help="stdio MCP adapter")
    p.add_argument("--client", choices=sorted(ADAPTERS))
    p = sub("hook", help="hook entry: agent_coord hook --client <name> <event>")
    p.add_argument("--client", required=True, choices=sorted(ADAPTERS))
    p.add_argument("event")
    p = sub("join", help="register this session")
    p.add_argument("--name")
    p.add_argument("--task")
    p.add_argument("--cwd")
    sub("whoami")
    sub("leave")
    p = sub("update")
    p.add_argument("--name")
    p.add_argument("--task")
    p.add_argument("--status", choices=STATUSES)
    p.add_argument("--cwd")
    p = sub("sessions")
    p.add_argument("--scope", choices=["all", "project", "repo"], default="all")
    p = sub("send")
    p.add_argument("text")
    p.add_argument("--to", default="project")
    p.add_argument("--request-id")
    p = sub("catchup")
    p.add_argument("--limit", type=int, default=20)
    p.add_argument("--ack-through", type=int)
    p = sub("ack")
    p.add_argument("through", type=int)
    sub("peek")
    p = sub("wait", help="block until an event newer than the ones already seen")
    p.add_argument("--timeout", type=float, default=WAIT_DEFAULT, metavar="SECONDS")
    p.add_argument("--after", type=int, metavar="SEQ")
    sub("nudge")
    p = sub("history")
    p.add_argument("--since", type=int, default=0)
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--all", action="store_true")
    p = sub("request")
    p.add_argument("subject")
    p.add_argument("--to", default="project")
    p.add_argument("--body")
    p.add_argument("--resource")
    p.add_argument("--request-id")
    p = sub("resolve")
    p.add_argument("req_id")
    p.add_argument("--result")
    p = sub("cancel")
    p.add_argument("req_id")
    p = sub("requests")
    p.add_argument("--all", action="store_true")
    p = sub("acquire")
    p.add_argument("key")
    p.add_argument("--purpose")
    p.add_argument("--request-id")
    p = sub("release")
    p.add_argument("key")
    p.add_argument("generation", type=int)
    p.add_argument("--request-id")
    p = sub("declare")
    p.add_argument("key")
    p.add_argument("--purpose")
    p = sub("transfer", help="propose handing a resource grant to another session")
    p.add_argument("key")
    p.add_argument("to")
    p.add_argument("--note")
    p = sub("accept", help="accept a resource grant proposed to you")
    p.add_argument("key")
    p = sub(
        "force-release", help="user override for an unreachable owner; reason required"
    )
    p.add_argument("key")
    p.add_argument("--reason", required=True)
    sub("resources")
    sub("status")
    p = sub("watch", help="live status; redraws on every ledger change")
    p.add_argument("--interval", type=float, default=30)
    return parser


def parse_cli(argv: list[str] | None) -> argparse.Namespace:
    args = build_parser().parse_args(argv)
    for key, value in (("sid", None), ("json", False), ("no_autostart", False)):
        vars(args).setdefault(key, value)
    return args


def cli_params(args: argparse.Namespace) -> Json:
    skip = {"sid", "json", "no_autostart", "command", "client"}
    return {
        k: v
        for k, v in vars(args).items()
        if k not in skip and v is not None and v is not False
    }


def daemonize_serve(home: Path) -> int:
    try:
        Client(home / "coord.sock").close()
    except CoordError as error:
        print(
            f"daemon did not come up ({error}); see {home / 'daemon.log'}",
            file=sys.stderr,
        )
        return 1
    print(f"daemon started (home {home})")
    return 0


def doctor(identity: Identity, autostart: bool, out: TextIO = sys.stdout) -> int:
    """Each lane on its own line: connect (CLI/MCP), session, notify, sandbox."""
    lines = [
        f"home: {coord_home()}  socket: {sock_path()}  exists: {sock_path().exists()}"
    ]
    try:
        client = Client(autostart=autostart)
    except CoordError as error:
        lines.append(f"connect: FAILED: {error}")
        out.write("\n".join(lines) + "\n")
        return 1
    pong = client.call("ping")
    mismatch = (
        "" if pong["version"] == VERSION else f" (CLI is {VERSION}: restart the daemon)"
    )
    lines.append(
        f"connect: ok (daemon pid {pong['pid']} version {pong['version']}{mismatch})"
    )
    sid = (
        session_id_for(identity.client, identity.native_id)
        if identity.native_id
        else "-"
    )
    lines.append(
        f"session: client={identity.client} native_id={identity.native_id or '(none: joins as anon)'} sid={sid}"
    )
    if identity.client == "claude-code" and identity.native_id:
        found = ClaudeCodeAdapter().inbox(identity.native_id)
        lines.append(
            f"notify: push via inbox socket {found[0] if found else '(session not in the registry: pull only)'}"
        )
    elif identity.client == "codex":
        lines.append("notify: push via `codex queue --thread`")
    else:
        lines.append(
            f"notify: pull (hooks / polling only) for client {identity.client}"
        )
    sandboxed = os.environ.get("CLAUDE_CODE_SANDBOX") or os.environ.get("SANDBOX")
    lines.append(
        f"sandbox: {'sandboxed shell' if sandboxed else 'host shell'}; socket reached at {sock_path()}"
    )
    client.close()
    out.write("\n".join(lines) + "\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = parse_cli(argv)
    home = coord_home()
    if args.command == "serve":
        return daemonize_serve(home) if args.daemon else serve(home)
    if args.command == "mcp":
        return run_mcp(sys.stdin, sys.stdout, args.client)
    if args.command == "hook":
        return hook_main(args.client, args.event, sys.stdin, sys.stdout)
    identity = identity_from_env()
    if args.command == "doctor":
        return doctor(identity, not args.no_autostart)
    try:
        client = Client(
            autostart=not args.no_autostart
            and args.command not in ("stop", "status", "watch")
        )
    except CoordError as error:
        print(f"agent_coord: {error}", file=sys.stderr)
        return 2
    try:
        if args.command == "stop":
            client.call("shutdown")
            print("stopping")
            return 0
        if args.command == "watch":
            return watch(client, args.interval)
        result = run_command(client, args, identity)
    except CoordError as error:
        print(f"agent_coord: {error}", file=sys.stderr)
        if args.json and error.data:
            print(json.dumps(error.data, ensure_ascii=False))
        return 3 if error.code == -32010 else 1
    finally:
        client.close()
    print(pretty(result) if args.json else render_tool(args.command, result))
    return 0


READ_ONLY = frozenset({"status", "sessions", "history", "requests", "resources"})


def run_command(client: Client, args: argparse.Namespace, identity: Identity) -> Json:
    params = cli_params(args)
    command = args.command
    if command == "join":
        cwd = params.pop("cwd", None)
        return client.call(
            "join",
            client=identity.client,
            native_id=identity.native_id,
            cwd=cwd or identity.cwd,
            **params,
        )
    if command == "force-release":
        return client.call("force_release", user_action=True, **params)
    sid: str | None = None
    if command not in READ_ONLY:
        if args.sid:
            client.call(
                "attach",
                sid=args.sid,
                token=os.environ.get("AGENT_COORD_TOKEN"),
                native_id=identity.native_id,
            )
            sid = args.sid
        else:
            sid = ensure_session(client, identity)["session"]["sid"]
    method = {"transfer": "resource_transfer", "accept": "resource_accept"}.get(
        command, command.replace("-", "_")
    )
    if command == "wait":
        return wait_for_events(client, sid, params["timeout"], params.get("after"))
    return client.call(method, sid=sid, **params)


def watch(client: Client, interval: float) -> int:
    status = Client(autostart=False)
    lines: queue.Queue[str] = queue.Queue()

    def reader() -> None:
        while line := client.file.readline():
            lines.put(line)
        lines.put("")

    def draw() -> None:
        stamp = f"{datetime.now():%H:%M:%S} watching (ctrl-c to stop)"
        sys.stdout.write(
            "\033[2J\033[H" + render_status(status.call("status")) + f"\n\n{stamp}\n"
        )
        sys.stdout.flush()

    client.call("subscribe")
    client.sock.settimeout(None)
    threading.Thread(target=reader, daemon=True).start()
    try:
        draw()
        while True:
            try:
                line = lines.get(timeout=interval)
            except queue.Empty:
                draw()
                continue
            while line and not lines.empty():  # coalesce a burst into one redraw
                line = lines.get_nowait()
            if line == "":
                print("coordinator closed the stream", file=sys.stderr)
                return 1
            draw()
    except KeyboardInterrupt:
        return 0
    finally:
        status.close()


if __name__ == "__main__":
    sys.exit(main())
