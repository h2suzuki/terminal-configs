VERSION = "0.1.0"
MCP_PROTOCOL_VERSION = "2025-11-25"
NOTIFY_KINDS = frozenset(
    {
        "message",
        "request_open",
        "request_resolve",
        "request_cancel",
        "release",
        "force_release",
        "transfer_propose",
