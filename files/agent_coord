)
SCOPE_KINDS = ("all", "project", "repo", "session")
STATUSES = ("working", "waiting", "idle", "blocked", "done", "unset")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
Json = dict[str, Any]


class CoordError(Exception):
    """Error carrying a JSON-RPC style code."""

    def __init__(
        self, message: str, code: int = -32000, data: object = None, keep: bool = False
    ):
        super().__init__(message)
        self.code = code
        self.data = data
        self.keep = (
            keep  # commit side effects recorded before the refusal (e.g. waiter rows)
        )


# ---------------------------------------------------------------- paths


def coord_home() -> Path:
    override = os.environ.get("AGENT_COORD_HOME")
    if override:
        return Path(override).expanduser()
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(state) / "agent_coord"


def sock_path() -> Path:
    return coord_home() / "coord.sock"


def now() -> float:
    return time.time()


def fmt_time(ts: float | None) -> str:
    return datetime.fromtimestamp(ts).strftime("%m-%d %H:%M") if ts else "-"


def fmt_ago(ts: float | None, ref: float | None = None) -> str:
    if not ts:
        return "-"
    delta = int((ref or now()) - ts)
    if delta < 60:
        return f"{delta}s"
    if delta < 3600:
        return f"{delta // 60}m"
    if delta < 86400:
        return f"{delta // 3600}h"
    return f"{delta // 86400}d"


# ---------------------------------------------------------------- git identity


def run_git(args: list[str], cwd: str | None = None) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=cwd,
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return 127, "", str(error)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def normalize_remote(url: str) -> str:
    """Reduce a remote URL to host/path so every clone of a project shares one key."""
    value = url.strip()
    value = re.sub(r"^[a-z+]+://", "", value)
    value = re.sub(r"^[^@/]+@", "", value)
    value = value.replace(":", "/", 1) if "/" not in value.split("/", 1)[0] else value
    value = re.sub(r"\.git/?$", "", value).rstrip("/")
    host, _, path = value.partition("/")
    return f"{host.lower()}/{path}"


def git_identity(cwd: str) -> Json:
    """Describe where cwd sits: repo (common dir), checkout, branch, project key."""
    identity: Json = {
        "cwd": cwd,
        "common_dir": None,
        "repo_top": None,
        "checkout": None,
        "branch": None,
        "project": f"dir:{cwd}",
    }
    if not os.path.isdir(cwd):
        return identity
    code, common, _ = run_git(
        ["rev-parse", "--path-format=absolute", "--git-common-dir"], cwd
    )
    if code != 0 or not common:
        return identity
    common_dir = os.path.realpath(common)
    identity["common_dir"] = common_dir
    identity["repo_top"] = (
        os.path.dirname(common_dir)
        if os.path.basename(common_dir) == ".git"
        else common_dir
    )
    code, top, _ = run_git(["rev-parse", "--show-toplevel"], cwd)
    identity["checkout"] = os.path.realpath(top) if code == 0 and top else None
    code, branch, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"], cwd)
    identity["branch"] = branch if code == 0 and branch else None
    code, remote, _ = run_git(["remote", "get-url", "origin"], cwd)
    identity["project"] = (
        normalize_remote(remote)
        if code == 0 and remote
        else f"local:{identity['repo_top']}"
    )
    return identity


def list_worktrees(common_dir: str) -> list[Json]:
    code, out, err = run_git(["-C", common_dir, "worktree", "list", "--porcelain"])
    if code != 0:
        raise CoordError(f"git worktree list failed: {err or code}")
    items: list[Json] = []
    current: Json = {}
    for line in out.splitlines() + [""]:
        if not line:
            if current:
                items.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            current = {"path": os.path.realpath(value), "branch": None, "head": None}
        elif key == "HEAD":
            current["head"] = value[:12]
        elif key == "branch":
            current["branch"] = value.removeprefix("refs/heads/")
        elif key in ("bare", "detached", "locked", "prunable"):
            current[key] = value or True
    return items


def path_within(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


# ---------------------------------------------------------------- store

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions(
  sid TEXT PRIMARY KEY, client TEXT, native_id TEXT, name TEXT, task TEXT, status TEXT,
  cwd TEXT, common_dir TEXT, repo_top TEXT, checkout TEXT, branch TEXT, project TEXT,
  edit_worktree TEXT, model TEXT, token TEXT, joined_at REAL, updated_at REAL,
  last_seen REAL, left_at REAL, cursor INTEGER NOT NULL DEFAULT 0,
  notified INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS events(
  seq INTEGER PRIMARY KEY AUTOINCREMENT, ts REAL, kind TEXT, actor TEXT,
  scope_kind TEXT, scope_key TEXT, body TEXT);
CREATE TABLE IF NOT EXISTS resources(
  key TEXT PRIMARY KEY, owner TEXT, purpose TEXT, generation INTEGER NOT NULL DEFAULT 0,
  acquired_at REAL, state TEXT);
CREATE TABLE IF NOT EXISTS waiters(key TEXT, sid TEXT, PRIMARY KEY(key, sid));
CREATE TABLE IF NOT EXISTS worktrees(
  path TEXT PRIMARY KEY, common_dir TEXT, owner TEXT, generation INTEGER NOT NULL DEFAULT 0,
  enforce INTEGER NOT NULL DEFAULT 0, claimed_at REAL, pending_to TEXT, pending_at REAL);
CREATE TABLE IF NOT EXISTS requests(
  req_id TEXT PRIMARY KEY, seq INTEGER, sender TEXT, scope_kind TEXT, scope_key TEXT,
  subject TEXT, body TEXT, state TEXT, result TEXT, resolved_by TEXT, resolved_at REAL,
  created_at REAL);
CREATE TABLE IF NOT EXISTS idempotency(key TEXT PRIMARY KEY, response TEXT, ts REAL);
"""


def row_dict(row: sqlite3.Row | None) -> Json | None:
    return dict(row) if row is not None else None


class Store:
    """Authoritative ledger; every public method runs under one lock and one transaction."""

    def __init__(self, path: Path):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(
            str(path), check_same_thread=False, isolation_level=None
        )
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.execute("PRAGMA synchronous=NORMAL")
        self.db.executescript(SCHEMA)
        self.lock = threading.RLock()
        self.connections: dict[int, str] = {}
        self.listeners: list[queue.Queue[Json]] = []
        self.started_at = now()

    # -- transaction helpers
    def transact(self, fn: Any, *args: Any) -> Any:
        with self.lock:
            self.db.execute("BEGIN IMMEDIATE")
            try:
                result = fn(*args)
            except CoordError as error:
                self.db.execute("COMMIT" if error.keep else "ROLLBACK")
                raise
            except BaseException:
                self.db.execute("ROLLBACK")
                raise
            self.db.execute("COMMIT")
        return result

    def emit(self, event: Json) -> None:
        with self.lock:
            listeners = list(self.listeners)
        for listener in listeners:
            listener.put(event)

    def append_event(
        self, kind: str, actor: str | None, scope: tuple[str, str], body: Json
    ) -> Json:
        cursor = self.db.execute(
            "INSERT INTO events(ts, kind, actor, scope_kind, scope_key, body) VALUES(?,?,?,?,?,?)",
            (
                now(),
                kind,
                actor,
                scope[0],
                scope[1],
                json.dumps(body, ensure_ascii=False),
            ),
        )
        return cast(Json, self.event(cast(int, cursor.lastrowid)))

    def event(self, seq: int) -> Json | None:
        row = row_dict(
            self.db.execute("SELECT * FROM events WHERE seq=?", (seq,)).fetchone()
        )
        if row:
            row["body"] = json.loads(row["body"])
        return row

    def max_seq(self) -> int:
        return self.db.execute("SELECT COALESCE(MAX(seq),0) FROM events").fetchone()[0]

    def session(self, sid: str) -> Json | None:
        return row_dict(
            self.db.execute("SELECT * FROM sessions WHERE sid=?", (sid,)).fetchone()
        )

    def require_session(self, sid: str | None) -> Json:
        if not sid:
            raise CoordError(
                "session id required (join first, or pass --as <sid>)", -32602
            )
        session = self.session(sid)
        if session is None:
            raise CoordError(f"unknown session {sid}: join first", -32001)
        if session["left_at"]:
            raise CoordError(
                f"session {sid} has left; join again to participate", -32001
            )
        self.db.execute("UPDATE sessions SET last_seen=? WHERE sid=?", (now(), sid))
        return session

    def resolve_sid(self, ref: str) -> str:
        if self.session(ref):
            return ref
        rows = self.db.execute(
            "SELECT sid FROM sessions WHERE name=? AND left_at IS NULL", (ref,)
        ).fetchall()
        if len(rows) == 1:
            return rows[0]["sid"]
        if not rows:
            raise CoordError(f"no session named or identified by {ref!r}", -32602)
        raise CoordError(
            f"name {ref!r} is ambiguous: " + ", ".join(r["sid"] for r in rows), -32602
        )

    def scope_for(self, session: Json, to: str | None) -> tuple[str, str]:
        target = (to or "project").strip()
        if target == "all":
            return ("all", "")
        if target in ("project", "repo"):
            key = session["project"] if target == "project" else session["common_dir"]
            if not key:
                raise CoordError(
                    f"this session is not inside a git repo; scope {target} unavailable"
                )
            return (target, key)
        kind, sep, key = target.partition(":")
        if sep and kind in ("project", "repo"):
            return (kind, key)
        if sep and kind == "session":
            return ("session", self.resolve_sid(key))
        if target == "self":
            return ("session", session["sid"])
        return ("session", self.resolve_sid(target))

    def visible(self, event: Json, session: Json) -> bool:
        kind, key = event["scope_kind"], event["scope_key"]
        if kind == "all":
            return True
        if kind == "project":
            return key == session["project"]
        if kind == "repo":
            return key == session["common_dir"]
        return kind == "session" and key == session["sid"]

    def unread_for(
        self, session: Json, limit: int | None = None
    ) -> tuple[list[Json], bool]:
        """Events after the cursor that address this session from someone else."""
        selected: list[Json] = []
        after = session["cursor"]
        while True:
            rows = self.db.execute(
                "SELECT * FROM events WHERE seq>? ORDER BY seq LIMIT 500", (after,)
            ).fetchall()
            if not rows:
                return selected, False
            for row in rows:
                event = dict(row)
                event["body"] = json.loads(event["body"])
                after = event["seq"]
                own = event["actor"] == session["sid"]
                direct = (
                    event["scope_kind"] == "session"
                    and event["scope_key"] == session["sid"]
                )
                if event["kind"] not in NOTIFY_KINDS or (own and not direct):
                    continue
                if not self.visible(event, session):
                    continue
                if limit is not None and len(selected) >= limit:
                    return selected, True
                selected.append(event)

    # -- idempotency
    def replay(self, key: str | None) -> Json | None:
        if not key:
            return None
        row = self.db.execute(
            "SELECT response FROM idempotency WHERE key=?", (key,)
        ).fetchone()
        return json.loads(row["response"]) if row else None

    def remember(self, key: str | None, response: Json) -> Json:
        if key:
            self.db.execute(
                "INSERT INTO idempotency(key, response, ts) VALUES(?,?,?)",
                (key, json.dumps(response, ensure_ascii=False), now()),
            )
        return response

    # -- sessions
    def join(self, p: Json) -> Json:
        sid = p.get("sid") or f"anon-{uuid.uuid4().hex[:8]}"
        identity = git_identity(p.get("cwd") or os.getcwd())
        existing = self.session(sid)
        ts = now()
        name = (
            p.get("name")
            or (existing or {}).get("name")
            or (
                f"{p.get('client') or 'agent'}@{os.path.basename(identity['cwd'].rstrip('/'))}"
            )
        )
        if existing:
            self.db.execute(
                "UPDATE sessions SET client=COALESCE(?,client), native_id=COALESCE(?,native_id),"
                " name=?, cwd=?, common_dir=?, repo_top=?, checkout=?, branch=?, project=?,"
                " model=COALESCE(?,model), task=COALESCE(?,task), updated_at=?, last_seen=?,"
                " left_at=NULL WHERE sid=?",
                (
                    p.get("client"),
                    p.get("native_id"),
                    name,
                    identity["cwd"],
                    identity["common_dir"],
                    identity["repo_top"],
                    identity["checkout"],
                    identity["branch"],
                    identity["project"],
                    p.get("model"),
                    p.get("task"),
                    ts,
                    ts,
                    sid,
                ),
            )
            if existing["left_at"]:
                self.append_event(
                    "join", sid, ("all", ""), {"name": name, "rejoin": True}
                )
        else:
            token = secrets.token_hex(8)
            self.db.execute(
                "INSERT INTO sessions(sid, client, native_id, name, task, status, cwd, common_dir,"
                " repo_top, checkout, branch, project, model, token, joined_at, updated_at,"
                " last_seen, cursor) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (
                    sid,
                    p.get("client") or "unknown",
                    p.get("native_id"),
                    name,
                    p.get("task"),
                    "unset",
                    identity["cwd"],
                    identity["common_dir"],
                    identity["repo_top"],
                    identity["checkout"],
                    identity["branch"],
                    identity["project"],
                    p.get("model"),
                    token,
                    ts,
                    ts,
                    ts,
                    self.max_seq(),
                ),
            )
            self.append_event(
                "join", sid, ("all", ""), {"name": name, "client": p.get("client")}
            )
        session = cast(Json, self.session(sid))
        return {
            "session": public_session(session),
            "token": session["token"],
            **self.snapshot(session),
        }

    def snapshot(self, session: Json) -> Json:
        """Current state a newcomer needs: peers, held resources, open requests, unread count."""
        unread, _ = self.unread_for(session)
        peers = [
            public_session(dict(r))
            for r in self.db.execute(
                "SELECT * FROM sessions WHERE left_at IS NULL AND sid!=? ORDER BY updated_at DESC",
                (session["sid"],),
            )
        ]
        return {
            "peers_same_project": [
                p for p in peers if p["project"] == session["project"]
            ],
            "peers_total": len(peers),
            "held_resources": [
                dict(r)
                for r in self.db.execute(
                    "SELECT * FROM resources WHERE owner=?", (session["sid"],)
                )
            ],
            "owned_worktrees": [
                r["path"]
                for r in self.db.execute(
                    "SELECT path FROM worktrees WHERE owner=?", (session["sid"],)
                )
            ],
            "open_requests": self.open_requests(session),
            "unread": len(unread),
        }

    def open_requests(self, session: Json) -> list[Json]:
        result = []
        for row in self.db.execute(
            "SELECT * FROM requests WHERE state='open' ORDER BY seq"
        ):
            req = dict(row)
            if req["sender"] == session["sid"] or self.visible(req, session):
                result.append(req)
        return result

    def update(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        fields: Json = {}
        for key in ("name", "task", "status", "model"):
            if p.get(key) is not None:
                fields[key] = p[key]
        if "status" in fields and fields["status"] not in STATUSES:
            raise CoordError(f"status must be one of {', '.join(STATUSES)}", -32602)
        if p.get("cwd"):
            identity = git_identity(p["cwd"])
            fields.update(
                {
                    k: identity[k]
                    for k in (
                        "cwd",
                        "common_dir",
                        "repo_top",
                        "checkout",
                        "branch",
                        "project",
                    )
                }
            )
        if not fields:
            raise CoordError("nothing to update", -32602)
        fields["updated_at"] = now()
        assignments = ", ".join(f"{k}=?" for k in fields)
        self.db.execute(
            f"UPDATE sessions SET {assignments} WHERE sid=?",
            (*fields.values(), session["sid"]),
        )
        self.append_event(
            "update",
            session["sid"],
            ("all", ""),
            {k: v for k, v in fields.items() if k != "updated_at"},
        )
        return {"session": public_session(cast(Json, self.session(session["sid"])))}

    def leave(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        ts = now()
        self.db.execute(
            "UPDATE sessions SET left_at=?, updated_at=? WHERE sid=?",
            (ts, ts, session["sid"]),
        )
        held = self.db.execute(
            "UPDATE resources SET state='unconfirmed' WHERE owner=? AND state='held'",
            (session["sid"],),
        ).rowcount
        self.append_event(
            "leave",
            session["sid"],
            ("all", ""),
            {"name": session["name"], "unconfirmed_resources": held},
        )
        return {"left": session["sid"], "resources_marked_unconfirmed": held}

    def whoami(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        return {"session": public_session(session), **self.snapshot(session)}

    def sessions(self, p: Json) -> Json:
        me = self.session(p.get("sid") or "")
        scope = p.get("scope") or "all"
        rows = [
            dict(r)
            for r in self.db.execute(
                "SELECT * FROM sessions WHERE left_at IS NULL OR left_at>? ORDER BY updated_at DESC",
                (now() - 3600,),
            )
        ]
        if scope in ("project", "repo"):
            if not me:
                raise CoordError("scope project/repo needs your own session id", -32602)
            key = "project" if scope == "project" else "common_dir"
            rows = [r for r in rows if r[key] == me[key]]
        ts = now()
        return {"sessions": [public_session(r, self.connections, ts) for r in rows]}

    # -- messaging
    def send(self, p: Json) -> Json:
        if replay := self.replay(p.get("request_id")):
            return replay
        session = self.require_session(p.get("sid"))
        text = str(p.get("text") or "").strip()
        if not text:
            raise CoordError("text required", -32602)
        scope = self.scope_for(session, p.get("to"))
        event = self.append_event(
            "message",
            session["sid"],
            scope,
            {"text": text, "from_name": session["name"]},
        )
        return self.remember(
            p.get("request_id"),
            {
                "seq": event["seq"],
                "scope": f"{scope[0]}:{scope[1]}" if scope[1] else scope[0],
            },
        )

    def catchup(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        if p.get("ack_through") is not None:
            self.ack({"sid": session["sid"], "through": p["ack_through"]})
            session = cast(Json, self.session(session["sid"]))
        limit = max(1, min(int(p.get("limit") or 20), 200))
        events, more = self.unread_for(session, limit)
        return {
            "cursor": session["cursor"],
            "events": events,
            "more": more,
            "last_seq": events[-1]["seq"] if events else session["cursor"],
        }

    def ack(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        through = min(int(p.get("through") or 0), self.max_seq())
        cursor = max(session["cursor"], through)
        self.db.execute(
            "UPDATE sessions SET cursor=? WHERE sid=?", (cursor, session["sid"])
        )
        return {"cursor": cursor}

    def peek(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        events, _ = self.unread_for(session)
        return {
            "unread": len(events),
            "first_seq": events[0]["seq"] if events else None,
            "last_seq": events[-1]["seq"] if events else None,
            "cursor": session["cursor"],
            "kinds": sorted({e["kind"] for e in events}),
        }

    def nudge(self, p: Json) -> Json:
        """Once per new unread range: text for a hook to inject, else null."""
        session = self.require_session(p.get("sid"))
        events, _ = self.unread_for(session)
        if not events or events[-1]["seq"] <= session["notified"]:
            return {"text": None, "unread": len(events)}
        self.db.execute(
            "UPDATE sessions SET notified=? WHERE sid=?",
            (events[-1]["seq"], session["sid"]),
        )
        senders = sorted(
            {e["body"].get("from_name") or e["actor"] or "?" for e in events}
        )
        return {
            "text": (
                f"[agent-coord] {len(events)} unread event(s) for this session"
                f" (seq {events[0]['seq']}..{events[-1]['seq']}; from {', '.join(senders)})."
                " Read them with the catchup tool, then ack the last seq."
            ),
            "unread": len(events),
        }

    def history(self, p: Json) -> Json:
        session = self.session(p.get("sid") or "")
        since = int(p.get("since") or 0)
        limit = max(1, min(int(p.get("limit") or 50), 500))
        rows = self.db.execute(
            "SELECT * FROM events WHERE seq>? ORDER BY seq", (since,)
        ).fetchall()
        events = []
        for row in rows:
            event = dict(row)
            event["body"] = json.loads(event["body"])
            if (
                p.get("all")
                or session is None
                or self.visible(event, session)
                or event["actor"] == session["sid"]
            ):
                events.append(event)
        return {"events": events[:limit], "more": len(events) > limit}

    # -- requests
    def request(self, p: Json) -> Json:
        if replay := self.replay(p.get("request_id")):
            return replay
        session = self.require_session(p.get("sid"))
        subject = str(p.get("subject") or "").strip()
        if not subject:
            raise CoordError("subject required", -32602)
        scope = self.scope_for(session, p.get("to"))
        body = {
            "subject": subject,
            "text": p.get("body") or "",
            "from_name": session["name"],
        }
        event = self.append_event("request_open", session["sid"], scope, body)
        req_id = f"R{event['seq']}"
        self.db.execute(
            "INSERT INTO requests(req_id, seq, sender, scope_kind, scope_key, subject, body, state, created_at)"
            " VALUES(?,?,?,?,?,?,?,'open',?)",
            (
                req_id,
                event["seq"],
                session["sid"],
                scope[0],
                scope[1],
                subject,
                body["text"],
                now(),
            ),
        )
        self.db.execute(
            "UPDATE events SET body=? WHERE seq=?",
            (json.dumps({**body, "req_id": req_id}, ensure_ascii=False), event["seq"]),
        )
        if scope[0] == "session" and p.get("resource"):
            self.db.execute(
                "INSERT OR IGNORE INTO waiters(key, sid) VALUES(?,?)",
                (p["resource"], session["sid"]),
            )
        return self.remember(
            p.get("request_id"), {"req_id": req_id, "seq": event["seq"]}
        )

    def _request(self, req_id: str) -> Json:
        row = row_dict(
            self.db.execute(
                "SELECT * FROM requests WHERE req_id=?", (req_id,)
            ).fetchone()
        )
        if row is None:
            raise CoordError(f"unknown request {req_id}", -32602)
        return row

    def resolve(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        req = self._request(str(p.get("req_id")))
        if req["state"] != "open":
            raise CoordError(
                f"request {req['req_id']} is already {req['state']}", -32003
            )
        if req["sender"] != session["sid"] and not self.visible(req, session):
            raise CoordError(
                "only the requester or an addressee can resolve a request", -32003
            )
        result = str(p.get("result") or "").strip() or "resolved"
        self.db.execute(
            "UPDATE requests SET state='resolved', result=?, resolved_by=?, resolved_at=? WHERE req_id=?",
            (result, session["sid"], now(), req["req_id"]),
        )
        self.append_event(
            "request_resolve",
            session["sid"],
            ("session", req["sender"]),
            {
                "req_id": req["req_id"],
                "subject": req["subject"],
                "result": result,
                "from_name": session["name"],
            },
        )
        return {"req_id": req["req_id"], "state": "resolved"}

    def cancel(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        req = self._request(str(p.get("req_id")))
        if req["sender"] != session["sid"]:
            raise CoordError("only the requester can cancel", -32003)
        if req["state"] != "open":
            raise CoordError(
                f"request {req['req_id']} is already {req['state']}", -32003
            )
        self.db.execute(
            "UPDATE requests SET state='cancelled', resolved_by=?, resolved_at=? WHERE req_id=?",
            (session["sid"], now(), req["req_id"]),
        )
        self.append_event(
            "request_cancel",
            session["sid"],
            (req["scope_kind"], req["scope_key"]),
            {
                "req_id": req["req_id"],
                "subject": req["subject"],
                "from_name": session["name"],
            },
        )
        return {"req_id": req["req_id"], "state": "cancelled"}

    def requests(self, p: Json) -> Json:
        session = self.session(p.get("sid") or "")
        if p.get("all") or session is None:
            rows = [
                dict(r)
                for r in self.db.execute(
                    "SELECT * FROM requests WHERE state='open' ORDER BY seq"
                )
            ]
        else:
            rows = self.open_requests(session)
        return {"requests": rows}

    # -- resources
    def acquire(self, p: Json) -> Json:
        if replay := self.replay(p.get("request_id")):
            return replay
        session = self.require_session(p.get("sid"))
        key = str(p.get("key") or "").strip()
        if not key:
            raise CoordError("resource key required", -32602)
        current = row_dict(
            self.db.execute("SELECT * FROM resources WHERE key=?", (key,)).fetchone()
        )
        if current and current["owner"] and current["owner"] != session["sid"]:
            self.db.execute(
                "INSERT OR IGNORE INTO waiters(key, sid) VALUES(?,?)",
                (key, session["sid"]),
            )
            owner = self.session(current["owner"])
            raise CoordError(
                f"resource {key!r} is held by {current['owner']} ({owner['name'] if owner else '?'})"
                f" since {fmt_time(current['acquired_at'])} for: {current['purpose'] or '-'}"
                + (
                    " [state: unconfirmed]" if current["state"] == "unconfirmed" else ""
                ),
                -32010,
                {
                    "owner": current["owner"],
                    "purpose": current["purpose"],
                    "acquired_at": current["acquired_at"],
                    "state": current["state"],
                },
                keep=True,
            )
        generation = (current["generation"] if current else 0) + 1
        self.db.execute(
            "INSERT INTO resources(key, owner, purpose, generation, acquired_at, state) VALUES(?,?,?,?,?,'held')"
            " ON CONFLICT(key) DO UPDATE SET owner=excluded.owner, purpose=excluded.purpose,"
            " generation=excluded.generation, acquired_at=excluded.acquired_at, state='held'",
            (key, session["sid"], p.get("purpose"), generation, now()),
        )
        self.db.execute(
            "DELETE FROM waiters WHERE key=? AND sid=?", (key, session["sid"])
        )
        self.append_event(
            "acquire",
            session["sid"],
            ("all", ""),
            {"key": key, "purpose": p.get("purpose"), "generation": generation},
        )
        return self.remember(
            p.get("request_id"), {"key": key, "generation": generation}
        )

    def release(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        key = str(p.get("key") or "").strip()
        current = row_dict(
            self.db.execute("SELECT * FROM resources WHERE key=?", (key,)).fetchone()
        )
        if not current or not current["owner"]:
            raise CoordError(f"resource {key!r} is not held", -32011)
        if current["owner"] != session["sid"]:
            raise CoordError(
                f"resource {key!r} is held by {current['owner']}, not you", -32011
            )
        if (
            p.get("generation") is not None
            and int(p["generation"]) != current["generation"]
        ):
            raise CoordError(
                f"stale generation {p['generation']} (current {current['generation']})",
                -32011,
            )
        self._do_release(key, session["sid"], session["name"], "release", None)
        return {"key": key, "released_generation": current["generation"]}

    def _do_release(
        self, key: str, actor: str, actor_name: str, kind: str, reason: str | None
    ) -> list[str]:
        """Record the free state once; notify each waiter directly so nobody gets it twice."""
        self.db.execute(
            "UPDATE resources SET owner=NULL, purpose=NULL, acquired_at=NULL, state='free' WHERE key=?",
            (key,),
        )
        waiters = [
            r["sid"]
            for r in self.db.execute("SELECT sid FROM waiters WHERE key=?", (key,))
        ]
        self.db.execute("DELETE FROM waiters WHERE key=?", (key,))
        body = {"key": key, "from_name": actor_name, "reason": reason}
        self.append_event("resource_free", actor, ("all", ""), {**body, "kind": kind})
        for waiter in waiters:
            if waiter != actor:
                self.append_event(
                    kind, actor, ("session", waiter), {**body, "you_waited": True}
                )
        return waiters

    def force_release(self, p: Json) -> Json:
        key = str(p.get("key") or "").strip()
        reason = str(p.get("reason") or "").strip()
        if not reason:
            raise CoordError("a reason is required for force release", -32602)
        current = row_dict(
            self.db.execute("SELECT * FROM resources WHERE key=?", (key,)).fetchone()
        )
        if not current or not current["owner"]:
            raise CoordError(f"resource {key!r} is not held", -32011)
        actor = p.get("sid") or "user"
        self._do_release(key, actor, p.get("name") or actor, "force_release", reason)
        self.append_event(
            "force_release",
            actor,
            ("session", current["owner"]),
            {"key": key, "reason": reason, "previous_owner": True},
        )
        return {"key": key, "previous_owner": current["owner"]}

    def resources(self, p: Json) -> Json:
        return {
            "resources": [
                dict(r) for r in self.db.execute("SELECT * FROM resources ORDER BY key")
            ]
        }

    # -- worktrees
    def _repo_worktrees(self, session: Json) -> list[Json]:
        if not session["common_dir"]:
            raise CoordError("this session is not inside a git repo", -32602)
        registered = {
            r["path"]: dict(r)
            for r in self.db.execute(
                "SELECT * FROM worktrees WHERE common_dir=?", (session["common_dir"],)
            )
        }
        items = list_worktrees(session["common_dir"])
        for item in items:
            item["ownership"] = registered.get(item["path"])
        return items

    def worktree_list(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        return {
            "common_dir": session["common_dir"],
            "worktrees": self._repo_worktrees(session),
        }

    def _verify_member(self, session: Json, path: str) -> str:
        real = os.path.realpath(os.path.expanduser(path))
        members = {w["path"] for w in self._repo_worktrees(session)}
        if real not in members:
            raise CoordError(
                f"{real} is not a worktree of {session['repo_top']}", -32602
            )
        return real

    def worktree_claim(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        path = self._verify_member(
            session, str(p.get("path") or session["checkout"] or "")
        )
        current = row_dict(
            self.db.execute("SELECT * FROM worktrees WHERE path=?", (path,)).fetchone()
        )
        if current and current["owner"] and current["owner"] != session["sid"]:
            owner = self.session(current["owner"])
            raise CoordError(
                f"{path} is owned by {current['owner']} ({owner['name'] if owner else '?'}) since {fmt_time(current['claimed_at'])}",
                -32010,
            )
        generation = (current["generation"] if current else 0) + 1
        enforce = 1 if p.get("enforce") else 0
        self.db.execute(
            "INSERT INTO worktrees(path, common_dir, owner, generation, enforce, claimed_at) VALUES(?,?,?,?,?,?)"
            " ON CONFLICT(path) DO UPDATE SET owner=excluded.owner, generation=excluded.generation,"
            " enforce=excluded.enforce, claimed_at=excluded.claimed_at, pending_to=NULL, pending_at=NULL",
            (path, session["common_dir"], session["sid"], generation, enforce, now()),
        )
        self.db.execute(
            "UPDATE sessions SET edit_worktree=?, updated_at=? WHERE sid=?",
            (path, now(), session["sid"]),
        )
        self.append_event(
            "worktree_claim",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": path, "enforce": bool(enforce)},
        )
        return {"path": path, "generation": generation, "enforce": bool(enforce)}

    def worktree_create(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        name = str(p.get("name") or "")
        if not NAME_RE.match(name):
            raise CoordError(
                "worktree name must match [A-Za-z0-9][A-Za-z0-9._-]*", -32602
            )
        repo_top = session["repo_top"]
        if not repo_top:
            raise CoordError("this session is not inside a git repo", -32602)
        root = Path(
            p.get("root") or os.path.expanduser("~/worktrees")
        ) / os.path.basename(repo_top)
        target = str(root / name)
        if os.path.exists(target):
            other = git_identity(target)
            if other["common_dir"] != session["common_dir"]:
                raise CoordError(
                    f"{target} exists and belongs to another repo ({other['repo_top'] or 'not git'})",
                    -32012,
                )
            return {
                **self.worktree_claim(
                    {"sid": session["sid"], "path": target, "enforce": p.get("enforce")}
                ),
                "created": False,
                "resumed": True,
            }
        base = str(p.get("base") or "HEAD")
        code, base_sha, err = run_git(
            ["-C", repo_top, "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"]
        )
        if code != 0:
            raise CoordError(
                f"base {base!r} is not a local commit in {repo_top}: {err or 'unknown ref'}",
                -32602,
            )
        code, _, _ = run_git(
            ["-C", repo_top, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}"]
        )
        args = ["-C", repo_top, "worktree", "add", target] + (
            [name] if code == 0 else ["-b", name, base_sha]
        )
        root.mkdir(parents=True, exist_ok=True)
        code, out, err = run_git(args)
        if code != 0:
            raise CoordError(
                f"git worktree add failed (rc={code}): {err or out}. Nothing was deleted; inspect {target} and branch {name}",
                -32012,
            )
        self.append_event(
            "worktree_create",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": target, "branch": name, "base": base_sha[:12]},
        )
        return {
            **self.worktree_claim(
                {"sid": session["sid"], "path": target, "enforce": p.get("enforce")}
            ),
            "created": True,
            "branch": name,
            "base": base_sha[:12],
        }

    def _owned(self, session: Json, path: str) -> Json:
        current = row_dict(
            self.db.execute("SELECT * FROM worktrees WHERE path=?", (path,)).fetchone()
        )
        if not current or current["owner"] != session["sid"]:
            raise CoordError(f"{path} is not owned by {session['sid']}", -32011)
        return current

    def worktree_release(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        path = os.path.realpath(
            os.path.expanduser(str(p.get("path") or session["edit_worktree"] or ""))
        )
        self._owned(session, path)
        self.db.execute(
            "UPDATE worktrees SET owner=NULL, pending_to=NULL, pending_at=NULL WHERE path=?",
            (path,),
        )
        self.db.execute(
            "UPDATE sessions SET edit_worktree=NULL WHERE sid=? AND edit_worktree=?",
            (session["sid"], path),
        )
        self.append_event(
            "worktree_release",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": path},
        )
        return {"path": path, "owner": None}

    def worktree_transfer(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        path = os.path.realpath(
            os.path.expanduser(str(p.get("path") or session["edit_worktree"] or ""))
        )
        self._owned(session, path)
        to = self.resolve_sid(str(p.get("to") or ""))
        if to == session["sid"]:
            raise CoordError("cannot transfer to yourself", -32602)
        self.db.execute(
            "UPDATE worktrees SET pending_to=?, pending_at=? WHERE path=?",
            (to, now(), path),
        )
        self.append_event(
            "transfer_propose",
            session["sid"],
            ("session", to),
            {"path": path, "from_name": session["name"], "note": p.get("note")},
        )
        return {"path": path, "pending_to": to}

    def worktree_accept(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        path = os.path.realpath(os.path.expanduser(str(p.get("path") or "")))
        current = row_dict(
            self.db.execute("SELECT * FROM worktrees WHERE path=?", (path,)).fetchone()
        )
        if not current or current["pending_to"] != session["sid"]:
            raise CoordError(
                f"no transfer of {path} is pending for {session['sid']}", -32011
            )
        previous = current["owner"]
        self.db.execute(
            "UPDATE worktrees SET owner=?, generation=generation+1, claimed_at=?, pending_to=NULL, pending_at=NULL WHERE path=?",
            (session["sid"], now(), path),
        )
        self.db.execute(
            "UPDATE sessions SET edit_worktree=NULL WHERE sid=? AND edit_worktree=?",
            (previous, path),
        )
        self.db.execute(
            "UPDATE sessions SET edit_worktree=?, updated_at=? WHERE sid=?",
            (path, now(), session["sid"]),
        )
        self.append_event(
            "transfer_accept",
            session["sid"],
            ("session", previous),
            {"path": path, "from_name": session["name"]},
        )
        return {"path": path, "owner": session["sid"], "previous_owner": previous}

    def worktree_force_release(self, p: Json) -> Json:
        path = os.path.realpath(os.path.expanduser(str(p.get("path") or "")))
        reason = str(p.get("reason") or "").strip()
        if not reason:
            raise CoordError("a reason is required for force release", -32602)
        current = row_dict(
            self.db.execute("SELECT * FROM worktrees WHERE path=?", (path,)).fetchone()
        )
        if not current or not current["owner"]:
            raise CoordError(f"{path} has no owner", -32011)
        self.db.execute(
            "UPDATE worktrees SET owner=NULL, pending_to=NULL, pending_at=NULL WHERE path=?",
            (path,),
        )
        self.db.execute(
            "UPDATE sessions SET edit_worktree=NULL WHERE edit_worktree=?", (path,)
        )
        actor = p.get("sid") or "user"
        self.append_event(
            "worktree_force_release",
            actor,
            ("session", current["owner"]),
            {"path": path, "reason": reason},
        )
        return {"path": path, "previous_owner": current["owner"]}

    def edit_check(self, p: Json) -> Json:
        """Deny edits that land in another checkout of the repo the session claimed with enforce."""
        session = self.session(p.get("sid") or "")
        target = os.path.realpath(os.path.expanduser(str(p.get("path") or "")))
        if not session or not session["edit_worktree"]:
            return {"allow": True, "reason": "no enforced worktree"}
        claim = row_dict(
            self.db.execute(
                "SELECT * FROM worktrees WHERE path=?", (session["edit_worktree"],)
            ).fetchone()
        )
        if not claim or claim["owner"] != session["sid"] or not claim["enforce"]:
            return {"allow": True, "reason": "claim inactive or not enforced"}
        if path_within(target, claim["path"]):
            return {"allow": True, "reason": "inside own worktree"}
        for item in list_worktrees(claim["common_dir"]):
            if path_within(target, item["path"]):
                return {
                    "allow": False,
                    "reason": f"{target} is inside {item['path']}, not your worktree {claim['path']}",
                }
        return {"allow": True, "reason": "outside the repo"}

    # -- overview
    def status(self, p: Json) -> Json:
        ts = now()
        sessions = [
            public_session(dict(r), self.connections, ts)
            for r in self.db.execute(
                "SELECT * FROM sessions WHERE left_at IS NULL OR left_at>? ORDER BY project, updated_at DESC",
                (ts - 3600,),
            )
        ]
        for item in sessions:
            unread, _ = self.unread_for(cast(Json, self.session(item["sid"])))
            item["unread"] = len(unread)
        return {
            "service": {
                "version": VERSION,
                "pid": os.getpid(),
                "started_at": self.started_at,
                "home": str(coord_home()),
                "events": self.max_seq(),
                "connections": len(self.connections),
            },
            "sessions": sessions,
            "resources": [
                dict(r)
                for r in self.db.execute(
                    "SELECT * FROM resources WHERE owner IS NOT NULL ORDER BY key"
                )
            ],
            "worktrees": [
                dict(r)
                for r in self.db.execute(
                    "SELECT * FROM worktrees WHERE owner IS NOT NULL OR pending_to IS NOT NULL ORDER BY path"
                )
            ],
            "requests": [
                dict(r)
                for r in self.db.execute(
                    "SELECT * FROM requests WHERE state='open' ORDER BY seq"
                )
            ],
        }


def public_session(
    row: Json, connections: dict[int, str] | None = None, ts: float | None = None
) -> Json:
    keys = (
        "sid",
        "client",
        "native_id",
        "name",
        "task",
        "status",
        "cwd",
        "repo_top",
        "common_dir",
        "checkout",
        "branch",
        "project",
        "edit_worktree",
        "model",
        "joined_at",
        "updated_at",
        "last_seen",
        "left_at",
        "cursor",
    )
    result = {k: row.get(k) for k in keys}
    if connections is not None:
        result["connections"] = sum(1 for s in connections.values() if s == row["sid"])
    result["updated_ago"] = fmt_ago(row.get("updated_at"), ts)
    result["seen_ago"] = fmt_ago(row.get("last_seen"), ts)
    return result


