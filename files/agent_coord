def meta_spawn_parent(meta: Path) -> str | None:
    """The spawning agent id from a Claude Code agent meta file, if it is there yet."""
    try:
        record = json.loads(meta.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    parent = record.get("parentAgentId") if isinstance(record, dict) else None
    return str(parent) if parent else None


class ClientAdapter:
    """What differs per agent CLI; everything else is shared. Base = plain CLI / unknown."""

    name = "cli"
    notify = "pull"  # push: a wake channel exists; pull: hooks / polling only

    def identity_from_env(self, env: dict[str, str]) -> Identity | None:
        return None

    def wake(self, session: Json, text: str) -> bool:
        return False

    def hook_native(self, payload: Json) -> str | None:
        return payload.get("session_id")

    def hook_parent_native(self, payload: Json) -> str | None:
        return None

    def hook_spawn_parent(self, payload: Json) -> str | None:
        """The agent that spawned this subagent, when the client records it separately."""
        return None

    def hook_cwd(self, payload: Json) -> str | None:
        return payload.get("cwd")

    def hook_context(self, event: str, text: str) -> Json:
        return {
            "hookSpecificOutput": {"hookEventName": event, "additionalContext": text}
        }

    def hook_continue(self, event: str, reason: str) -> Json:
        return {"decision": "block", "reason": reason}

    def hook_silence(self, event: str) -> Json | None:
        return None

    def hook_role(self, event: str) -> str:
        return {"SessionStart": "start", "SessionEnd": "end"}.get(event, "nudge")


class ClaudeCodeAdapter(ClientAdapter):
    name = "claude-code"
    notify = "push"

    def identity_from_env(self, env: dict[str, str]) -> Identity | None:
        if not (env.get("CLAUDECODE") or env.get("CLAUDE_CODE_SESSION_ID")):
            return None
        return Identity(
            self.name,
            env.get("CLAUDE_CODE_SESSION_ID") or None,
            env.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
        )

    @staticmethod
    def registry_dir() -> Path:
        return Path(
            os.environ.get("AGENT_COORD_CLAUDE_REGISTRY")
            or os.path.expanduser("~/.claude/sessions")
        )

    def hook_native(self, payload: Json) -> str | None:
        # Subagent hooks carry the child in agent_id and the parent in session_id;
        # ordinary hooks carry only session_id, naming the current session.
        return payload.get("agent_id") or super().hook_native(payload)

    def hook_parent_native(self, payload: Json) -> str | None:
        child = self.hook_native(payload)
        parent = payload.get("session_id")
        return str(parent) if parent and str(parent) != str(child) else None

    def hook_spawn_parent(self, payload: Json) -> str | None:
        """The spawning agent, from Claude Code's undocumented meta file beside the agent
        transcript (anthropics/claude-code#90256); written after SubagentStart returns."""
        agent = payload.get("agent_id")
        agent_transcript = payload.get("agent_transcript_path")
        transcript = payload.get("transcript_path")
        if agent_transcript:
            # Exactly where the file is written, per-agent subdirectory included.
            meta = Path(str(agent_transcript)).with_suffix(".meta.json")
        elif agent and transcript:
            meta = (
                Path(str(transcript)).with_suffix("")
                / "subagents"
                / f"agent-{agent}.meta.json"
            )
        else:
            return None
        return meta_spawn_parent(meta)

    def hook_role(self, event: str) -> str:
        return {
            "SessionStart": "start",
            "SubagentStart": "start",
            "SessionEnd": "end",
            "SubagentStop": "end",
        }.get(event, "nudge")

    def inbox(self, native_id: str) -> tuple[str, str | None] | None:
        """The session's inbox socket and auth key from the registry Claude Code publishes."""
        directory = self.registry_dir()
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            return None
        for name in names:
            if not name.endswith(".json"):
                continue
            try:
                with open(directory / name, encoding="utf-8") as stream:
                    record = json.load(stream)
            except (OSError, ValueError):
                continue
            if record.get("sessionId") != native_id or not record.get(
                "messagingSocketPath"
            ):
                continue
            stem = name[: -len(".json")]
            token = None
            for candidate in names:
                if candidate.startswith(stem + ".") and candidate.endswith(".key"):
                    try:
                        token = (
                            (directory / candidate).read_text(encoding="utf-8").strip()
                        )
                    except OSError:
                        token = None
            return str(record["messagingSocketPath"]), token
        return None

    def wake(self, session: Json, text: str) -> bool:
        found = self.inbox(session["native_id"] or "")
        if not found:
            return False
        path, token = found
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.settimeout(5)
            sock.connect(path)
            if token:
                sock.sendall(json_line({"type": "auth", "token": token}).encode())
            message = {"type": "user", "message": {"role": "user", "content": text}}
            sock.sendall(json_line(message).encode())
            return True
        except OSError:
            return False
        finally:
            sock.close()


class CodexAdapter(ClientAdapter):
    name = "codex"
    notify = "push"
    last_wake_error: str | None = None

    def identity_from_env(self, env: dict[str, str]) -> Identity | None:
        codex_env = any(k.startswith("CODEX_") or k == "PLUGIN_ROOT" for k in env)
        if env.get("CLAUDECODE") or not codex_env:
            return None
        return Identity(self.name, env.get("CODEX_THREAD_ID") or None, os.getcwd())

    def hook_native(self, payload: Json) -> str | None:
        # Codex subagent lifecycle hooks carry the exact child id in agent_id;
        # their common session_id deliberately names the parent. For ordinary
        # hooks, the payload names the current thread. A nested Codex process
        # can inherit its parent's CODEX_THREAD_ID. Missing payload identity
        # must fail open instead of acting on that unrelated parent thread.
        return payload.get("agent_id") or super().hook_native(payload)

    def hook_parent_native(self, payload: Json) -> str | None:
        child = self.hook_native(payload)
        parent = payload.get("session_id")
        return str(parent) if parent and str(parent) != str(child) else None

    def hook_role(self, event: str) -> str:
        return {
            "SessionStart": "start",
            "SubagentStart": "start",
            "SessionEnd": "end",
            "SubagentStop": "end",
            "Stop": "idle",
            "Interrupt": "idle",
        }.get(event, "nudge")

    def hook_silence(self, event: str) -> Json | None:
        # SubagentStop and Stop require JSON on stdout when the hook succeeds.
        return {"continue": True} if event in {"SubagentStop", "Stop"} else None

    def wake(self, session: Json, text: str) -> bool:
        self.last_wake_error = None
        if not session["native_id"]:
            self.last_wake_error = "missing native thread id"
            return False
        try:
            proc = subprocess.run(
                ["codex", "queue", "--thread", session["native_id"], "--message", text],
                capture_output=True,
                text=True,
                timeout=15,
                check=False,
            )
        except (OSError, subprocess.SubprocessError) as error:
            self.last_wake_error = f"{type(error).__name__}: {error}"
            sys.stderr.write(
                f"agent_coord codex queue failed: {self.last_wake_error}\n"
            )
            return False
        if proc.returncode:
            detail = proc.stderr.strip()[:2000] or "no stderr"
            self.last_wake_error = f"exit {proc.returncode}: {detail}"
            sys.stderr.write(
                f"agent_coord codex queue failed: {self.last_wake_error}\n"
            )
        return proc.returncode == 0


class AntigravityAdapter(ClientAdapter):
    """Antigravity hooks inject unread context and continue an ending loop once."""

    name = "antigravity"

    def hook_native(self, payload: Json) -> str | None:
        return payload.get("conversationId")

    def hook_cwd(self, payload: Json) -> str | None:
        paths = payload.get("workspacePaths") or []
        return str(paths[0]) if paths else None

    def hook_context(self, event: str, text: str) -> Json:
        return {"injectSteps": [{"ephemeralMessage": text}]}

    def hook_silence(self, event: str) -> Json | None:
        return {"decision": "stop"} if event == "Stop" else {}

    def hook_continue(self, event: str, reason: str) -> Json:
        return {"decision": "continue", "reason": reason}

    def hook_role(self, event: str) -> str:
        return "start-or-nudge" if event == "PreInvocation" else "nudge"


ADAPTERS: dict[str, ClientAdapter] = {
    a.name: a for a in (ClaudeCodeAdapter(), CodexAdapter(), AntigravityAdapter())
}
GENERIC = ClientAdapter()


def adapter_for(client: str | None) -> ClientAdapter:
    return ADAPTERS.get(client or "", GENERIC)


def identity_from_env(explicit_client: str | None = None) -> Identity:
    env = dict(os.environ)
    if explicit_client:
        found = adapter_for(explicit_client).identity_from_env(env)
        return found or Identity(explicit_client, None, os.getcwd())
    if env.get("AGENT_COORD_CLIENT"):
        return Identity(
            env["AGENT_COORD_CLIENT"], env.get("AGENT_COORD_SID"), os.getcwd()
        )
    for adapter in ADAPTERS.values():
        found = adapter.identity_from_env(env)
        if found:
            return found
    return Identity("cli", env.get("AGENT_COORD_SID"), os.getcwd())


