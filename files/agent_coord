# ---------------------------------------------------------------- git facts (never under the lock)


def run_git(args: list[str], cwd: str | None = None) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return 1, "", str(error)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def normalize_remote(url: str) -> str:
    """Project key: host/path, case-folded host, no scheme / user / .git."""
    text = url.strip()
    text = re.sub(r"^[a-z+]+://", "", text)
    text = re.sub(r"^[^@/]+@", "", text)
    text = text.replace(":", "/", 1) if re.match(r"^[^/]+:[^/]", text) else text
    host, _, path = text.partition("/")
    path = path.rstrip("/")
    path = path[:-4] if path.endswith(".git") else path
    return f"{host.lower()}/{path}"


def git_identity(cwd: str) -> Json:
    identity: Json = {
        "cwd": cwd,
        "common_dir": None,
        "repo_top": None,
        "checkout": None,
        "branch": None,
        "project": f"dir:{cwd}",
    }
    if not os.path.isdir(cwd):
        return identity
    code, common, _ = run_git(
        ["rev-parse", "--path-format=absolute", "--git-common-dir"], cwd
    )
    if code != 0 or not common:
        return identity
    common_dir = os.path.realpath(common)
    identity["common_dir"] = common_dir
    identity["repo_top"] = (
        os.path.dirname(common_dir)
        if os.path.basename(common_dir) == ".git"
        else common_dir
    )
    code, top, _ = run_git(["rev-parse", "--show-toplevel"], cwd)
    identity["checkout"] = os.path.realpath(top) if code == 0 and top else None
    code, branch, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"], cwd)
    identity["branch"] = branch if code == 0 and branch else None
    code, remote, _ = run_git(["remote", "get-url", "origin"], cwd)
    identity["project"] = (
        normalize_remote(remote)
        if code == 0 and remote
        else f"local:{identity['repo_top']}"
    )
    return identity


def list_worktrees(common_dir: str) -> list[Json]:
    code, out, err = run_git(["-C", common_dir, "worktree", "list", "--porcelain"])
    if code != 0:
        raise CoordError(f"git worktree list failed: {err or code}")
    items: list[Json] = []
    current: Json = {}
    for line in out.splitlines() + [""]:
        if not line:
            if current:
                items.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            current = {"path": os.path.realpath(value), "branch": None, "head": None}
        elif key == "HEAD":
            current["head"] = value[:12]
        elif key == "branch":
            current["branch"] = value.removeprefix("refs/heads/")
        elif key in ("bare", "detached", "locked", "prunable"):
            current[key] = value or True
    return items


def resolve_commit(repo_top: str, ref: str) -> str | None:
    if ref.startswith("-"):
        raise CoordError(f"ref {ref!r} looks like an option", -32602)
    code, sha, _ = run_git(
        [
            "-C",
            repo_top,
            "rev-parse",
            "--verify",
            "--quiet",
            "--end-of-options",
            f"{ref}^{{commit}}",
        ]
    )
    return sha if code == 0 and sha else None


