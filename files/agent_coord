def wake_signature(session: Json, through: int, text: str) -> str:
    payload = f"{session['sid']}\n{through}\n{text}".encode()
    return hmac.new(session["token"].encode(), payload, "sha256").hexdigest()


def wake_prompt(session: Json, through: int, text: str) -> str:
    return f"[agent-coord wake v1 {through} {wake_signature(session, through, text)}] {text}"


class CoordError(Exception):
    """Error carrying a JSON-RPC style code; keep=True commits side effects recorded before it."""

    def __init__(
        self, message: str, code: int = -32000, data: object = None, keep: bool = False
    ):
        super().__init__(message)
        self.code = code
        self.data = data
        self.keep = keep


