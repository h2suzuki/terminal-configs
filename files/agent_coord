class CoordError(Exception):
    """Error carrying a JSON-RPC style code."""

    def __init__(
        self, message: str, code: int = -32000, data: object = None, keep: bool = False
    ):
        super().__init__(message)
        self.code = code
        self.data = data
        self.keep = (
            keep  # commit side effects recorded before the refusal (e.g. waiter rows)
        )


# ---------------------------------------------------------------- paths


def coord_home() -> Path:
    override = os.environ.get("AGENT_COORD_HOME")
    if override:
        return Path(override).expanduser()
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(state) / "agent_coord"


def sock_path() -> Path:
    return coord_home() / "coord.sock"


def now() -> float:
    return time.time()


def fmt_time(ts: float | None) -> str:
    return datetime.fromtimestamp(ts).strftime("%m-%d %H:%M") if ts else "-"


def fmt_ago(ts: float | None, ref: float | None = None) -> str:
    if not ts:
        return "-"
    delta = int((ref or now()) - ts)
    if delta < 60:
        return f"{delta}s"
    if delta < 3600:
        return f"{delta // 60}m"
    if delta < 86400:
        return f"{delta // 3600}h"
    return f"{delta // 86400}d"


# ---------------------------------------------------------------- git identity


def run_git(args: list[str], cwd: str | None = None) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=cwd,
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return 127, "", str(error)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def normalize_remote(url: str) -> str:
    """Reduce a remote URL to host/path so every clone of a project shares one key."""
    value = url.strip()
    value = re.sub(r"^[a-z+]+://", "", value)
    value = re.sub(r"^[^@/]+@", "", value)
    value = value.replace(":", "/", 1) if "/" not in value.split("/", 1)[0] else value
    value = re.sub(r"\.git/?$", "", value).rstrip("/")
    host, _, path = value.partition("/")
    return f"{host.lower()}/{path}"


def git_identity(cwd: str) -> Json:
    """Describe where cwd sits: repo (common dir), checkout, branch, project key."""
    identity: Json = {
        "cwd": cwd,
        "common_dir": None,
        "repo_top": None,
        "checkout": None,
        "branch": None,
        "project": f"dir:{cwd}",
    }
    if not os.path.isdir(cwd):
        return identity
    code, common, _ = run_git(
        ["rev-parse", "--path-format=absolute", "--git-common-dir"], cwd
    )
    if code != 0 or not common:
        return identity
    common_dir = os.path.realpath(common)
    identity["common_dir"] = common_dir
    identity["repo_top"] = (
        os.path.dirname(common_dir)
        if os.path.basename(common_dir) == ".git"
        else common_dir
    )
    code, top, _ = run_git(["rev-parse", "--show-toplevel"], cwd)
    identity["checkout"] = os.path.realpath(top) if code == 0 and top else None
    code, branch, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"], cwd)
    identity["branch"] = branch if code == 0 and branch else None
    code, remote, _ = run_git(["remote", "get-url", "origin"], cwd)
    identity["project"] = (
        normalize_remote(remote)
        if code == 0 and remote
        else f"local:{identity['repo_top']}"
    )
    return identity


def list_worktrees(common_dir: str) -> list[Json]:
    code, out, err = run_git(["-C", common_dir, "worktree", "list", "--porcelain"])
    if code != 0:
        raise CoordError(f"git worktree list failed: {err or code}")
    items: list[Json] = []
    current: Json = {}
    for line in out.splitlines() + [""]:
        if not line:
            if current:
                items.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            current = {"path": os.path.realpath(value), "branch": None, "head": None}
        elif key == "HEAD":
            current["head"] = value[:12]
        elif key == "branch":
            current["branch"] = value.removeprefix("refs/heads/")
        elif key in ("bare", "detached", "locked", "prunable"):
            current[key] = value or True
    return items


def path_within(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def canon_path(value: object) -> str:
    return os.path.realpath(os.path.expanduser(str(value or "")))


def required(p: Json, key: str, label: str) -> str:
    value = str(p.get(key) or "").strip()
    if not value:
        raise CoordError(f"{label} required", -32602)
    return value


def short_id() -> str:
    return secrets.token_hex(4)


def rpc_result(req_id: object, result: Json) -> Json:
    return {"jsonrpc": "2.0", "id": req_id, "result": result}


def rpc_error(req_id: object, code: int, message: str, data: object = None) -> Json:
    error: Json = {"code": code, "message": message}
    if data is not None:
        error["data"] = data
    return {"jsonrpc": "2.0", "id": req_id, "error": error}


def json_line(message: Json) -> str:
    return json.dumps(message, ensure_ascii=False) + "\n"


def pretty(result: Json) -> str:
    return json.dumps(result, ensure_ascii=False, indent=2, default=str)


# ---------------------------------------------------------------- store

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions(
  sid TEXT PRIMARY KEY, client TEXT, native_id TEXT, name TEXT, task TEXT, status TEXT,
  cwd TEXT, common_dir TEXT, repo_top TEXT, checkout TEXT, branch TEXT, project TEXT,
  edit_worktree TEXT, model TEXT, joined_at REAL, updated_at REAL,
  last_seen REAL, left_at REAL, cursor INTEGER NOT NULL DEFAULT 0,
  notified INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS events(
  seq INTEGER PRIMARY KEY AUTOINCREMENT, ts REAL, kind TEXT, actor TEXT,
  scope_kind TEXT, scope_key TEXT, body TEXT);
CREATE TABLE IF NOT EXISTS resources(
  key TEXT PRIMARY KEY, owner TEXT, purpose TEXT, generation INTEGER NOT NULL DEFAULT 0,
  acquired_at REAL, state TEXT);
CREATE TABLE IF NOT EXISTS waiters(key TEXT, sid TEXT, PRIMARY KEY(key, sid));
CREATE TABLE IF NOT EXISTS worktrees(
  path TEXT PRIMARY KEY, common_dir TEXT, owner TEXT, generation INTEGER NOT NULL DEFAULT 0,
  enforce INTEGER NOT NULL DEFAULT 0, claimed_at REAL, pending_to TEXT, pending_at REAL);
CREATE TABLE IF NOT EXISTS requests(
  req_id TEXT PRIMARY KEY, seq INTEGER, sender TEXT, scope_kind TEXT, scope_key TEXT,
  subject TEXT, body TEXT, state TEXT, result TEXT, resolved_by TEXT, resolved_at REAL,
  created_at REAL);
CREATE TABLE IF NOT EXISTS idempotency(key TEXT PRIMARY KEY, response TEXT, ts REAL);
"""

# Persisted column order per table; the in-memory rows carry exactly these keys.
COLUMNS = {
    "sessions": (
        "sid client native_id name task status cwd common_dir repo_top checkout branch"
        " project edit_worktree model joined_at updated_at last_seen left_at cursor notified"
    ).split(),
    "events": "seq ts kind actor scope_kind scope_key body".split(),
    "resources": "key owner purpose generation acquired_at state".split(),
    "worktrees": (
        "path common_dir owner generation enforce claimed_at pending_to pending_at"
    ).split(),
    "requests": (
        "req_id seq sender scope_kind scope_key subject body state result resolved_by"
        " resolved_at created_at"
    ).split(),
}


class Store:
    """Authoritative ledger held in memory; SQLite is written through so a restart rebuilds it."""

    def __init__(self, path: Path):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(
            str(path), check_same_thread=False, isolation_level=None
        )
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.execute("PRAGMA synchronous=NORMAL")
        self.db.executescript(SCHEMA)
        self.lock = threading.RLock()
        self.connections: dict[int, str] = {}
        self.listeners: list[queue.Queue[Json]] = []
        self.pending: list[Json] = []  # events appended by the running transaction
        self.started_at = now()
        self._load()

    # -- memory <-> sqlite
    def _load(self) -> None:
        """Rebuild every in-memory table from the database (startup, or after a rollback)."""

        def rows(table: str) -> list[Json]:
            return [dict(r) for r in self.db.execute(f"SELECT * FROM {table}")]

        self._sessions = {r["sid"]: r for r in rows("sessions")}
        self._resources = {r["key"]: r for r in rows("resources")}
        self._worktrees = {r["path"]: r for r in rows("worktrees")}
        self._requests = {r["req_id"]: r for r in rows("requests")}
        self._events = sorted(rows("events"), key=lambda e: e["seq"])
        for event in self._events:
            event["body"] = json.loads(event["body"])
        self._waiters: dict[str, list[str]] = {}
        for r in self.db.execute("SELECT key, sid FROM waiters ORDER BY rowid"):
            self._waiters.setdefault(r["key"], []).append(r["sid"])
        self._idempotency = {
            r["key"]: json.loads(r["response"])
            for r in self.db.execute("SELECT key, response FROM idempotency")
        }

    def _save(self, table: str, row: Json) -> None:
        cols = COLUMNS[table]
        values = [row[c] for c in cols]
        if table == "events":
            values[cols.index("body")] = json.dumps(row["body"], ensure_ascii=False)
        self.db.execute(
            f"INSERT OR REPLACE INTO {table}({','.join(cols)}) VALUES({','.join('?' * len(cols))})",
            values,
        )

    def _save_waiters(self, key: str) -> None:
        self.db.execute("DELETE FROM waiters WHERE key=?", (key,))
        self.db.executemany(
            "INSERT INTO waiters(key, sid) VALUES(?,?)",
            [(key, sid) for sid in self._waiters.get(key, [])],
        )

    # -- transaction helpers
    def transact(self, fn: Any, *args: Any) -> Any:
        """Run fn under the lock in one transaction; memory is reloaded from disk on rollback."""
        with self.lock:
            self.pending = []
            self.db.execute("BEGIN IMMEDIATE")
            try:
                result = fn(*args)
            except CoordError as error:
                if (
                    error.keep
                ):  # side effects recorded before the refusal stay (e.g. waiters)
                    self.db.execute("COMMIT")
                    self.emit_pending()
                else:
                    self.db.execute("ROLLBACK")
                    self._load()
                raise
            except BaseException:
                self.db.execute("ROLLBACK")
                self._load()
                raise
            self.db.execute("COMMIT")
            self.emit_pending()
            return copy.deepcopy(result)  # callers serialise outside the lock

    def emit_pending(self) -> None:
        events, self.pending = self.pending, []
        for listener in list(self.listeners):
            for event in events:
                listener.put(event)

    def append_event(
        self, kind: str, actor: str | None, scope: tuple[str, str], body: Json
    ) -> Json:
        event = {
            "seq": self.max_seq() + 1,
            "ts": now(),
            "kind": kind,
            "actor": actor,
            "scope_kind": scope[0],
            "scope_key": scope[1],
            "body": body,
        }
        self._events.append(event)
        self._save("events", event)
        self.pending.append(event)
        return event

    def events_after(self, seq: int) -> list[Json]:
        start = bisect.bisect_right(self._events, seq, key=lambda e: e["seq"])
        return self._events[start:]

    def max_seq(self) -> int:
        return self._events[-1]["seq"] if self._events else 0

    def live_sessions(self, ts: float) -> list[Json]:
        """Sessions that are present or left within the last hour, newest report first."""
        return sorted(
            (
                s
                for s in self._sessions.values()
                if s["left_at"] is None or s["left_at"] > ts - 3600
            ),
            key=lambda s: -(s["updated_at"] or 0),
        )

    def session(self, sid: str) -> Json | None:
        return self._sessions.get(sid)

    def require_session(self, sid: str | None) -> Json:
        if not sid:
            raise CoordError(
                "session id required (join first, or pass --as <sid>)", -32602
            )
        session = self.session(sid)
        if session is None:
            raise CoordError(f"unknown session {sid}: join first", -32001)
        if session["left_at"]:
            raise CoordError(
                f"session {sid} has left; join again to participate", -32001
            )
        session["last_seen"] = now()
        self._save("sessions", session)
        return session

    def resolve_sid(self, ref: str) -> str:
        if self.session(ref):
            return ref
        sids = [
            s["sid"]
            for s in self._sessions.values()
            if s["name"] == ref and s["left_at"] is None
        ]
        if len(sids) == 1:
            return sids[0]
        if not sids:
            raise CoordError(f"no session named or identified by {ref!r}", -32602)
        raise CoordError(f"name {ref!r} is ambiguous: " + ", ".join(sids), -32602)

    def scope_for(self, session: Json, to: str | None) -> tuple[str, str]:
        target = (to or "project").strip()
        if target == "all":
            return ("all", "")
        if target in ("project", "repo"):
            key = session[SCOPE_COL[target]]
            if not key:
                raise CoordError(
                    f"this session is not inside a git repo; scope {target} unavailable"
                )
            return (target, key)
        kind, sep, key = target.partition(":")
        if sep and kind in ("project", "repo"):
            return (kind, key)
        if sep and kind == "session":
            return ("session", self.resolve_sid(key))
        if target == "self":
            return ("session", session["sid"])
        return ("session", self.resolve_sid(target))

    def visible(self, event: Json, session: Json) -> bool:
        kind = event["scope_kind"]
        return kind == "all" or (
            kind in SCOPE_COL and event["scope_key"] == session[SCOPE_COL[kind]]
        )

    def unread_for(
        self, session: Json, limit: int | None = None
    ) -> tuple[list[Json], bool]:
        """Events after the cursor that address this session from someone else."""
        selected: list[Json] = []
        for event in self.events_after(session["cursor"]):
            own = event["actor"] == session["sid"]
            direct = (
                event["scope_kind"] == "session"
                and event["scope_key"] == session["sid"]
            )
            if event["kind"] not in NOTIFY_KINDS or (own and not direct):
                continue
            if not self.visible(event, session):
                continue
            if limit is not None and len(selected) >= limit:
                return selected, True
            selected.append(event)
        return selected, False

    # -- idempotency
    def replay(self, key: str | None) -> Json | None:
        return self._idempotency.get(key) if key else None

    def remember(self, key: str | None, response: Json) -> Json:
        if key:
            self._idempotency[key] = response
            self.db.execute(
                "INSERT OR REPLACE INTO idempotency(key, response, ts) VALUES(?,?,?)",
                (key, json.dumps(response, ensure_ascii=False), now()),
            )
        return response

    # -- sessions
    def join(self, p: Json) -> Json:
        sid = p.get("sid") or f"anon-{short_id()}"
        identity = git_identity(p.get("cwd") or os.getcwd())
        existing = self.session(sid)
        ts = now()
        name = (
            p.get("name")
            or (existing or {}).get("name")
            or (
                f"{p.get('client') or 'agent'}@{os.path.basename(identity['cwd'].rstrip('/'))}"
            )
        )
        session = existing or {
            "sid": sid,
            "client": "unknown",
            "native_id": None,
            "task": None,
            "status": "unset",
            "edit_worktree": None,
            "model": None,
            "joined_at": ts,
            "cursor": self.max_seq(),
            "notified": 0,
        }
        for key in ("client", "native_id", "task", "model"):
            if p.get(key) is not None:
                session[key] = p[key]
        session.update(
            name=name,
            updated_at=ts,
            last_seen=ts,
            left_at=None,
            **{k: identity[k] for k in IDENTITY_COLS},
        )
        self._sessions[sid] = session
        self._save("sessions", session)
        if not existing:
            self.append_event(
                "join", sid, ("all", ""), {"name": name, "client": p.get("client")}
            )
        elif existing["left_at"]:
            self.append_event("join", sid, ("all", ""), {"name": name, "rejoin": True})
        return {"session": public_session(session), **self.snapshot(session)}

    def snapshot(self, session: Json) -> Json:
        """Current state a newcomer needs: peers, held resources, open requests, unread count."""
        unread, _ = self.unread_for(session)
        peers = [
            public_session(s)
            for s in sorted(
                self._sessions.values(), key=lambda s: -(s["updated_at"] or 0)
            )
            if s["left_at"] is None and s["sid"] != session["sid"]
        ]
        return {
            "peers_same_project": [
                p for p in peers if p["project"] == session["project"]
            ],
            "peers_total": len(peers),
            "held_resources": [
                r for r in self._resources.values() if r["owner"] == session["sid"]
            ],
            "owned_worktrees": [
                w["path"]
                for w in self._worktrees.values()
                if w["owner"] == session["sid"]
            ],
            "open_requests": self.open_requests(session),
            "unread": len(unread),
        }

    def open_requests(self, session: Json | None) -> list[Json]:
        rows = sorted(
            (r for r in self._requests.values() if r["state"] == "open"),
            key=lambda r: r["seq"],
        )
        if session is None:
            return rows
        return [
            r for r in rows if r["sender"] == session["sid"] or self.visible(r, session)
        ]

    def update(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        fields: Json = {}
        for key in ("name", "task", "status", "model"):
            if p.get(key) is not None:
                fields[key] = p[key]
        if "status" in fields and fields["status"] not in STATUSES:
            raise CoordError(f"status must be one of {', '.join(STATUSES)}", -32602)
        if p.get("cwd"):
            fields.update(git_identity(p["cwd"]))
        if not fields:
            raise CoordError("nothing to update", -32602)
        session.update(fields, updated_at=now())
        self._save("sessions", session)
        self.append_event("update", session["sid"], ("all", ""), fields)
        return {"session": public_session(session)}

    def leave(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        ts = now()
        session.update(left_at=ts, updated_at=ts)
        self._save("sessions", session)
        held = 0
        for resource in self._resources.values():
            if resource["owner"] == session["sid"] and resource["state"] == "held":
                resource["state"] = "unconfirmed"
                self._save("resources", resource)
                held += 1
        self.append_event(
            "leave",
            session["sid"],
            ("all", ""),
            {"name": session["name"], "unconfirmed_resources": held},
        )
        return {"left": session["sid"], "resources_marked_unconfirmed": held}

    def whoami(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        return {"session": public_session(session), **self.snapshot(session)}

    def sessions(self, p: Json) -> Json:
        me = self.session(p.get("sid") or "")
        scope = p.get("scope") or "all"
        ts = now()
        rows = self.live_sessions(ts)
        if scope in ("project", "repo"):
            if not me:
                raise CoordError("scope project/repo needs your own session id", -32602)
            key = SCOPE_COL[scope]
            rows = [r for r in rows if r[key] == me[key]]
        return {"sessions": [public_session(r, self.connections, ts) for r in rows]}

    # -- messaging
    def send(self, p: Json) -> Json:
        if replay := self.replay(p.get("request_id")):
            return replay
        session = self.require_session(p.get("sid"))
        text = required(p, "text", "text")
        scope = self.scope_for(session, p.get("to"))
        event = self.append_event(
            "message",
            session["sid"],
            scope,
            {"text": text, "from_name": session["name"]},
        )
        return self.remember(
            p.get("request_id"),
            {
                "seq": event["seq"],
                "scope": f"{scope[0]}:{scope[1]}" if scope[1] else scope[0],
            },
        )

    def catchup(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        if p.get("ack_through") is not None:
            self.ack({"sid": session["sid"], "through": p["ack_through"]})
        limit = max(1, min(int(p.get("limit") or 20), 200))
        events, more = self.unread_for(session, limit)
        return {
            "cursor": session["cursor"],
            "events": events,
            "more": more,
            "last_seq": events[-1]["seq"] if events else session["cursor"],
        }

    def ack(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        through = min(int(p.get("through") or 0), self.max_seq())
        session["cursor"] = max(session["cursor"], through)
        self._save("sessions", session)
        return {"cursor": session["cursor"]}

    def peek(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        events, _ = self.unread_for(session)
        return {
            "unread": len(events),
            "first_seq": events[0]["seq"] if events else None,
            "last_seq": events[-1]["seq"] if events else None,
            "cursor": session["cursor"],
            "kinds": sorted({e["kind"] for e in events}),
        }

    def nudge(self, p: Json) -> Json:
        """Once per new unread range: text for a hook to inject, else null."""
        session = self.require_session(p.get("sid"))
        events, _ = self.unread_for(session)
        if not events or events[-1]["seq"] <= session["notified"]:
            return {"text": None, "unread": len(events)}
        session["notified"] = events[-1]["seq"]
        self._save("sessions", session)
        senders = sorted(
            {e["body"].get("from_name") or e["actor"] or "?" for e in events}
        )
        return {
            "text": (
                f"[agent-coord] {len(events)} unread event(s) for this session"
                f" (seq {events[0]['seq']}..{events[-1]['seq']}; from {', '.join(senders)})."
                " Read them with the catchup tool, then ack the last seq."
            ),
            "unread": len(events),
        }

    def history(self, p: Json) -> Json:
        session = self.session(p.get("sid") or "")
        since = int(p.get("since") or 0)
        limit = max(1, min(int(p.get("limit") or 50), 500))
        events: list[Json] = []
        for event in self.events_after(since):
            if (
                p.get("all")
                or session is None
                or self.visible(event, session)
                or event["actor"] == session["sid"]
            ):
                events.append(event)
                if len(events) > limit:
                    break
        return {"events": events[:limit], "more": len(events) > limit}

    # -- requests
    def request(self, p: Json) -> Json:
        if replay := self.replay(p.get("request_id")):
            return replay
        session = self.require_session(p.get("sid"))
        subject = required(p, "subject", "subject")
        scope = self.scope_for(session, p.get("to"))
        body = {
            "subject": subject,
            "text": p.get("body") or "",
            "from_name": session["name"],
        }
        req_id = f"R{self.max_seq() + 1}"
        event = self.append_event(
            "request_open", session["sid"], scope, {**body, "req_id": req_id}
        )
        req = {
            "req_id": req_id,
            "seq": event["seq"],
            "sender": session["sid"],
            "scope_kind": scope[0],
            "scope_key": scope[1],
            "subject": subject,
            "body": body["text"],
            "state": "open",
            "result": None,
            "resolved_by": None,
            "resolved_at": None,
            "created_at": now(),
        }
        self._requests[req_id] = req
        self._save("requests", req)
        if scope[0] == "session" and p.get("resource"):
            self._add_waiter(p["resource"], session["sid"])
        return self.remember(
            p.get("request_id"), {"req_id": req_id, "seq": event["seq"]}
        )

    def _request(self, req_id: str) -> Json:
        req = self._requests.get(req_id)
        if req is None:
            raise CoordError(f"unknown request {req_id}", -32602)
        return req

    def _close_request(
        self, req: Json, state: str, by: str, result: str | None
    ) -> None:
        req.update(state=state, result=result, resolved_by=by, resolved_at=now())
        self._save("requests", req)

    def resolve(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        req = self._request(str(p.get("req_id")))
        if req["state"] != "open":
            raise CoordError(
                f"request {req['req_id']} is already {req['state']}", -32003
            )
        if req["sender"] != session["sid"] and not self.visible(req, session):
            raise CoordError(
                "only the requester or an addressee can resolve a request", -32003
            )
        result = str(p.get("result") or "").strip() or "resolved"
        self._close_request(req, "resolved", session["sid"], result)
        self.append_event(
            "request_resolve",
            session["sid"],
            ("session", req["sender"]),
            {
                "req_id": req["req_id"],
                "subject": req["subject"],
                "result": result,
                "from_name": session["name"],
            },
        )
        return {"req_id": req["req_id"], "state": "resolved"}

    def cancel(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        req = self._request(str(p.get("req_id")))
        if req["sender"] != session["sid"]:
            raise CoordError("only the requester can cancel", -32003)
        if req["state"] != "open":
            raise CoordError(
                f"request {req['req_id']} is already {req['state']}", -32003
            )
        self._close_request(req, "cancelled", session["sid"], None)
        self.append_event(
            "request_cancel",
            session["sid"],
            (req["scope_kind"], req["scope_key"]),
            {
                "req_id": req["req_id"],
                "subject": req["subject"],
                "from_name": session["name"],
            },
        )
        return {"req_id": req["req_id"], "state": "cancelled"}

    def requests(self, p: Json) -> Json:
        session = self.session(p.get("sid") or "")
        return {"requests": self.open_requests(None if p.get("all") else session)}

    # -- resources
    def _add_waiter(self, key: str, sid: str) -> None:
        waiters = self._waiters.setdefault(key, [])
        if sid not in waiters:
            waiters.append(sid)
            self._save_waiters(key)

    def acquire(self, p: Json) -> Json:
        if replay := self.replay(p.get("request_id")):
            return replay
        session = self.require_session(p.get("sid"))
        key = required(p, "key", "resource key")
        current = self._resources.get(key)
        if current and current["owner"] and current["owner"] != session["sid"]:
            self._add_waiter(key, session["sid"])
            owner = self.session(current["owner"])
            raise CoordError(
                f"resource {key!r} is held by {current['owner']} ({owner['name'] if owner else '?'})"
                f" since {fmt_time(current['acquired_at'])} for: {current['purpose'] or '-'}"
                + (
                    " [state: unconfirmed]" if current["state"] == "unconfirmed" else ""
                ),
                -32010,
                {
                    "owner": current["owner"],
                    "purpose": current["purpose"],
                    "acquired_at": current["acquired_at"],
                    "state": current["state"],
                },
                keep=True,
            )
        generation = (current["generation"] if current else 0) + 1
        resource = {
            "key": key,
            "owner": session["sid"],
            "purpose": p.get("purpose"),
            "generation": generation,
            "acquired_at": now(),
            "state": "held",
        }
        self._resources[key] = resource
        self._save("resources", resource)
        if session["sid"] in self._waiters.get(key, []):
            self._waiters[key].remove(session["sid"])
            self._save_waiters(key)
        self.append_event(
            "acquire",
            session["sid"],
            ("all", ""),
            {"key": key, "purpose": p.get("purpose"), "generation": generation},
        )
        return self.remember(
            p.get("request_id"), {"key": key, "generation": generation}
        )

    def release(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        key = str(p.get("key") or "").strip()
        current = self._resources.get(key)
        if not current or not current["owner"]:
            raise CoordError(f"resource {key!r} is not held", -32011)
        if current["owner"] != session["sid"]:
            raise CoordError(
                f"resource {key!r} is held by {current['owner']}, not you", -32011
            )
        if (
            p.get("generation") is not None
            and int(p["generation"]) != current["generation"]
        ):
            raise CoordError(
                f"stale generation {p['generation']} (current {current['generation']})",
                -32011,
            )
        generation = current["generation"]
        self._do_release(current, session["sid"], session["name"], "release", None)
        return {"key": key, "released_generation": generation}

    def _do_release(
        self, resource: Json, actor: str, actor_name: str, kind: str, reason: str | None
    ) -> None:
        """Record the free state once; notify each waiter directly so nobody gets it twice."""
        key = resource["key"]
        resource.update(owner=None, purpose=None, acquired_at=None, state="free")
        self._save("resources", resource)
        waiters = self._waiters.pop(key, [])
        self._save_waiters(key)
        body = {"key": key, "from_name": actor_name, "reason": reason}
        self.append_event("resource_free", actor, ("all", ""), {**body, "kind": kind})
        for waiter in waiters:
            if waiter != actor:
                self.append_event(
                    kind, actor, ("session", waiter), {**body, "you_waited": True}
                )

    def force_release(self, p: Json) -> Json:
        key = str(p.get("key") or "").strip()
        reason = required(p, "reason", "a reason for force release is")
        current = self._resources.get(key)
        if not current or not current["owner"]:
            raise CoordError(f"resource {key!r} is not held", -32011)
        previous = current["owner"]
        actor = self.actor_for(p)
        self._do_release(
            current, actor, p.get("name") or actor, "force_release", reason
        )
        self.append_event(
            "force_release",
            actor,
            ("session", previous),
            {"key": key, "reason": reason, "previous_owner": True},
        )
        return {"key": key, "previous_owner": previous}

    def resources(self, p: Json) -> Json:
        return {"resources": [self._resources[k] for k in sorted(self._resources)]}

    def actor_for(self, p: Json) -> str:
        """Force paths are user-initiated CLI actions: an unregistered caller acts as 'user'."""
        return str(p.get("sid") or "user")

    # -- worktrees
    def _repo_worktrees(self, session: Json) -> list[Json]:
        if not session["common_dir"]:
            raise CoordError("this session is not inside a git repo", -32602)
        items = list_worktrees(session["common_dir"])
        for item in items:
            item["ownership"] = self._worktrees.get(item["path"])
        return items

    def worktree_list(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        return {
            "common_dir": session["common_dir"],
            "worktrees": self._repo_worktrees(session),
        }

    def _verify_member(self, session: Json, path: object) -> str:
        real = canon_path(path)
        members = {w["path"] for w in self._repo_worktrees(session)}
        if real not in members:
            raise CoordError(
                f"{real} is not a worktree of {session['repo_top']}", -32602
            )
        return real

    def _set_edit_worktree(self, session: Json, path: str | None) -> None:
        session.update(edit_worktree=path, updated_at=now())
        self._save("sessions", session)

    def worktree_claim(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        path = self._verify_member(session, p.get("path") or session["checkout"])
        current = self._worktrees.get(path)
        if current and current["owner"] and current["owner"] != session["sid"]:
            owner = self.session(current["owner"])
            raise CoordError(
                f"{path} is owned by {current['owner']} ({owner['name'] if owner else '?'}) since {fmt_time(current['claimed_at'])}",
                -32010,
            )
        enforce = 1 if p.get("enforce") else 0
        worktree = {
            "path": path,
            "common_dir": session["common_dir"],
            "owner": session["sid"],
            "generation": (current["generation"] if current else 0) + 1,
            "enforce": enforce,
            "claimed_at": now(),
            "pending_to": None,
            "pending_at": None,
        }
        self._worktrees[path] = worktree
        self._save("worktrees", worktree)
        self._set_edit_worktree(session, path)
        self.append_event(
            "worktree_claim",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": path, "enforce": bool(enforce)},
        )
        return {
            "path": path,
            "generation": worktree["generation"],
            "enforce": bool(enforce),
        }

    def worktree_create(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        name = str(p.get("name") or "")
        if not NAME_RE.match(name):
            raise CoordError(
                "worktree name must match [A-Za-z0-9][A-Za-z0-9._-]*", -32602
            )
        repo_top = session["repo_top"]
        if not repo_top:
            raise CoordError("this session is not inside a git repo", -32602)
        root = Path(
            p.get("root") or os.path.expanduser("~/worktrees")
        ) / os.path.basename(repo_top)
        target = str(root / name)
        if os.path.exists(target):
            if target not in {w["path"] for w in self._repo_worktrees(session)}:
                raise CoordError(
                    f"{target} exists and is not a worktree of {repo_top}", -32012
                )
            return {
                **self.worktree_claim(
                    {"sid": session["sid"], "path": target, "enforce": p.get("enforce")}
                ),
                "created": False,
                "resumed": True,
            }
        base = str(p.get("base") or "HEAD")
        code, base_sha, err = run_git(
            ["-C", repo_top, "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"]
        )
        if code != 0:
            raise CoordError(
                f"base {base!r} is not a local commit in {repo_top}: {err or 'unknown ref'}",
                -32602,
            )
        code, _, _ = run_git(
            ["-C", repo_top, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}"]
        )
        args = ["-C", repo_top, "worktree", "add", target] + (
            [name] if code == 0 else ["-b", name, base_sha]
        )
        root.mkdir(parents=True, exist_ok=True)
        code, out, err = run_git(args)
        if code != 0:
            raise CoordError(
                f"git worktree add failed (rc={code}): {err or out}. Nothing was deleted; inspect {target} and branch {name}",
                -32012,
            )
        self.append_event(
            "worktree_create",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": target, "branch": name, "base": base_sha[:12]},
        )
        return {
            **self.worktree_claim(
                {"sid": session["sid"], "path": target, "enforce": p.get("enforce")}
            ),
            "created": True,
            "branch": name,
            "base": base_sha[:12],
        }

    def _owned(self, session: Json, p: Json) -> Json:
        """Worktree row (default: the session's edit worktree) that this session owns."""
        path = canon_path(p.get("path") or session["edit_worktree"])
        current = self._worktrees.get(path)
        if not current or current["owner"] != session["sid"]:
            raise CoordError(f"{path} is not owned by {session['sid']}", -32011)
        return current

    def _drop_owner(self, worktree: Json) -> None:
        """One state transition shared by release, force-release and accept."""
        worktree.update(owner=None, pending_to=None, pending_at=None)
        self._save("worktrees", worktree)
        for session in self._sessions.values():
            if session["edit_worktree"] == worktree["path"]:
                session["edit_worktree"] = None
                self._save("sessions", session)

    def worktree_release(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        worktree = self._owned(session, p)
        self._drop_owner(worktree)
        self.append_event(
            "worktree_release",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": worktree["path"]},
        )
        return {"path": worktree["path"], "owner": None}

    def worktree_transfer(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        worktree = self._owned(session, p)
        to = self.resolve_sid(str(p.get("to") or ""))
        if to == session["sid"]:
            raise CoordError("cannot transfer to yourself", -32602)
        worktree.update(pending_to=to, pending_at=now())
        self._save("worktrees", worktree)
        self.append_event(
            "transfer_propose",
            session["sid"],
            ("session", to),
            {
                "path": worktree["path"],
                "from_name": session["name"],
                "note": p.get("note"),
            },
        )
        return {"path": worktree["path"], "pending_to": to}

    def worktree_accept(self, p: Json) -> Json:
        session = self.require_session(p.get("sid"))
        path = canon_path(p.get("path"))
        current = self._worktrees.get(path)
        if not current or current["pending_to"] != session["sid"]:
            raise CoordError(
                f"no transfer of {path} is pending for {session['sid']}", -32011
            )
        previous = current["owner"]
        self._drop_owner(current)
        current.update(
            owner=session["sid"], generation=current["generation"] + 1, claimed_at=now()
        )
        self._save("worktrees", current)
        self._set_edit_worktree(session, path)
        self.append_event(
            "transfer_accept",
            session["sid"],
            ("session", previous),
            {"path": path, "from_name": session["name"]},
        )
        return {"path": path, "owner": session["sid"], "previous_owner": previous}

    def worktree_force_release(self, p: Json) -> Json:
        path = canon_path(p.get("path"))
        reason = required(p, "reason", "a reason for force release is")
        current = self._worktrees.get(path)
        if not current or not current["owner"]:
            raise CoordError(f"{path} has no owner", -32011)
        previous = current["owner"]
        self._drop_owner(current)
        actor = self.actor_for(p)
        self.append_event(
            "worktree_force_release",
            actor,
            ("session", previous),
            {"path": path, "reason": reason},
        )
        return {"path": path, "previous_owner": previous}

    def edit_check(self, p: Json) -> Json:
        """Deny edits that land in another checkout of the repo the session claimed with enforce."""
        session = self.session(p.get("sid") or "")
        target = canon_path(p.get("path"))
        if not session or not session["edit_worktree"]:
            return {"allow": True, "reason": "no enforced worktree"}
        claim = self._worktrees.get(session["edit_worktree"])
        if not claim or claim["owner"] != session["sid"] or not claim["enforce"]:
            return {"allow": True, "reason": "claim inactive or not enforced"}
        if path_within(target, claim["path"]):
            return {"allow": True, "reason": "inside own worktree"}
        for item in list_worktrees(claim["common_dir"]):
            if path_within(target, item["path"]):
                return {
                    "allow": False,
                    "reason": f"{target} is inside {item['path']}, not your worktree {claim['path']}",
                }
        return {"allow": True, "reason": "outside the repo"}

    # -- overview
    def status(self, p: Json) -> Json:
        ts = now()
        sessions = []
        for row in sorted(self.live_sessions(ts), key=lambda s: s["project"] or ""):
            item = public_session(row, self.connections, ts)
            item["unread"] = len(self.unread_for(row)[0])
            sessions.append(item)
        return {
            "service": {
                "version": VERSION,
                "pid": os.getpid(),
                "started_at": self.started_at,
                "home": str(coord_home()),
                "events": self.max_seq(),
                "connections": len(self.connections),
            },
            "sessions": sessions,
            "resources": [
                self._resources[k]
                for k in sorted(self._resources)
                if self._resources[k]["owner"]
            ],
            "worktrees": [
                self._worktrees[k]
                for k in sorted(self._worktrees)
                if self._worktrees[k]["owner"] or self._worktrees[k]["pending_to"]
            ],
            "requests": self.open_requests(None),
        }


def public_session(
    row: Json, connections: dict[int, str] | None = None, ts: float | None = None
) -> Json:
    result = {k: v for k, v in row.items() if k != "notified"}
    if connections is not None:
        result["connections"] = sum(1 for s in connections.values() if s == row["sid"])
    result["updated_ago"] = fmt_ago(row.get("updated_at"), ts)
    result["seen_ago"] = fmt_ago(row.get("last_seen"), ts)
    return result


