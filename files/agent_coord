class Journal:
    """SQLite behind the ledger: applies the changed rows of a transaction, reloads everything."""

    def __init__(self, path: Path):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(
            str(path), check_same_thread=False, isolation_level=None
        )
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.execute("PRAGMA synchronous=NORMAL")
        self.db.executescript(SCHEMA)

    def load(self) -> Json:
        data: Json = {}
        for table, (_, cols) in TABLES.items():
            rows = [dict(r) for r in self.db.execute(f"SELECT * FROM {table}")]
            for row in rows:
                for col in cols:
                    if (table, col) in JSON_COLS and isinstance(row.get(col), str):
                        row[col] = json.loads(row[col])
            data[table] = rows
        meta = self.db.execute("SELECT value FROM meta WHERE key='last_seq'").fetchone()
        data["last_seq"] = meta[0] if meta else 0
        return data

    def begin(self) -> None:
        self.db.execute("BEGIN IMMEDIATE")

    def commit(
        self,
        upserts: list[tuple[str, Json]],
        deletes: list[tuple[str, tuple]],
        last_seq: int,
    ) -> None:
        for table, row in upserts:
            _, cols = TABLES[table]
            values = [
                json.dumps(row[c], ensure_ascii=False)
                if (table, c) in JSON_COLS
                else row.get(c)
                for c in cols
            ]
            marks = ",".join("?" * len(cols))
            self.db.execute(
                f"INSERT OR REPLACE INTO {table}({','.join(cols)}) VALUES({marks})",
                values,
            )
        for table, key in deletes:
            pk = TABLES[table][0] if table in TABLES else ("sid",)
            real = "deliveries" if table == "deliveries_by_sid" else table
            where = " AND ".join(f"{c}=?" for c in pk)
            self.db.execute(f"DELETE FROM {real} WHERE {where}", key)
        self.db.execute(
            "INSERT OR REPLACE INTO meta(key, value) VALUES('last_seq', ?)", (last_seq,)
        )
        self.db.execute("COMMIT")

    def rollback(self) -> None:
        self.db.execute("ROLLBACK")

    def close(self) -> None:
        self.db.close()


# ---------------------------------------------------------------- ledger (pure, in memory)


class Ledger:
    """All state and every rule. Mutations go through touch()/drop() so the journal can follow."""

    def __init__(self, clock: Callable[[], float], data: Json | None = None):
        self.clock = clock
        self.sessions: dict[str, Json] = {}
        self.events: list[Json] = []
        self.by_seq: dict[int, Json] = {}
        self.deliveries: dict[
            str, dict[int, Json]
        ] = {}  # sid -> seq -> row, seq-ordered
        self.resources: dict[str, Json] = {}
        self.waiters: dict[str, list[str]] = {}
        self.declarations: dict[str, dict[str, str]] = {}
        self.worktrees: dict[str, Json] = {}
        self.requests: dict[str, Json] = {}
        self.replays: dict[str, Json] = {}
        self.last_seq = 0
        self.upserts: list[tuple[str, Json]] = []
        self.deletes: list[tuple[str, tuple]] = []
        self.pending_events: list[Json] = []
        self.bound: dict[str, str] = {}  # connection -> sid (not persisted)
        if data:
            self.load(data)

    def load(self, data: Json) -> None:
        self.sessions = {r["sid"]: r for r in data["sessions"]}
        self.events = sorted(data["events"], key=lambda e: e["seq"])
        self.by_seq = {e["seq"]: e for e in self.events}
        self.deliveries = {}
        for r in sorted(data["deliveries"], key=lambda d: d["seq"]):
            if r["seq"] in self.by_seq:
                self.deliveries.setdefault(r["sid"], {})[r["seq"]] = r
        self.resources = {r["key"]: r for r in data["resources"]}
        self.waiters = {}
        for r in data["waiters"]:
            self.waiters.setdefault(r["key"], []).append(r["sid"])
        self.declarations = {}
        for r in data["declarations"]:
            self.declarations.setdefault(r["key"], {})[r["sid"]] = r["purpose"]
        self.worktrees = {r["path"]: r for r in data["worktrees"]}
        self.requests = {r["req_id"]: r for r in data["requests"]}
        self.replays = {r["key"]: r for r in data["replays"]}
        self.last_seq = max(
            data["last_seq"], self.events[-1]["seq"] if self.events else 0
        )

    # -- change tracking
    def touch(self, table: str, row: Json) -> Json:
        self.upserts.append((table, row))
        return row

    def drop(self, table: str, *key: object) -> None:
        self.deletes.append((table, tuple(key)))

    def take_changes(
        self,
    ) -> tuple[list[tuple[str, Json]], list[tuple[str, tuple]], list[Json]]:
        changes = (self.upserts, self.deletes, self.pending_events)
        self.upserts, self.deletes, self.pending_events = [], [], []
        return changes

    def now(self) -> float:
        return self.clock()

    # -- expiry
    def expire(self) -> None:
        cutoff = self.now() - EVENT_TTL
        pruned = 0
        while self.events and self.events[0]["ts"] < cutoff:
            pruned = self.events.pop(0)["seq"]
            del self.by_seq[pruned]
            self.drop("events", pruned)
        if pruned:
            for sid, rows in self.deliveries.items():
                lost = [q for q in rows if q <= pruned]
                for q in lost:
                    del rows[q]
                    self.drop("deliveries", sid, q)
                if lost and sid in self.sessions:
                    session = self.sessions[sid]
                    session["gap_through"], session["gap_reason"] = pruned, "expired"
                    self.touch("sessions", session)
        for key, record in list(self.replays.items()):
            if record["ts"] < self.now() - REPLAY_TTL:
                del self.replays[key]
                self.drop("replays", key)
        for sid, session in list(self.sessions.items()):
            if session["left_at"] and session["left_at"] < cutoff:
                del self.sessions[sid]
                self.deliveries.pop(sid, None)
                self.drop("sessions", sid)
                self.drop("deliveries_by_sid", sid)

    # -- events and deliveries
    def append_event(
        self, kind: str, actor: str | None, scope: tuple[str, str], body: Json
    ) -> Json:
        self.last_seq += 1
        event = {
            "seq": self.last_seq,
            "ts": self.now(),
            "kind": kind,
            "actor": actor,
            "scope_kind": scope[0],
            "scope_key": scope[1],
            "body": body,
        }
        self.events.append(event)
        self.by_seq[event["seq"]] = event
        self.touch("events", event)
        self.pending_events.append(event)
        for sid in self.recipients(event):
            self.deliver(sid, event["seq"])
        return event

    def recipients(self, event: Json) -> list[str]:
        """The addressee, or every present session the scope covers except the actor."""
        if event["kind"] not in NOTIFY_KINDS:
            return []
        if event["scope_kind"] == "session":
            return [event["scope_key"]] if event["scope_key"] in self.sessions else []
        return [
            s["sid"]
            for s in self.present_sessions()
            if s["sid"] != event["actor"] and self.visible(event, s)
        ]

    def deliver(self, sid: str, seq: int, backfill: bool = False) -> None:
        rows = self.deliveries.setdefault(sid, {})
        if seq in rows:
            return
        pull = adapter_for(self.sessions[sid]["client"]).notify == "pull"
        row = {
            "sid": sid,
            "seq": seq,
            "backfill": int(backfill),
            "state": "pull" if pull else "pending",
        }
        rows[seq] = row
        self.deliveries[sid] = dict(sorted(rows.items()))
        self.touch("deliveries", row)
        session = self.sessions[sid]
        if session["gap_through"]:
            session["gap_through"], session["gap_reason"] = None, None
            self.touch("sessions", session)

    def mark_deliveries(self, conn: str, p: Json) -> Json:
        rows = self.deliveries.get(p["sid"], {})
        for seq in p["seqs"]:
            if seq in rows and rows[seq]["state"] == "pending":
                rows[seq]["state"] = p["state"]
                self.touch("deliveries", rows[seq])
        return {}

    def unread(self, sid: str) -> list[Json]:
        return list(self.deliveries.get(sid, {}).values())

    def unread_events(
        self, sid: str, limit: int | None = None
    ) -> tuple[list[Json], bool]:
        rows = self.unread(sid)
        more = limit is not None and len(rows) > limit
        rows = rows[:limit] if more else rows
        events = [
            {**self.by_seq[r["seq"]], "backfill": True}
            if r["backfill"]
            else self.by_seq[r["seq"]]
            for r in rows
        ]
        return events, more

    def visible(self, event: Json, session: Json) -> bool:
        kind = event["scope_kind"]
        return kind == "all" or (
            kind in SCOPE_COL and event["scope_key"] == session[SCOPE_COL[kind]]
        )

    def backfill(self, session: Json, since_ts: float) -> None:
        """Deliver what the session missed on its scopes: after its cursor, since since_ts, not yet there."""
        sid = session["sid"]
        rows = self.deliveries.get(sid, {})
        start = bisect.bisect_right(
            self.events, session["cursor"], key=lambda e: e["seq"]
        )
        for event in self.events[start:]:
            if (
                event["ts"] >= since_ts
                and event["scope_kind"] != "session"
                and event["seq"] not in rows
                and sid in self.recipients(event)
            ):
                self.deliver(sid, event["seq"], backfill=True)

    # -- sessions and identity
    def session(self, sid: str | None) -> Json | None:
        return self.sessions.get(sid or "")

    def bind(self, conn: str, sid: str) -> None:
        if conn:
            self.bound[conn] = sid

    def actor(self, conn: str, p: Json) -> Json:
        """The session this connection may act as: the one it registered by join / attach."""
        sid = p.get("sid") or self.bound.get(conn)
        if not sid:
            raise CoordError("session id required: join or attach first", -32602)
        if self.bound.get(conn) != sid:
            raise CoordError(
                f"this connection is not registered as {sid}: join or attach first",
                -32001,
            )
        session = self.sessions.get(sid)
        if session is None:
            raise CoordError(f"unknown session {sid}: join first", -32001)
        if session["left_at"]:
            raise CoordError(
                f"session {sid} has left; join again to participate", -32001
            )
        session["last_seen"] = self.now()
        self.touch("sessions", session)
        return session

    def present_sessions(self) -> list[Json]:
        """Sessions that can be addressed: not left, and connected or seen within PRESENCE_TTL."""
        connected = set(self.bound.values())
        horizon = self.now() - PRESENCE_TTL
        return [
            s
            for s in self.sessions.values()
            if s["left_at"] is None
            and (s["sid"] in connected or (s["last_seen"] or 0) >= horizon)
        ]

    def resolve_sid(self, ref: str) -> str:
        if ref in self.sessions:
            return ref
        sids = [s["sid"] for s in self.present_sessions() if s["name"] == ref]
        if len(sids) == 1:
            return sids[0]
        if not sids:
            raise CoordError(f"no session named or identified by {ref!r}", -32602)
        raise CoordError(f"name {ref!r} is ambiguous: " + ", ".join(sids), -32602)

    def scope_for(self, session: Json, to: str | None) -> tuple[str, str]:
        target = (to or "project").strip()
        if target == "all":
            return ("all", "")
        if target in ("project", "repo"):
            key = session[SCOPE_COL[target]]
            if not key:
                raise CoordError(
                    f"this session is not inside a git repo; scope {target} unavailable"
                )
            return (target, key)
        kind, sep, key = target.partition(":")
        if sep and kind in ("project", "repo"):
            return (kind, key)
        if sep and kind == "session":
            return ("session", self.resolve_sid(key))
        if target == "self":
            return ("session", session["sid"])
        return ("session", self.resolve_sid(target))

    def capabilities(self, session: Json) -> Json:
        adapter = adapter_for(session["client"])
        return {"notify": adapter.notify, "enforcement": adapter.enforcement}

    def public(self, session: Json, connections: dict[str, str] | None = None) -> Json:
        ts = self.now()
        out = {k: v for k, v in session.items() if k not in ("token", "nudged")}
        out["updated_ago"] = fmt_ago(session["updated_at"], ts)
        out["seen_ago"] = fmt_ago(session["last_seen"], ts)
        out["capabilities"] = self.capabilities(session)
        if connections is not None:
            out["connections"] = sum(
                1 for s in connections.values() if s == session["sid"]
            )
        return out

    # -- replay (retry with the same request id)
    def replay_key(self, session: Json, method: str, p: Json) -> str | None:
        rid = p.get("request_id")
        return f"{session['sid']}\x00{method}\x00{rid}" if rid else None

    def replay(self, key: str | None) -> Json | None:
        record = self.replays.get(key or "")
        return copy.deepcopy(record["response"]) if record else None

    def remember(self, key: str | None, response: Json) -> Json:
        if key:
            row = {"key": key, "response": response, "ts": self.now()}
            self.replays[key] = self.touch("replays", row)
        return response

    # ================================================================ methods: (conn, p, ...)
    def join(self, conn: str, p: Json, identity: Json) -> Json:
        client = str(p.get("client") or "cli")
        native = p.get("native_id")
        sid = p.get("sid") or (
            session_id_for(client, str(native)) if native else f"anon-{short_id()}"
        )
        existing = self.sessions.get(sid)
        if (
            existing
            and native
            and existing["native_id"]
            and existing["native_id"] != native
        ):
            raise CoordError(f"{sid} is registered to another native id", -32001)
        rejoin = bool(existing and existing["left_at"])
        ts = self.now()
        name = (
            p.get("name")
            or (existing or {}).get("name")
            or f"{client}@{os.path.basename(identity['cwd'].rstrip('/'))}"
        )
        session = existing or {
            "sid": sid,
            "client": client,
            "native_id": native,
            "task": None,
            "status": "unset",
            "edit_worktree": None,
            "model": None,
            "token": secrets.token_hex(16),
            "joined_at": ts,
            "cursor": 0,
            "nudged": 0,
            "gap_through": None,
            "gap_reason": None,
        }
        for key in ("client", "native_id", "task", "model"):
            if p.get(key) is not None:
                session[key] = p[key]
        session.update(
            name=name,
            updated_at=ts,
            last_seen=ts,
            left_at=None,
            **{k: identity[k] for k in IDENTITY_COLS},
        )
        self.sessions[sid] = self.touch("sessions", session)
        self.bind(conn, sid)
        self.backfill(session, ts - (EVENT_TTL if existing else JOIN_BACKFILL))
        if not existing:
            self.append_event(
                "join", sid, ("all", ""), {"name": name, "client": client}
            )
        elif rejoin:
            self.append_event("join", sid, ("all", ""), {"name": name, "rejoin": True})
        return {
            "session": {**self.public(session), "token": session["token"]},
            **self.snapshot(session),
        }

    def attach(self, conn: str, p: Json) -> Json:
        """Register this connection as an existing session, proven by its native id or token."""
        sid = required(p, "sid", "sid")
        session = self.sessions.get(sid)
        if session is None:
            raise CoordError(f"unknown session {sid}: join first", -32001)
        by_native = bool(p.get("native_id")) and session["native_id"] == p["native_id"]
        by_token = bool(p.get("token")) and session["token"] == p["token"]
        if not (by_native or by_token):
            raise CoordError(
                f"cannot attach as {sid}: native id or token does not match", -32001
            )
        session["last_seen"] = self.now()
        self.touch("sessions", session)
        self.bind(conn, sid)
        return {"session": self.public(session)}

    def snapshot(self, session: Json) -> Json:
        """Current state a joiner needs regardless of age: peers, held grants, open requests, unread."""
        peers = [
            self.public(s)
            for s in sorted(
                self.present_sessions(), key=lambda s: -(s["updated_at"] or 0)
            )
            if s["sid"] != session["sid"]
        ]
        return {
            "peers_same_project": [
                x for x in peers if x["project"] == session["project"]
            ],
            "peers_total": len(peers),
            "resources_held": [r for r in self.resources.values() if r["owner"]],
            "owned_worktrees": [
                w["path"]
                for w in self.worktrees.values()
                if w["owner"] == session["sid"]
            ],
            "open_requests": self.open_requests(session),
            "unread": len(self.unread(session["sid"])),
        }

    def update(self, conn: str, p: Json, identity: Json | None) -> Json:
        session = self.actor(conn, p)
        fields: Json = {
            k: p[k] for k in ("name", "task", "status", "model") if p.get(k) is not None
        }
        if "status" in fields and fields["status"] not in STATUSES:
            raise CoordError(f"status must be one of {', '.join(STATUSES)}", -32602)
        if identity:
            fields.update({k: identity[k] for k in IDENTITY_COLS})
        if not fields:
            raise CoordError("nothing to update", -32602)
        session.update(fields, updated_at=self.now())
        self.touch("sessions", session)
        self.append_event("update", session["sid"], ("all", ""), fields)
        return {"session": self.public(session)}

    def leave(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        ts = self.now()
        session.update(left_at=ts, updated_at=ts)
        self.touch("sessions", session)
        held = 0
        for resource in self.resources.values():
            if resource["owner"] == session["sid"] and resource["state"] == "held":
                resource["state"] = "unconfirmed"
                self.touch("resources", resource)
                held += 1
        self.append_event(
            "leave",
            session["sid"],
            ("all", ""),
            {"name": session["name"], "unconfirmed_resources": held},
        )
        return {"left": session["sid"], "resources_marked_unconfirmed": held}

    def whoami(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        return {
            "session": {**self.public(session), "token": session["token"]},
            **self.snapshot(session),
        }

    def sessions_(self, conn: str, p: Json, connections: dict[str, str]) -> Json:
        me = self.session(p.get("sid") or self.bound.get(conn))
        scope = p.get("scope") or "all"
        rows = self.live_sessions()
        if scope in ("project", "repo"):
            if not me:
                raise CoordError("scope project/repo needs your own session id", -32602)
            rows = [r for r in rows if r[SCOPE_COL[scope]] == me[SCOPE_COL[scope]]]
        return {"sessions": [self.public(r, connections) for r in rows]}

    def live_sessions(self) -> list[Json]:
        ts = self.now()
        return sorted(
            (
                s
                for s in self.sessions.values()
                if s["left_at"] is None or s["left_at"] > ts - 3600
            ),
            key=lambda s: -(s["updated_at"] or 0),
        )

    # -- messaging
    def send(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        key = self.replay_key(session, "send", p)
        if replay := self.replay(key):
            return replay
        text = required(p, "text", "text")
        scope = self.scope_for(session, p.get("to"))
        event = self.append_event(
            "message",
            session["sid"],
            scope,
            {"text": text, "from_name": session["name"]},
        )
        label = f"{scope[0]}:{scope[1]}" if scope[1] else scope[0]
        return self.remember(key, {"seq": event["seq"], "scope": label})

    def catchup(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        if p.get("ack_through") is not None:
            self.ack(conn, {"sid": session["sid"], "through": p["ack_through"]})
        limit = max(1, min(int(p.get("limit") or 20), 200))
        events, more = self.unread_events(session["sid"], limit)
        return {
            "cursor": session["cursor"],
            "events": events,
            "more": more,
            "last_seq": events[-1]["seq"] if events else session["cursor"],
            "gap": self.gap(session),
        }

    def gap(self, session: Json) -> Json | None:
        if session["gap_through"]:
            return {"through": session["gap_through"], "reason": session["gap_reason"]}
        return None

    def ack(self, conn: str, p: Json) -> Json:
        """Confirm delivery up to a seq; the cursor only moves forward; acked entries go."""
        session = self.actor(conn, p)
        through = min(int(p.get("through") or 0), self.last_seq)
        sid = session["sid"]
        rows = self.deliveries.get(sid, {})
        for seq in [q for q in rows if q <= through]:
            del rows[seq]
            self.drop("deliveries", sid, seq)
        session["cursor"] = max(session["cursor"], through)
        self.touch("sessions", session)
        return {"cursor": session["cursor"]}

    def peek(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        rows = self.unread(session["sid"])
        return {
            "unread": len(rows),
            "first_seq": rows[0]["seq"] if rows else None,
            "last_seq": rows[-1]["seq"] if rows else None,
            "cursor": session["cursor"],
            "kinds": sorted({self.by_seq[r["seq"]]["kind"] for r in rows}),
            "deliveries": [{"seq": r["seq"], "state": r["state"]} for r in rows],
            "gap": self.gap(session),
        }

    def unread_text(self, session: Json) -> str | None:
        rows = self.unread(session["sid"])
        if not rows:
            return None
        events = [self.by_seq[r["seq"]] for r in rows]
        senders = sorted(
            {e["body"].get("from_name") or e["actor"] or "?" for e in events}
        )
        return (
            f"[agent-coord] {len(rows)} unread event(s) for this session"
            f" (seq {rows[0]['seq']}..{rows[-1]['seq']}; from {', '.join(senders)})."
            " Read them with the catchup tool, then ack the last seq."
        )

    def nudge(self, conn: str, p: Json) -> Json:
        """Once per new unread range (pull path): text for a hook to inject, else null."""
        session = self.actor(conn, p)
        rows = self.unread(session["sid"])
        if not rows or rows[-1]["seq"] <= session["nudged"]:
            return {"text": None, "unread": len(rows)}
        session["nudged"] = rows[-1]["seq"]
        self.touch("sessions", session)
        return {"text": self.unread_text(session), "unread": len(rows)}

    def history(self, conn: str, p: Json) -> Json:
        session = self.session(p.get("sid") or self.bound.get(conn))
        since = int(p.get("since") or 0)
        limit = max(1, min(int(p.get("limit") or 50), 500))
        start = bisect.bisect_right(self.events, since, key=lambda e: e["seq"])
        events: list[Json] = []
        for event in self.events[start:]:
            mine = session is not None and event["actor"] == session["sid"]
            if p.get("all") or session is None or self.visible(event, session) or mine:
                events.append(event)
                if len(events) > limit:
                    break
        return {"events": events[:limit], "more": len(events) > limit}

    # -- requests
    def request(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        key = self.replay_key(session, "request", p)
        if replay := self.replay(key):
            return replay
        subject = required(p, "subject", "subject")
        scope = self.scope_for(session, p.get("to"))
        req_id = f"R{self.last_seq + 1}"
        body = {
            "subject": subject,
            "text": p.get("body") or "",
            "from_name": session["name"],
            "req_id": req_id,
        }
        event = self.append_event("request_open", session["sid"], scope, body)
        req = {
            "req_id": req_id,
            "seq": event["seq"],
            "sender": session["sid"],
            "scope_kind": scope[0],
            "scope_key": scope[1],
            "subject": subject,
            "body": body["text"],
            "state": "open",
            "result": None,
            "resolved_by": None,
            "resolved_at": None,
            "created_at": self.now(),
        }
        self.requests[req_id] = self.touch("requests", req)
        if scope[0] == "session" and p.get("resource"):
            self.add_waiter(str(p["resource"]), session["sid"])
        return self.remember(key, {"req_id": req_id, "seq": event["seq"]})

    def _open_request(self, req_id: object) -> Json:
        req = self.requests.get(str(req_id))
        if req is None:
            raise CoordError(f"unknown request {req_id}", -32602)
        if req["state"] != "open":
            raise CoordError(
                f"request {req['req_id']} is already {req['state']}", -32003
            )
        return req

    def resolve(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        req = self._open_request(p.get("req_id"))
        if req["sender"] != session["sid"] and not self.visible(req, session):
            raise CoordError(
                "only the requester or an addressee can resolve a request", -32003
            )
        result = str(p.get("result") or "").strip() or "resolved"
        req.update(
            state="resolved",
            result=result,
            resolved_by=session["sid"],
            resolved_at=self.now(),
        )
        self.touch("requests", req)
        own = (
            req["sender"] == session["sid"]
        )  # no self-notification: tell the addressees instead
        self.append_event(
            "request_resolve",
            session["sid"],
            (req["scope_kind"], req["scope_key"])
            if own
            else ("session", req["sender"]),
            {
                "req_id": req["req_id"],
                "subject": req["subject"],
                "result": result,
                "from_name": session["name"],
            },
        )
        return {"req_id": req["req_id"], "state": "resolved"}

    def cancel(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        req = self._open_request(p.get("req_id"))
        if req["sender"] != session["sid"]:
            raise CoordError("only the requester can cancel", -32003)
        req.update(
            state="cancelled", resolved_by=session["sid"], resolved_at=self.now()
        )
        self.touch("requests", req)
        self.append_event(
            "request_cancel",
            session["sid"],
            (req["scope_kind"], req["scope_key"]),
            {
                "req_id": req["req_id"],
                "subject": req["subject"],
                "from_name": session["name"],
            },
        )
        return {"req_id": req["req_id"], "state": "cancelled"}

    def open_requests(self, session: Json | None) -> list[Json]:
        rows = sorted(
            (r for r in self.requests.values() if r["state"] == "open"),
            key=lambda r: r["seq"],
        )
        if session is None:
            return rows
        return [
            r for r in rows if r["sender"] == session["sid"] or self.visible(r, session)
        ]

    def requests_(self, conn: str, p: Json) -> Json:
        session = self.session(p.get("sid") or self.bound.get(conn))
        return {"requests": self.open_requests(None if p.get("all") else session)}

    # -- resources
    def add_waiter(self, key: str, sid: str) -> None:
        waiters = self.waiters.setdefault(key, [])
        if sid not in waiters:
            waiters.append(sid)
            self.touch("waiters", {"key": key, "sid": sid})

    def clear_waiters(self, key: str) -> list[str]:
        waiters = self.waiters.pop(key, [])
        for sid in waiters:
            self.drop("waiters", key, sid)
        return waiters

    def resource_view(self, resource: Json) -> Json:
        declared = self.declarations.get(resource["key"], {})
        return {
            **resource,
            "declared_by": [{"sid": s, "purpose": u} for s, u in declared.items()],
        }

    def blank_resource(self, key: str) -> Json:
        return {
            "key": key,
            "owner": None,
            "purpose": None,
            "generation": 0,
            "acquired_at": None,
            "state": "free",
            "pending_to": None,
            "pending_at": None,
            "forced_seq": None,
            "forced_from": None,
        }

    def acquire(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        key = required(p, "key", "resource key")
        current = self.resources.get(key)
        replay_key = self.replay_key(session, "acquire", p)
        cached = self.replay(replay_key)
        if cached and current and current["owner"] == session["sid"]:
            if current["generation"] == cached["generation"]:
                return cached
        if current and current["owner"] == session["sid"]:
            return {"key": key, "generation": current["generation"]}
        if current and current["owner"]:
            self.add_waiter(key, session["sid"])
            owner = self.session(current["owner"])
            raise CoordError(
                f"resource {key!r} is held by {current['owner']} ({owner['name'] if owner else '?'})"
                f" since {fmt_time(current['acquired_at'])} for: {current['purpose'] or '-'}"
                + (
                    " [state: unconfirmed]" if current["state"] == "unconfirmed" else ""
                ),
                -32010,
                {k: current[k] for k in ("owner", "purpose", "acquired_at", "state")},
                keep=True,
            )
        if (
            current
            and current["forced_from"] == session["sid"]
            and current["forced_seq"]
            and current["forced_seq"] > session["cursor"]
        ):
            raise CoordError(
                f"resource {key!r} was force-released from you (seq {current['forced_seq']});"
                " read and ack the notice first",
                -32013,
            )
        resource = {
            **self.blank_resource(key),
            "owner": session["sid"],
            "purpose": p.get("purpose"),
            "generation": (current["generation"] if current else 0) + 1,
            "acquired_at": self.now(),
            "state": "held",
        }
        self.resources[key] = self.touch("resources", resource)
        if session["sid"] in self.waiters.get(key, []):
            self.waiters[key].remove(session["sid"])
            self.drop("waiters", key, session["sid"])
        self.append_event(
            "acquire",
            session["sid"],
            ("all", ""),
            {
                "key": key,
                "purpose": p.get("purpose"),
                "generation": resource["generation"],
            },
        )
        return self.remember(
            replay_key, {"key": key, "generation": resource["generation"]}
        )

    def _held_by(self, session: Json, p: Json) -> Json:
        key = required(p, "key", "resource key")
        current = self.resources.get(key)
        if not current or not current["owner"]:
            raise CoordError(f"resource {key!r} is not held", -32011)
        if current["owner"] != session["sid"]:
            raise CoordError(
                f"resource {key!r} is held by {current['owner']}, not you", -32011
            )
        return current

    def release(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        key = self.replay_key(session, "release", p)
        if replay := self.replay(key):
            return replay
        if p.get("generation") is None:
            raise CoordError(
                "generation required: pass the generation acquire returned", -32602
            )
        current = self._held_by(session, p)
        if int(p["generation"]) != current["generation"]:
            raise CoordError(
                f"stale generation {p['generation']} (current {current['generation']})",
                -32011,
            )
        generation = current["generation"]
        self._free(current, session["sid"], session["name"], "release", None)
        return self.remember(
            key, {"key": current["key"], "released_generation": generation}
        )

    def _free(
        self, resource: Json, actor: str, actor_name: str, kind: str, reason: str | None
    ) -> None:
        """Record the free state once; tell each waiter directly so nobody learns it twice."""
        key = resource["key"]
        resource.update(
            owner=None,
            purpose=None,
            acquired_at=None,
            state="free",
            pending_to=None,
            pending_at=None,
        )
        self.touch("resources", resource)
        body = {"key": key, "from_name": actor_name, "reason": reason}
        self.append_event("resource_free", actor, ("all", ""), {**body, "kind": kind})
        for waiter in self.clear_waiters(key):
            if waiter != actor and waiter in self.sessions:
                self.append_event(
                    kind, actor, ("session", waiter), {**body, "you_waited": True}
                )

    def user_action(self, p: Json) -> str:
        """Force paths are the user's own explicit operation, never an agent's shortcut."""
        if not p.get("user_action"):
            raise CoordError(
                "force operations are user actions: run them from the CLI as yourself",
                -32003,
            )
        required(p, "reason", "a reason for the force operation is")
        return "user"

    def force_release(self, conn: str, p: Json) -> Json:
        actor = self.user_action(p)
        key = required(p, "key", "resource key")
        current = self.resources.get(key)
        if not current or not current["owner"]:
            raise CoordError(f"resource {key!r} is not held", -32011)
        previous = current["owner"]
        self._free(current, actor, actor, "force_release", p["reason"])
        notice = self.append_event(
            "force_release",
            actor,
            ("session", previous),
            {"key": key, "reason": p["reason"], "previous_owner": True},
        )
        current.update(forced_seq=notice["seq"], forced_from=previous)
        self.touch("resources", current)
        return {"key": key, "previous_owner": previous}

    def resource_transfer(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        current = self._held_by(session, p)
        to = self.resolve_sid(str(p.get("to") or ""))
        if to == session["sid"]:
            raise CoordError("cannot transfer to yourself", -32602)
        current.update(pending_to=to, pending_at=self.now())
        self.touch("resources", current)
        self.append_event(
            "transfer_propose",
            session["sid"],
            ("session", to),
            {
                "key": current["key"],
                "from_name": session["name"],
                "note": p.get("note"),
            },
        )
        return {"key": current["key"], "pending_to": to}

    def resource_accept(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        key = required(p, "key", "resource key")
        current = self.resources.get(key)
        if not current or current["pending_to"] != session["sid"]:
            raise CoordError(
                f"no transfer of {key!r} is pending for {session['sid']}", -32011
            )
        previous = current["owner"]
        current.update(
            owner=session["sid"],
            generation=current["generation"] + 1,
            acquired_at=self.now(),
            state="held",
            pending_to=None,
            pending_at=None,
        )
        self.touch("resources", current)
        self.append_event(
            "transfer_accept",
            session["sid"],
            ("session", previous),
            {"key": key, "from_name": session["name"]},
        )
        return {
            "key": key,
            "owner": session["sid"],
            "previous_owner": previous,
            "generation": current["generation"],
        }

    def declare(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        key = required(p, "key", "resource key")
        purpose = str(p.get("purpose") or "")
        self.declarations.setdefault(key, {})[session["sid"]] = purpose
        self.touch(
            "declarations", {"key": key, "sid": session["sid"], "purpose": purpose}
        )
        if key not in self.resources:
            self.resources[key] = self.touch("resources", self.blank_resource(key))
        return {"key": key, "declared": True}

    def resources_(self, conn: str, p: Json) -> Json:
        return {
            "resources": [
                self.resource_view(self.resources[k]) for k in sorted(self.resources)
            ]
        }

    # -- worktrees (git facts arrive as parameters; nothing forks here)
    def worktree_claim(self, conn: str, p: Json, members: list[Json]) -> Json:
        session = self.actor(conn, p)
        path = str(p.get("path") or session["checkout"] or "")
        if not os.path.isabs(path):
            raise CoordError("worktree path must be absolute", -32602)
        path = canon_path(path)
        if path not in {m["path"] for m in members}:
            raise CoordError(
                f"{path} is not a worktree of {session['repo_top']}", -32602
            )
        current = self.worktrees.get(path)
        if current and current["owner"] and current["owner"] != session["sid"]:
            owner = self.session(current["owner"])
            raise CoordError(
                f"{path} is owned by {current['owner']} ({owner['name'] if owner else '?'})"
                f" since {fmt_time(current['claimed_at'])}",
                -32010,
            )
        worktree = {
            "path": path,
            "common_dir": session["common_dir"],
            "owner": session["sid"],
            "generation": (current["generation"] if current else 0) + 1,
            "enforce": 1 if p.get("enforce") else 0,
            "claimed_at": self.now(),
            "pending_to": None,
            "pending_at": None,
        }
        self.worktrees[path] = self.touch("worktrees", worktree)
        self._set_edit_worktree(session, path)
        self.append_event(
            "worktree_claim",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": path, "enforce": bool(worktree["enforce"])},
        )
        return {
            "path": path,
            "generation": worktree["generation"],
            "enforce": bool(worktree["enforce"]),
        }

    def worktree_plan(self, conn: str, p: Json) -> Json:
        """Validate a create request and say what would happen; the Coordinator runs git."""
        session = self.actor(conn, p)
        name = str(p.get("name") or "")
        if not NAME_RE.match(name):
            raise CoordError(
                "worktree name must match [A-Za-z0-9][A-Za-z0-9._-]*", -32602
            )
        if not session["repo_top"]:
            raise CoordError("this session is not inside a git repo", -32602)
        allowed = canon_path(worktree_root())
        root = canon_path(p.get("root") or allowed)
        if not path_within(root, allowed):
            raise CoordError(f"worktree root must stay under {allowed}", -32602)
        base = str(p.get("base") or "")
        if base.startswith("-"):
            raise CoordError(f"base {base!r} looks like an option", -32602)
        return {
            "repo_top": session["repo_top"],
            "common_dir": session["common_dir"],
            "target": str(Path(root) / os.path.basename(session["repo_top"]) / name),
            "branch": name,
            "base_ref": base or "HEAD",
            "base_explicit": bool(base),
        }

    def _owned_worktree(self, session: Json, p: Json) -> Json:
        raw = p.get("path") or session["edit_worktree"]
        current = self.worktrees.get(canon_path(raw)) if raw else None
        if not current or current["owner"] != session["sid"]:
            raise CoordError(
                f"{raw or '(no worktree)'} is not owned by {session['sid']}", -32011
            )
        return current

    def _set_edit_worktree(self, session: Json, path: str | None) -> None:
        session.update(edit_worktree=path, updated_at=self.now())
        self.touch("sessions", session)

    def _drop_worktree_owner(self, worktree: Json) -> None:
        worktree.update(owner=None, pending_to=None, pending_at=None)
        self.touch("worktrees", worktree)
        for session in self.sessions.values():
            if session["edit_worktree"] == worktree["path"]:
                self._set_edit_worktree(session, None)

    def worktree_release(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        worktree = self._owned_worktree(session, p)
        self._drop_worktree_owner(worktree)
        self.append_event(
            "worktree_release",
            session["sid"],
            ("repo", session["common_dir"]),
            {"path": worktree["path"]},
        )
        return {"path": worktree["path"], "owner": None}

    def worktree_transfer(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        worktree = self._owned_worktree(session, p)
        to = self.resolve_sid(str(p.get("to") or ""))
        if to == session["sid"]:
            raise CoordError("cannot transfer to yourself", -32602)
        worktree.update(pending_to=to, pending_at=self.now())
        self.touch("worktrees", worktree)
        self.append_event(
            "transfer_propose",
            session["sid"],
            ("session", to),
            {
                "path": worktree["path"],
                "from_name": session["name"],
                "note": p.get("note"),
            },
        )
        return {"path": worktree["path"], "pending_to": to}

    def worktree_accept(self, conn: str, p: Json) -> Json:
        session = self.actor(conn, p)
        path = canon_path(p.get("path"))
        current = self.worktrees.get(path)
        if not current or current["pending_to"] != session["sid"]:
            raise CoordError(
                f"no transfer of {path} is pending for {session['sid']}", -32011
            )
        previous = current["owner"]
        self._drop_worktree_owner(current)
        current.update(
            owner=session["sid"],
            generation=current["generation"] + 1,
            claimed_at=self.now(),
        )
        self.touch("worktrees", current)
        self._set_edit_worktree(session, path)
        self.append_event(
            "transfer_accept",
            session["sid"],
            ("session", previous),
            {"path": path, "from_name": session["name"]},
        )
        return {"path": path, "owner": session["sid"], "previous_owner": previous}

    def worktree_force_release(self, conn: str, p: Json) -> Json:
        actor = self.user_action(p)
        path = canon_path(p.get("path"))
        current = self.worktrees.get(path)
        if not current or not current["owner"]:
            raise CoordError(f"{path} has no owner", -32011)
        previous = current["owner"]
        self._drop_worktree_owner(current)
        self.append_event(
            "worktree_force_release",
            actor,
            ("session", previous),
            {"path": path, "reason": p["reason"]},
        )
        return {"path": path, "previous_owner": previous}

    def edit_check(self, conn: str, p: Json, members: list[Json]) -> Json:
        """Deny an edit that lands in another checkout of the repo this session claimed with enforce."""
        session = self.session(p.get("sid") or self.bound.get(conn))
        target = str(p.get("path") or "")
        if not session or not session["edit_worktree"]:
            return {"allow": True, "reason": "no enforced worktree"}
        claim = self.worktrees.get(session["edit_worktree"])
        if not claim or claim["owner"] != session["sid"] or not claim["enforce"]:
            return {"allow": True, "reason": "claim inactive or not enforced"}
        if not os.path.isabs(target):
            return {
                "allow": False,
                "reason": f"{target!r} is relative; the gate only judges absolute paths",
            }
        target = canon_path(target)
        if path_within(target, claim["path"]):
            return {"allow": True, "reason": "inside own worktree"}
        for item in members:
            if path_within(target, item["path"]):
                return {
                    "allow": False,
                    "reason": f"{target} is inside {item['path']}, not your worktree {claim['path']}",
                }
        return {"allow": True, "reason": "outside the repo"}

    def worktree_view(self, worktree: Json) -> Json:
        owner = self.session(worktree["owner"]) if worktree["owner"] else None
        level = "coop"
        if worktree["enforce"]:
            level = adapter_for(owner["client"]).enforcement if owner else "advisory"
        return {**worktree, "enforcement": level}

    # -- overview
    def status(
        self,
        conn: str,
        p: Json,
        connections: dict[str, str],
        started_at: float,
        home: Path,
    ) -> Json:
        sessions = []
        for row in sorted(self.live_sessions(), key=lambda s: s["project"] or ""):
            item = self.public(row, connections)
            rows = self.unread(row["sid"])
            item["unread"] = len(rows)
            item["deliveries"] = {
                state: sum(1 for r in rows if r["state"] == state)
                for state in sorted({r["state"] for r in rows})
            }
            sessions.append(item)
        return {
            "service": {
                "version": VERSION,
                "pid": os.getpid(),
                "started_at": started_at,
                "home": str(home),
                "events": self.last_seq,
                "retained": len(self.events),
                "connections": len(connections),
                "projects": sorted(
                    {s["project"] for s in sessions if s.get("project")}
                ),
            },
            "sessions": sessions,
            "resources": [
                self.resource_view(self.resources[k])
                for k in sorted(self.resources)
                if self.resources[k]["owner"]
            ],
            "waiters": [
                {"key": k, "sid": s}
                for k in sorted(self.waiters)
                for s in self.waiters[k]
            ],
            "worktrees": [
                self.worktree_view(self.worktrees[k])
                for k in sorted(self.worktrees)
                if self.worktrees[k]["owner"] or self.worktrees[k]["pending_to"]
            ],
            "requests": self.open_requests(None),
        }


METHODS = frozenset(
    (
        "join attach update leave whoami sessions send catchup ack peek nudge history request"
        " resolve cancel requests acquire release force_release resource_transfer resource_accept"
        " declare resources worktree_list worktree_claim worktree_create worktree_release"
        " worktree_transfer worktree_accept worktree_force_release edit_check status"
    ).split()
)
USER_ONLY = frozenset({"force_release", "worktree_force_release"})
LEDGER_NAME = {
    "sessions": "sessions_",
    "requests": "requests_",
    "resources": "resources_",
}


# ---------------------------------------------------------------- coordinator


class Coordinator:
    """Serialises ledger access, keeps git out of the lock, and fans out after commit."""

    def __init__(self, home: Path, clock: Callable[[], float] | None = None):
        self.home = home
        self.clock = clock or time.time
        self.journal = Journal(home / "ledger.sqlite3")
        self.ledger = Ledger(self.clock, self.journal.load())
        self.lock = threading.RLock()
        self.connections: dict[str, str] = {}
        self.subscribers: list[Callable[[Json], None]] = []
        self.started_at = self.clock()
        self.committed: list[Json] = []
        self.wakes: queue.Queue[bool] = queue.Queue()
        self.waker = threading.Thread(target=self._wake_loop, daemon=True)
        self.waker.start()

    def close(self) -> None:
        self.wakes.put(False)
        self.waker.join(5)
        self.journal.close()

    def subscribe(self, callback: Callable[[Json], None]) -> None:
        with self.lock:
            self.subscribers.append(callback)

    def unsubscribe(self, callback: Callable[[Json], None]) -> None:
        with self.lock:
            if callback in self.subscribers:
                self.subscribers.remove(callback)

    def disconnect(self, conn: str) -> None:
        with self.lock:
            self.ledger.bound.pop(conn, None)
            self.connections.pop(conn, None)

    def _session_common_dir(self, conn: str, p: Json) -> str | None:
        with self.lock:
            session = self.ledger.session(p.get("sid") or self.ledger.bound.get(conn))
            return session["common_dir"] if session else None

    def call(self, conn: str, method: str, params: Json) -> Any:
        if method not in METHODS:
            raise CoordError(f"unknown method {method!r}", -32601)
        if method == "worktree_create":
            return self._worktree_create(conn, params)
        extra: tuple = ()
        if method == "join":
            extra = (git_identity(str(params.get("cwd") or os.getcwd())),)
        elif method == "update":
            extra = (git_identity(str(params["cwd"])) if params.get("cwd") else None,)
        elif method in ("worktree_claim", "worktree_list", "edit_check"):
            common_dir = self._session_common_dir(conn, params)
            members = list_worktrees(common_dir) if common_dir else []
            if method == "worktree_list":
                return self.transact(lambda: self._worktree_list(conn, params, members))
            extra = (members,)
        elif method == "sessions":
            extra = (self.connections,)
        elif method == "status":
            extra = (self.connections, self.started_at, self.home)
        target = getattr(self.ledger, LEDGER_NAME.get(method, method))
        return self.transact(lambda: target(conn, params, *extra), conn)

    def _worktree_list(self, conn: str, p: Json, members: list[Json]) -> Json:
        session = self.ledger.actor(conn, p)
        for item in members:
            registered = self.ledger.worktrees.get(item["path"])
            item["ownership"] = (
                self.ledger.worktree_view(registered) if registered else None
            )
        return {"common_dir": session["common_dir"], "worktrees": members}

    def _worktree_create(self, conn: str, p: Json) -> Json:
        plan = self.transact(lambda: self.ledger.worktree_plan(conn, p), conn)
        repo_top, target, name = plan["repo_top"], plan["target"], plan["branch"]
        members = list_worktrees(plan["common_dir"])
        existing_branch = resolve_commit(repo_top, f"refs/heads/{name}")
        base = resolve_commit(repo_top, plan["base_ref"])
        if base is None:
            raise CoordError(
                f"base {plan['base_ref']!r} is not a local commit in {repo_top}", -32602
            )
        if existing_branch:
            if plan["base_explicit"] and base != existing_branch:
                raise CoordError(
                    f"branch {name} already exists at {existing_branch[:12]}; drop --base or pick another name",
                    -32602,
                )
            base = existing_branch
        if p.get("dry_run"):
            return {
                "target": target,
                "branch": name,
                "base": base,
                "exists": os.path.exists(target),
            }
        if os.path.exists(target):
            if target not in {m["path"] for m in members}:
                raise CoordError(
                    f"{target} exists and is not a worktree of {repo_top}; nothing was touched",
                    -32012,
                )
            claim = self.transact(
                lambda: self.ledger.worktree_claim(
                    conn, {**p, "path": target}, members
                ),
                conn,
            )
            return {
                **claim,
                "created": False,
                "resumed": True,
                "branch": name,
                "base": base,
            }
        args = ["-C", repo_top, "worktree", "add"]
        args += (
            ["--", target, name]
            if existing_branch
            else ["-b", name, "--", target, base]
        )
        Path(target).parent.mkdir(parents=True, exist_ok=True)
        code, out, err = run_git(args)
        if code != 0:
            raise CoordError(
                f"git worktree add failed (rc={code}): {err or out}. Nothing was deleted;"
                f" inspect {target} and branch {name}",
                -32012,
            )
        members = list_worktrees(plan["common_dir"])

        def record() -> Json:
            session = self.ledger.actor(conn, p)
            self.ledger.append_event(
                "worktree_create",
                session["sid"],
                ("repo", session["common_dir"]),
                {"path": target, "branch": name, "base": base[:12]},
            )
            return self.ledger.worktree_claim(conn, {**p, "path": target}, members)

        claim = self.transact(record, conn)
        return {
            **claim,
            "created": True,
            "resumed": False,
            "branch": name,
            "base": base,
        }

    def transact(self, fn: Callable[[], Any], conn: str = "") -> Any:
        """One locked transaction; write-through; stream and wake only committed events, outside the lock."""
        events: list[Json] = []
        subscribers: list[Callable[[Json], None]] = []
        try:
            with self.lock:
                self.ledger.take_changes()
                self.journal.begin()
                try:
                    self.ledger.expire()
                    result = fn()
                except CoordError as error:
                    if error.keep:
                        events, subscribers = self._commit()
                    else:
                        self._rollback()
                    raise
                except BaseException:
                    self._rollback()
                    raise
                events, subscribers = self._commit()
                if conn and conn in self.ledger.bound:
                    self.connections[conn] = self.ledger.bound[conn]
                return copy.deepcopy(result)
        finally:
            for event in events:
                for callback in subscribers:
                    callback(event)
            if events:
                self.wakes.put(True)

    def _commit(self) -> tuple[list[Json], list[Callable[[Json], None]]]:
        upserts, deletes, events = self.ledger.take_changes()
        self.journal.commit(upserts, deletes, self.ledger.last_seq)
        return events, list(self.subscribers)

    def _rollback(self) -> None:
        self.journal.rollback()
        self.ledger.load(self.journal.load())
        self.ledger.take_changes()

    # -- wake channel (push), never under the lock
    def _wake_loop(self) -> None:
        while self.wakes.get():
            try:
                self._wake_pending()
            except Exception as error:  # a broken channel must not stop the daemon
                sys.stderr.write(f"agent_coord wake: {error!r}\n")

    def _wake_pending(self) -> None:
        with self.lock:
            targets = []
            for sid, rows in self.ledger.deliveries.items():
                states = [r["state"] for r in rows.values()]
                session = self.ledger.sessions.get(sid)
                if session and "pending" in states and "pushed" not in states:
                    seqs = [q for q, r in rows.items() if r["state"] == "pending"]
                    targets.append(
                        (copy.deepcopy(session), seqs, self.ledger.unread_text(session))
                    )
        for session, seqs, text in targets:
            ok = adapter_for(session["client"]).wake(session, text or "")
            outcome = {
                "sid": session["sid"],
                "seqs": seqs,
                "state": "pushed" if ok else "unavailable",
            }
            self.transact(lambda o=outcome: self.ledger.mark_deliveries("", o))


# ---------------------------------------------------------------- transport


class Handler(socketserver.StreamRequestHandler):
    """One socket connection: newline JSON-RPC requests; after subscribe, pushed events."""

    server: DaemonServer

    def handle(self) -> None:
        co = self.server.coordinator
        conn = f"c{id(self)}"
        try:
            for raw in self.rfile:
                try:
                    message = json.loads(raw)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    self.reply(rpc_error(None, -32700, "parse error"))
                    continue
                if not isinstance(message, dict):
                    continue
                method = message.get("method")
                params = message.get("params") or {}
                req_id = message.get("id")
                if method == "ping":
                    self.reply(
                        rpc_result(
                            req_id,
                            {"pong": True, "pid": os.getpid(), "version": VERSION},
                        )
                    )
                elif method == "subscribe":
                    self.reply(rpc_result(req_id, {"subscribed": True}))
                    self.stream(co)
                    return
                elif method == "shutdown":
                    self.reply(rpc_result(req_id, {"stopping": True}))
                    threading.Thread(target=self.server.shutdown, daemon=True).start()
                    return
                elif not isinstance(method, str) or not isinstance(params, dict):
                    self.reply(rpc_error(req_id, -32600, "invalid request"))
                else:
                    self.reply(self.dispatch(co, conn, method, params, req_id))
        finally:
            co.disconnect(conn)

    def dispatch(
        self, co: Coordinator, conn: str, method: str, params: Json, req_id: object
    ) -> Json:
        try:
            return rpc_result(req_id, co.call(conn, method, params))
        except CoordError as error:
            return rpc_error(req_id, error.code, str(error), error.data)
        except (ValueError, TypeError) as error:
            return rpc_error(req_id, -32602, f"invalid params: {error}")
        except (sqlite3.Error, OSError) as error:
            self.server.log(f"{method} failed: {error!r}")
            return rpc_error(req_id, -32603, f"internal error: {error}")

    def stream(self, co: Coordinator) -> None:
        events: queue.Queue[Json] = queue.Queue()
        co.subscribe(events.put)
        try:
            while not self.server.stopping:
                try:
                    event = events.get(timeout=1)
                except queue.Empty:
                    continue
                self.reply({"jsonrpc": "2.0", "method": "event", "params": event})
        except OSError:
            pass
        finally:
            co.unsubscribe(events.put)

    def reply(self, message: Json) -> None:
        self.wfile.write(json_line(message).encode())
        self.wfile.flush()


class DaemonServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, path: Path, coordinator: Coordinator, log_file: TextIO | None):
        self.coordinator = coordinator
        self.stopping = False
        self.log_file = log_file
        super().__init__(str(path), Handler)

    def log(self, text: str) -> None:
        stream = self.log_file or sys.stderr
        stream.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {text}\n")
        stream.flush()

    def shutdown(self) -> None:
        self.stopping = True
        super().shutdown()


def acquire_singleton(home: Path) -> int | None:
    home.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(home / "coord.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode())
    return fd


def serve(
    home: Path, log_file: TextIO | None = None, ready: threading.Event | None = None
) -> int:
    lock_fd = acquire_singleton(home)
    if lock_fd is None:
        (log_file or sys.stderr).write(f"another daemon already serves {home}\n")
        return 1
    path = home / "coord.sock"
    if path.exists():
        path.unlink()
    try:
        coordinator = Coordinator(home)
    except (sqlite3.Error, ValueError, OSError) as error:
        (log_file or sys.stderr).write(f"ledger unreadable in {home}: {error!r}\n")
        os.close(lock_fd)
        return 1
    server = DaemonServer(path, coordinator, log_file)
    os.chmod(path, 0o600)
    server.log(f"agent_coord {VERSION} serving {path} pid={os.getpid()}")
    if ready:
        ready.set()
    try:
        server.serve_forever(poll_interval=0.5)
    finally:
        server.server_close()
        coordinator.close()
        if path.exists():
            path.unlink()
        os.close(lock_fd)
        server.log("stopped")
    return 0


def spawn_daemon(home: Path) -> None:
    home.mkdir(parents=True, exist_ok=True)
    with open(home / "daemon.log", "a", encoding="utf-8") as log:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "serve"],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
            env={**os.environ, "AGENT_COORD_HOME": str(home)},
        )


class Client:
    """Synchronous newline JSON-RPC client over the daemon's unix socket."""

    def __init__(self, path: Path | None = None, autostart: bool = True):
        self.path = path or sock_path()
        self.sock = self.connect(
            autostart and not os.environ.get("AGENT_COORD_NO_AUTOSTART")
        )
        self.file = self.sock.makefile("r", encoding="utf-8")
        self.sock.settimeout(60)
        self.counter = 0

    def connect(self, autostart: bool) -> socket.socket:
        deadline = time.time() + 5
        spawned = False
        while True:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                sock.settimeout(5)
                sock.connect(str(self.path))
                return sock
            except OSError as error:
                sock.close()
                if not autostart:
                    raise CoordError(self.diagnose(error), -32050) from error
                if not spawned:
                    try:
                        spawn_daemon(self.path.parent)
                    except OSError as spawn_error:
                        raise CoordError(
                            f"cannot start daemon in {self.path.parent}: {spawn_error}",
                            -32050,
                        ) from spawn_error
                    spawned = True
                if time.time() > deadline:
                    raise CoordError(
                        self.diagnose(error) + " (autostart timed out)", -32050
                    ) from error
                time.sleep(0.1)

    def diagnose(self, error: OSError) -> str:
        home = self.path.parent
        hint = f"start it with: agent_coord serve --daemon (home {home})"
        if not home.exists():
            return f"coordinator home {home} does not exist; {hint}"
        if not self.path.exists():
            return f"coordinator is not running (no {self.path.name} in {home}); {hint}"
        return f"cannot reach coordinator at {self.path}: {error}; stale socket or permission problem; {hint}"

    def call(self, method: str, **params: Any) -> Json:
        self.counter += 1
        payload = {
            "jsonrpc": "2.0",
            "id": self.counter,
            "method": method,
            "params": {k: v for k, v in params.items() if v is not None},
        }
        self.sock.sendall(json_line(payload).encode())
        line = self.file.readline()
        if not line:
            raise CoordError("coordinator closed the connection", -32050)
        message = json.loads(line)
        if "error" in message:
            error = message["error"]
            raise CoordError(
                error.get("message", "error"),
                error.get("code", -32000),
                error.get("data"),
            )
        return cast(Json, message.get("result"))

    def close(self) -> None:
        self.file.close()
        self.sock.close()


def ensure_session(
    client: Client,
    identity: Identity,
    name: str | None = None,
    model: str | None = None,
) -> Json:
    """Attach to the session this process belongs to, joining if the ledger does not know it yet."""
    if not identity.native_id:
        return client.call(
            "join", client=identity.client, cwd=identity.cwd, name=name, model=model
        )
    sid = session_id_for(identity.client, identity.native_id)
    try:
        return client.call("attach", sid=sid, native_id=identity.native_id)
    except CoordError as error:
        if error.code != -32001:
            raise
    return client.call(
        "join",
        client=identity.client,
        native_id=identity.native_id,
        cwd=identity.cwd,
        name=name,
        model=model,
    )


