def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(
        add_help=False
    )  # global flags, before or after the subcommand
    common.add_argument(
        "--as",
        dest="sid",
        default=argparse.SUPPRESS,
        help="act as this session id (default: from CLAUDE_CODE_SESSION_ID / AGENT_COORD_SID)",
    )
    common.add_argument(
        "--json",
        action="store_true",
        default=argparse.SUPPRESS,
        help="machine-readable output",
    )
    common.add_argument(
        "--no-autostart",
        action="store_true",
        default=argparse.SUPPRESS,
        help="fail instead of starting the daemon",
    )
    parser = argparse.ArgumentParser(
        prog="agent_coord",
        description="Coordinate agent sessions on this host.",
        parents=[common],
    )
    top = parser.add_subparsers(dest="command", required=True)

    class Sub:
        def add_parser(self, name: str, **kw: Any) -> argparse.ArgumentParser:
            return top.add_parser(name, parents=[common], **kw)

    sub = Sub()
    p = sub.add_parser("serve", help="run the coordinator daemon")
    p.add_argument("--daemon", action="store_true", help="detach into the background")
    sub.add_parser("stop", help="stop the daemon (ledger is kept)")
    sub.add_parser("doctor", help="diagnose connectivity and identity")
    sub.add_parser(
        "mcp", help="stdio MCP adapter (registered by install_claude_extensions)"
    )
    p = sub.add_parser("hook", help="Claude Code hook entry")
    p.add_argument("event")
    p = sub.add_parser("join", help="register this session")
    p.add_argument("--name")
    p.add_argument("--task")
    p.add_argument("--client")
    p.add_argument("--cwd")
    sub.add_parser("whoami")
    sub.add_parser("leave")
    p = sub.add_parser("update")
    p.add_argument("--name")
    p.add_argument("--task")
    p.add_argument("--status", choices=STATUSES)
    p.add_argument("--cwd")
    p = sub.add_parser("sessions")
    p.add_argument("--scope", choices=["all", "project", "repo"], default="all")
    p = sub.add_parser("send")
    p.add_argument("text")
    p.add_argument("--to", default="project")
    p.add_argument("--request-id")
    p = sub.add_parser("catchup")
