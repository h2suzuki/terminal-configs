def fmt_time(ts: float | None) -> str:
    return datetime.fromtimestamp(ts).strftime("%m-%d %H:%M") if ts else "-"


def fmt_ago(ts: float | None, ref: float) -> str:
    if not ts:
        return "-"
    delta = max(0, int(ref - ts))
    if delta >= 3600:
        return f"{delta // 3600} hr {delta % 3600 // 60} min"
    if delta >= 60:
        return f"{delta // 60} min"
    return f"{delta} sec"


