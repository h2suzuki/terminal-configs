class Handler(socketserver.StreamRequestHandler):
    """One UDS connection: newline JSON-RPC requests; after subscribe, pushed events."""

    server: DaemonServer

    def handle(self) -> None:
        store = self.server.store
        conn_id = threading.get_ident()
        try:
            for raw in self.rfile:
                try:
                    message = json.loads(raw)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    self.reply(
                        {
                            "jsonrpc": "2.0",
                            "id": None,
                            "error": {"code": -32700, "message": "parse error"},
                        }
                    )
                    continue
                if not isinstance(message, dict):
                    continue
                method, params, req_id = (
                    message.get("method"),
                    message.get("params") or {},
                    message.get("id"),
                )
                if method == "subscribe":
                    self.reply(
                        {"jsonrpc": "2.0", "id": req_id, "result": {"subscribed": True}}
                    )
                    self.stream_events(store)
                    return
                if method == "shutdown":
                    self.reply(
                        {"jsonrpc": "2.0", "id": req_id, "result": {"stopping": True}}
                    )
                    threading.Thread(target=self.server.shutdown, daemon=True).start()
                    return
                self.reply(self.dispatch(store, conn_id, method, params, req_id))
        finally:
            with store.lock:
                store.connections.pop(conn_id, None)

    def dispatch(
        self, store: Store, conn_id: int, method: object, params: object, req_id: object
    ) -> Json:
        if method == "ping":
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {"pong": True, "pid": os.getpid(), "version": VERSION},
            }
        if (
            not isinstance(method, str)
            or method not in METHODS
            or not isinstance(params, dict)
        ):
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {"code": -32601, "message": f"unknown method {method!r}"},
            }
        before = store.max_seq()
        try:
            result = store.transact(getattr(store, method), params)
        except CoordError as error:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {
                    "code": error.code,
                    "message": str(error),
                    "data": error.data,
                },
            }
        except (sqlite3.Error, OSError, ValueError, TypeError) as error:
            self.server.log(f"{method} failed: {error!r}")
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {"code": -32603, "message": f"internal error: {error}"},
            }
        if method in ("join", "whoami") and params.get("sid"):
            with store.lock:
                store.connections[conn_id] = str(params["sid"])
        after = store.max_seq()
        for seq in range(before + 1, after + 1):
            if event := store.event(seq):
                store.emit(event)
        return {"jsonrpc": "2.0", "id": req_id, "result": result}

    def stream_events(self, store: Store) -> None:
        events: queue.Queue[Json] = queue.Queue()
        with store.lock:
            store.listeners.append(events)
        try:
            while not self.server.stopping:
                try:
                    event = events.get(timeout=1)
                except queue.Empty:
                    continue
                self.reply({"jsonrpc": "2.0", "method": "event", "params": event})
        except OSError:
            pass
        finally:
            with store.lock:
                store.listeners.remove(events)

    def reply(self, message: Json) -> None:
        self.wfile.write((json.dumps(message, ensure_ascii=False) + "\n").encode())
        self.wfile.flush()


class DaemonServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, path: Path, store: Store, log_file: TextIO | None):
        self.store = store
        self.stopping = False
        self.log_file = log_file
        super().__init__(str(path), Handler)

    def log(self, text: str) -> None:
        stream = self.log_file or sys.stderr
        stream.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {text}\n")
        stream.flush()

    def shutdown(self) -> None:
        self.stopping = True
        super().shutdown()


def acquire_singleton(home: Path) -> int | None:
    """Return a held lock fd, or None when another daemon owns the home."""
    home.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(home / "coord.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode())
    return fd


def serve(
    home: Path, log_file: TextIO | None = None, ready: threading.Event | None = None
) -> int:
    lock_fd = acquire_singleton(home)
    if lock_fd is None:
        print(f"another daemon already serves {home}", file=sys.stderr)
        return 0
    path = home / "coord.sock"
    if path.exists():
        path.unlink()
    store = Store(home / "ledger.sqlite3")
    server = DaemonServer(path, store, log_file)
    os.chmod(path, 0o600)
    server.log(f"agent_coord {VERSION} serving {path} pid={os.getpid()}")
    if ready:
        ready.set()
    try:
        server.serve_forever(poll_interval=0.5)
    finally:
        server.server_close()
        if path.exists():
            path.unlink()
        os.close(lock_fd)
        server.log("stopped")
    return 0


def spawn_daemon(home: Path) -> None:
    home.mkdir(parents=True, exist_ok=True)
    with open(home / "daemon.log", "a", encoding="utf-8") as log:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "serve"],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
            env={**os.environ, "AGENT_COORD_HOME": str(home)},
        )


# ---------------------------------------------------------------- client


class Client:
    """Synchronous newline JSON-RPC client over the daemon's unix socket."""

    def __init__(
        self, path: Path | None = None, autostart: bool = True, timeout: float = 30
    ):
        self.path = path or sock_path()
        self.sock = self.connect(autostart)
        self.file = self.sock.makefile("r", encoding="utf-8")
        self.sock.settimeout(timeout)
        self.counter = 0

    def connect(self, autostart: bool) -> socket.socket:
        deadline = now() + 5
        spawned = False
        while True:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                sock.settimeout(5)
                sock.connect(str(self.path))
                return sock
            except OSError as error:
                sock.close()
                if not autostart or os.environ.get("AGENT_COORD_NO_AUTOSTART"):
                    raise CoordError(self.diagnose(error), -32050) from error
                if not spawned:
                    try:
                        spawn_daemon(self.path.parent)
                    except OSError as spawn_error:
                        raise CoordError(
                            f"cannot start daemon in {self.path.parent}: {spawn_error}",
                            -32050,
                        ) from spawn_error
                    spawned = True
                if now() > deadline:
                    raise CoordError(
                        self.diagnose(error) + " (autostart timed out)", -32050
                    ) from error
                time.sleep(0.1)

    def diagnose(self, error: OSError) -> str:
        home = self.path.parent
        hint = f"start it with: agent_coord serve --daemon (home {home})"
        if not home.exists():
            return f"coordinator home {home} does not exist; {hint}"
        if not self.path.exists():
            return f"coordinator is not running (no {self.path.name} in {home}); {hint}"
        return f"cannot reach coordinator at {self.path}: {error}; stale socket or permission problem; {hint}"

    def call(self, method: str, **params: Any) -> Json:
        self.counter += 1
        payload = {
            "jsonrpc": "2.0",
            "id": self.counter,
            "method": method,
            "params": {k: v for k, v in params.items() if v is not None},
        }
        self.sock.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode())
        line = self.file.readline()
        if not line:
            raise CoordError("coordinator closed the connection", -32050)
        message = json.loads(line)
        if "error" in message:
            error = message["error"]
            raise CoordError(
                error.get("message", "error"),
                error.get("code", -32000),
                error.get("data"),
            )
        return cast(Json, message.get("result"))

    def close(self) -> None:
        self.file.close()
        self.sock.close()


# ---------------------------------------------------------------- identity of the caller


def detect_client() -> str:
    if os.environ.get("AGENT_COORD_CLIENT"):
        return os.environ["AGENT_COORD_CLIENT"]
    if os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_SESSION_ID"):
        return "claude-code"
    if any(k.startswith("CODEX_") for k in os.environ):
        return "codex"
    return "cli"


def detect_sid(explicit: str | None = None) -> str | None:
    if explicit:
        return explicit
    if os.environ.get("AGENT_COORD_SID"):
        return os.environ["AGENT_COORD_SID"]
    if os.environ.get("CLAUDE_CODE_SESSION_ID"):
        return "cc-" + os.environ["CLAUDE_CODE_SESSION_ID"]
    if os.environ.get("CODEX_THREAD_ID"):
        return "codex-" + os.environ["CODEX_THREAD_ID"]
    return None


def native_id() -> str | None:
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID")


