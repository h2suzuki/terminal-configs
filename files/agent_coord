class ClientAdapter:
    """What differs per agent CLI; everything else is shared. Base = plain CLI / unknown."""

    name = "cli"
    notify = "pull"  # push: a wake channel exists; pull: hooks / polling only
    enforcement = "advisory"  # enforced: the edit gate is a verified hard stop
    edit_tools: frozenset[str] = frozenset()

    def identity_from_env(self, env: dict[str, str]) -> Identity | None:
        return None

    def wake(self, session: Json, text: str) -> bool:
        return False

    def hook_native(self, payload: Json) -> str | None:
        return payload.get("session_id")

    def hook_cwd(self, payload: Json) -> str | None:
        return payload.get("cwd")

    def hook_edit_paths(self, payload: Json) -> list[str]:
        if payload.get("tool_name") not in self.edit_tools:
            return []
        tool_input = payload.get("tool_input") or {}
        target = tool_input.get("file_path") or tool_input.get("notebook_path")
        return [str(target)] if target else []

    def hook_context(self, event: str, text: str) -> Json:
        return {
            "hookSpecificOutput": {"hookEventName": event, "additionalContext": text}
        }

    def hook_deny(self, event: str, reason: str) -> Json:
        return {
            "hookSpecificOutput": {
                "hookEventName": event,
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        }

    def hook_silence(self, event: str) -> Json | None:
        return None

    def hook_role(self, event: str) -> str:
        return {"SessionStart": "start", "SessionEnd": "end", "PreToolUse": "gate"}.get(
            event, "nudge"
        )


class ClaudeCodeAdapter(ClientAdapter):
    name = "claude-code"
    notify = "push"
    enforcement = "enforced"
    edit_tools = frozenset({"Write", "Edit", "MultiEdit", "NotebookEdit"})

    def identity_from_env(self, env: dict[str, str]) -> Identity | None:
        if not (env.get("CLAUDECODE") or env.get("CLAUDE_CODE_SESSION_ID")):
            return None
        return Identity(
            self.name,
            env.get("CLAUDE_CODE_SESSION_ID") or None,
            env.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
        )

    @staticmethod
    def registry_dir() -> Path:
        return Path(
            os.environ.get("AGENT_COORD_CLAUDE_REGISTRY")
            or os.path.expanduser("~/.claude/sessions")
        )

    def inbox(self, native_id: str) -> tuple[str, str | None] | None:
        """The session's inbox socket and auth key from the registry Claude Code publishes."""
        directory = self.registry_dir()
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            return None
        for name in names:
            if not name.endswith(".json"):
                continue
            try:
                with open(directory / name, encoding="utf-8") as stream:
                    record = json.load(stream)
            except (OSError, ValueError):
                continue
            if record.get("sessionId") != native_id or not record.get(
                "messagingSocketPath"
            ):
                continue
            stem = name[: -len(".json")]
            token = None
            for candidate in names:
                if candidate.startswith(stem + ".") and candidate.endswith(".key"):
                    try:
                        token = (
                            (directory / candidate).read_text(encoding="utf-8").strip()
                        )
                    except OSError:
                        token = None
            return str(record["messagingSocketPath"]), token
        return None

    def wake(self, session: Json, text: str) -> bool:
        found = self.inbox(session["native_id"] or "")
        if not found:
            return False
        path, token = found
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.settimeout(5)
            sock.connect(path)
            if token:
                sock.sendall(json_line({"type": "auth", "token": token}).encode())
            message = {"type": "user", "message": {"role": "user", "content": text}}
            sock.sendall(json_line(message).encode())
            return True
        except OSError:
            return False
        finally:
            sock.close()


class CodexAdapter(ClientAdapter):
    name = "codex"
    notify = "push"
    edit_tools = frozenset({"apply_patch", "Write", "Edit"})

    def identity_from_env(self, env: dict[str, str]) -> Identity | None:
        codex_env = any(k.startswith("CODEX_") or k == "PLUGIN_ROOT" for k in env)
        if env.get("CLAUDECODE") or not codex_env:
            return None
        return Identity(self.name, env.get("CODEX_THREAD_ID") or None, os.getcwd())

    def hook_edit_paths(self, payload: Json) -> list[str]:
        if payload.get("tool_name") not in self.edit_tools:
            return []
        if payload.get("tool_name") != "apply_patch":
            return super().hook_edit_paths(payload)
        tool_input = payload.get("tool_input") or {}
        paths = re.findall(
            r"^\*\*\* (?:Update File|Add File|Delete File|Move to): (.+)$",
            str(tool_input.get("command") or tool_input.get("patch") or ""),
            flags=re.MULTILINE,
        )
        base = payload.get("cwd") or os.getcwd()
        return [p if os.path.isabs(p) else os.path.join(base, p) for p in paths]

    def wake(self, session: Json, text: str) -> bool:
        if not session["native_id"]:
            return False
        try:
            proc = subprocess.run(
                ["codex", "queue", "--thread", session["native_id"], "--message", text],
                capture_output=True,
                text=True,
                timeout=15,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            return False
        return proc.returncode == 0


class AntigravityAdapter(ClientAdapter):
    """Hooks speak Antigravity's schema: conversationId / workspacePaths / toolCall / decision."""

    name = "antigravity"
    edit_tools = frozenset(
        {"write_to_file", "replace_file_content", "multi_replace_file_content"}
    )
    PATH_KEYS = ("TargetFile", "AbsolutePath", "target_file", "file_path", "path")

    def hook_native(self, payload: Json) -> str | None:
        return payload.get("conversationId")

    def hook_cwd(self, payload: Json) -> str | None:
        paths = payload.get("workspacePaths") or []
        return str(paths[0]) if paths else None

    def hook_edit_paths(self, payload: Json) -> list[str]:
        call = payload.get("toolCall") or {}
        if call.get("name") not in self.edit_tools:
            return []
        args = call.get("args") or {}
        return [str(args[k]) for k in self.PATH_KEYS if args.get(k)]

    def hook_context(self, event: str, text: str) -> Json:
        return {"injectSteps": [{"ephemeralMessage": text}]}

    def hook_deny(self, event: str, reason: str) -> Json:
        return {"decision": "deny", "reason": reason}

    def hook_silence(self, event: str) -> Json | None:
        return {}

    def hook_role(self, event: str) -> str:
        return {"PreToolUse": "gate", "Stop": "end"}.get(event, "start-or-nudge")


ADAPTERS: dict[str, ClientAdapter] = {
    a.name: a for a in (ClaudeCodeAdapter(), CodexAdapter(), AntigravityAdapter())
}
GENERIC = ClientAdapter()


def adapter_for(client: str | None) -> ClientAdapter:
    return ADAPTERS.get(client or "", GENERIC)


def identity_from_env(explicit_client: str | None = None) -> Identity:
    env = dict(os.environ)
    if explicit_client:
        found = adapter_for(explicit_client).identity_from_env(env)
        return found or Identity(explicit_client, None, os.getcwd())
    if env.get("AGENT_COORD_CLIENT"):
        return Identity(
            env["AGENT_COORD_CLIENT"], env.get("AGENT_COORD_SID"), os.getcwd()
        )
    for adapter in ADAPTERS.values():
        found = adapter.identity_from_env(env)
        if found:
            return found
    return Identity("cli", env.get("AGENT_COORD_SID"), os.getcwd())


