#!/usr/bin/env python3
"""Check a codex order document against the delegation conventions (発注書の規約適合の機械検査).

用途: codex へ委譲する直前の gate。 委譲規律が必須とする節 (スコープ / 成果物 /
作業量上限 / 実行してよい command / 適用される既存裁定 / 出力言語規約 / 所要見積もり)
の有無と、 巡を重ねると食い違う 5 点 (報告書 path・終端 token・見積もりと調査しきい値の
倍率・裁定の採番・kill-by-port 禁止) を検査する。

雛形の生成も本 script が持つ。 規則の持ち主と骨組みの作り手を分けると、 必須節が増えたときに
片方だけ古くなるため。 空欄は `未記入` で置き、 埋め忘れは check_slots が所見にする。

Usage:
  codex_order_lint ORDER.md [ORDER.md ...]
  codex_order_lint --metadata ORDER.md
  codex_order_lint --new plain|fix|review NEW_ORDER.md
  codex_order_lint --selftest

Exit: 0 clean / 1 findings / 2 usage error / 3 --new の書き出し先が既にある。
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
import unittest
from typing import Any

REQUIRED_SECTIONS = (
    "スコープ",
    "成果物",
    "作業量上限",
    "実行してよい command",
    "適用される既存裁定",
    "出力言語規約",
    "所要見積もり",
)

# 雛形が置いた印を読み戻すだけ (語から意図を推測しない)。 fence 内にも置くので fence を見ない。
SLOT = "未記入"
SLOT_PREVIEW = 8

# 生成器を規約の持ち主に同居させる。 別 binary にすると規則と骨組みが乖離する。
TEMPLATE_KINDS = {
    "plain": "template-order.md",
    "fix": "template-fix-order.md",
    "review": "template-review-order.md",
}
TEMPLATE_DIRS = (
    "/etc/claude-code/skills/codex-delegation",
    os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "claude_managed-skills",
        "codex-delegation",
    ),
)

HEADING_RE = re.compile(r"^#{2,}\s+(\S.*?)\s*$")
FENCE_RE = re.compile(r"^\s*```")
REPORT_PATH_RE = re.compile(r"[\w./-]*-report\.md")
TOKEN_RE = re.compile(r"\b([A-Z][A-Z0-9_]{3,})\b")
BAND_RE = re.compile(r"見積もりバンド[^\d]*(\d+)\s*[〜~-]\s*(\d+)\s*分")
THRESHOLD_RE = re.compile(r"調査発動しきい値[^\d]*(\d+)\s*分")
ORDERED_RE = re.compile(r"^(\d+)\.\s")
NO_COMMIT_RE = re.compile(r"(commit|コミット)\s*(も|は)?\s*(しない|禁止)")
REVIEW_KIND_RE = re.compile(r"^review-kind:\s*(\S.*?)\s*$")
SCOPE_RE = re.compile(r"^scope:\s*(\S.*?)\s*$")
SCOPE_REASON_RE = re.compile(r"^scope-reason:\s*(\S.*?)\s*$")
TARGET_RE = re.compile(r"^target:\s*(\S.*?)\s*$")
REVIEW_WORD_RE = re.compile(r"敵対レビュー|adversarial", re.IGNORECASE)
TARGET_VALUE_RE = re.compile(r"^[a-z0-9-]{1,40}$")
FIX_HEADER_RE = re.compile(
    r"^#\s+fix round\s+([1-9][0-9]*)(?:\s*:|\s*$)", re.IGNORECASE
)
VERDICT_ITEMS = (
    "指摘の振り分け",
    "受入判定",
    "構造判定",
    "由来の帰属",
    "上流要件への批評",
    "概念診断",
)
NEGATED_DECLARATION_PATTERN = (
    r"\s*(?:なし|ゼロ|しない|はしない|をしない|ではない|"
    r"は本発注に含まれない|は含まれない|(?:は|を)?持たない|"
    r"(?:は|を)?作らない|(?:廃止)?済み)"
)
MECHANISM_DECLARED_RE = re.compile(rf"機構追加(?!{NEGATED_DECLARATION_PATTERN})")
FIX_METHOD_RE = re.compile(
    rf"仕様縮小|削除|既存集約|機構追加(?!{NEGATED_DECLARATION_PATTERN})"
)
FINDING_LINE_RE = re.compile(r"^\s*(?:[-*]|\d+[.)])\s+.*所見", re.IGNORECASE)
FINDING_NUMBER_RE = re.compile(r"所見\s*([1-9][0-9]*)", re.IGNORECASE)
STRUCTURAL_WARNING = "機構追加が 2 巡連続しています。構造再審を行ってください。"
# 適用有無は書き手が節で宣言する。 語の出現で引くと普通の日本語に発火する (2026-08-23 実測)。
INVENTORY_SECTIONS = (
    ("全数列挙", "状態を持たないなら「該当なし」と書く"),
    ("依存閉包棚卸し", "廃止・撤去を伴わないなら「該当なし」と書く"),
)


def outside_fences(lines: list[str]) -> list[int]:
    """Indices of the lines that are not inside a ``` fence."""
    live, fenced = [], False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            live.append(i)
    return live


def sections(lines: list[str]) -> list[tuple[str, int, int]]:
    """[(heading, first body line, end line)] for every heading outside a fence."""
    live = set(outside_fences(lines))
    marks = [
        (i, m.group(1))
        for i, line in enumerate(lines)
        if i in live and (m := HEADING_RE.match(line))
    ]
    return [
        (name, i + 1, marks[k + 1][0] if k + 1 < len(marks) else len(lines))
        for k, (i, name) in enumerate(marks)
    ]


def body(lines: list[str], found: list[tuple[str, int, int]], prefix: str) -> list[str]:
    """Lines of the first section whose heading starts with prefix, [] if absent."""
    return next(
        (lines[start:end] for name, start, end in found if name.startswith(prefix)),
        [],
    )


def check_sections(found: list[tuple[str, int, int]]) -> list[str]:
    return [
        f"必須の節がない: ## {prefix}"
        for prefix in REQUIRED_SECTIONS
        if not any(name.startswith(prefix) for name, _, _ in found)
    ]


def check_slots(lines: list[str]) -> list[str]:
    """雛形の空欄が埋まっていない箇所。 節の本文を読まない検査群の死角を塞ぐ。"""
    marked = [index + 1 for index, line in enumerate(lines) if SLOT in line]
    if not marked:
        return []
    shown = ", ".join(f"L{number}" for number in marked[:SLOT_PREVIEW])
    rest = f" 他 {len(marked) - SLOT_PREVIEW} 行" if len(marked) > SLOT_PREVIEW else ""
    return [f"{SLOT} の slot が {len(marked)} 件残っている: {shown}{rest}"]


def check_report_path(lines: list[str]) -> list[str]:
    paths = {m.group(0) for line in lines for m in REPORT_PATH_RE.finditer(line)}
    if not paths:
        return ["報告書 path (*-report.md) が 1 度も書かれていない"]
    if len(paths) > 1:
        return [f"報告書 path が食い違う: {' / '.join(sorted(paths))}"]
    return []


def check_terminal_token(lines: list[str]) -> list[str]:
    named = [
        m.group(1)
        for i in outside_fences(lines)
        if "最終行" in lines[i]
        for m in TOKEN_RE.finditer(lines[i])
    ]
    if not named:
        return ["報告書の最終行に置く終端 token が指定されていない"]
    # 書式例にも現れていなければ、 発注文だけの約束で終わっている。
    if len(re.findall(rf"\b{re.escape(named[0])}\b", "\n".join(lines))) < 2:
        return [f"終端 token {named[0]} が報告書の書式例に現れない"]
    return []


def check_estimate(lines: list[str]) -> list[str]:
    whole = "\n".join(lines)
    band, threshold = BAND_RE.search(whole), THRESHOLD_RE.search(whole)
    if not band:
        return ["見積もりバンド (N〜M 分) が無い"]
    if not threshold:
        return ["調査発動しきい値 (K 分) が無い"]
    upper, fired = int(band.group(2)), int(threshold.group(1))
    if fired != upper * 2:
        return [f"調査発動しきい値 {fired} 分が見積もり上限 {upper} 分の 2 倍でない"]
    return []


def first_break(numbers: list[int]) -> str:
    """The first item whose number is not its position, as `位置 N -> 記載 M`."""
    return next(
        (f"位置 {i} -> 記載 {n}" for i, n in enumerate(numbers, 1) if i != n),
        "末尾",
    )


def check_rulings(section: list[str]) -> list[str]:
    # 裁定が引用する fence 内の番号付き例を裁定に数えると、 採番検査が偽陽性になる。
    live = [section[i] for i in outside_fences(section)]
    numbers = [int(m.group(1)) for line in live if (m := ORDERED_RE.match(line))]
    if not numbers:
        return ["適用される既存裁定が 1 件も列挙されていない"]
    if numbers != list(range(1, len(numbers) + 1)):
        return [
            f"裁定の採番が 1..{len(numbers)} の昇順でない "
            f"(重複・欠番・並び違い: {first_break(numbers)})"
        ]
    return []


def check_prohibitions(lines: list[str]) -> list[str]:
    whole = "\n".join(lines)
    stated = {
        "kill-by-port (fuser -k / pkill) の禁止が書かれていない": "fuser -k" in whole
        and "pkill" in whole,
        "commit しない旨が書かれていない": bool(NO_COMMIT_RE.search(whole)),
        "触らない path が明示されていない": "触らない" in whole,
    }
    return [message for message, said in stated.items() if not said]


def check_command_fence(section: list[str]) -> list[str]:
    if not any(FENCE_RE.match(line) for line in section):
        return ["実行してよい command が code fence で列挙されていない"]
    return []


def metadata_values(lines: list[str], pattern: re.Pattern[str]) -> list[str]:
    """行頭メタデータの値。 code fence 内の例は申告として扱わない。"""
    return [
        match.group(1)
        for index in outside_fences(lines)
        if (match := pattern.match(lines[index]))
    ]


def level_two_body(
    lines: list[str], heading: str, *, prefix: bool = False
) -> list[str] | None:
    """level 2 見出しに一致する最初の本文。"""
    live = set(outside_fences(lines))
    start = next(
        (
            index + 1
            for index, line in enumerate(lines)
            if index in live
            and (
                line.strip().startswith(f"## {heading}")
                if prefix
                else line.strip() == f"## {heading}"
            )
        ),
        None,
    )
    if start is None:
        return None
    end = next(
        (
            index
            for index in range(start, len(lines))
            if index in live and HEADING_RE.match(lines[index])
        ),
        len(lines),
    )
    return lines[start:end]


def has_nonempty_section(lines: list[str], prefix: str) -> bool:
    section = level_two_body(lines, prefix, prefix=True)
    return section is not None and any(line.strip() for line in section)


def fix_round_values(lines: list[str]) -> list[int]:
    """H1 の fix round 宣言。 code fence 内の例は申告として扱わない。"""
    return [
        int(match.group(1))
        for index in outside_fences(lines)
        if (match := FIX_HEADER_RE.match(lines[index]))
    ]


def fix_method_entries(lines: list[str]) -> list[str]:
    method = level_two_body(lines, "修正方式")
    if method is None:
        return []
    return [
        method[index]
        for index in outside_fences(method)
        if FINDING_LINE_RE.match(method[index])
    ]


def declared_fix_rounds(path: str) -> tuple[dict[int, list[str]], list[str]]:
    """同じ directory の regular Markdown file にある fix round 宣言。"""
    rounds: dict[int, list[str]] = {}
    errors: list[str] = []
    directory = os.path.dirname(os.path.abspath(path)) or os.curdir
    try:
        entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
    except OSError as error:
        return rounds, [f"fix 発注書 directory を列挙できない ({error})"]
    for entry in entries:
        if not entry.name.endswith(".md") or not entry.is_file(follow_symlinks=True):
            continue
        try:
            with open(entry.path, encoding="utf-8") as handle:
                sibling_lines = handle.read().splitlines()
        except (OSError, UnicodeDecodeError) as error:
            errors.append(f"既存発注書 {entry.path} を読めない ({error})")
            continue
        for number in fix_round_values(sibling_lines):
            rounds.setdefault(number, []).append(os.path.abspath(entry.path))
    return rounds, errors


def check_fix_round_sequence(path: str, current: int) -> list[str]:
    if not path or not os.path.isfile(path):
        return []
    rounds, findings = declared_fix_rounds(path)
    duplicates = [number for number, paths in rounds.items() if len(paths) != 1]
    if duplicates:
        findings.append(
            "fix round が重複している: " + " / ".join(map(str, sorted(duplicates)))
        )
    missing = [number for number in range(1, current + 1) if number not in rounds]
    if missing:
        findings.append("fix round が欠番: " + " / ".join(map(str, missing)))
    later = sorted(number for number in rounds if number > current)
    if later:
        findings.append(
            f"fix round {current} は既存の後続巡 "
            + " / ".join(map(str, later))
            + " より逆行している"
        )
    return findings


def fix_methods(lines: list[str]) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    for entry in fix_method_entries(lines):
        number = FINDING_NUMBER_RE.search(entry)
        methods = list(dict.fromkeys(FIX_METHOD_RE.findall(entry)))
        result.append(
            {
                "finding": int(number.group(1)) if number else None,
                "methods": methods,
            }
        )
    return result


def lint_metadata(text: str, path: str, findings: list[str]) -> dict[str, Any]:
    lines = text.splitlines()
    rounds = fix_round_values(lines)
    kinds = metadata_values(lines, REVIEW_KIND_RE)
    scopes = metadata_values(lines, SCOPE_RE)
    report_paths = sorted(
        {match.group(0) for line in lines for match in REPORT_PATH_RE.finditer(line)}
    )
    has_order_marker = bool(kinds) or any(
        name.startswith(REQUIRED_SECTIONS) for name, _, _ in sections(lines)
    )
    return {
        "path": os.path.abspath(path),
        "order_document": has_order_marker,
        "review_kind": kinds[0] if len(kinds) == 1 else None,
        "round": rounds[0] if len(rounds) == 1 else None,
        "scope": scopes[0] if len(scopes) == 1 else None,
        "methods": fix_methods(lines),
        "has_previous_verdict": level_two_body(lines, "前巡 verdict") is not None,
        "report_path": report_paths[0] if len(report_paths) == 1 else None,
        "findings": findings,
    }


def structural_warnings(text: str, path: str) -> list[str]:
    lines = text.splitlines()
    rounds = fix_round_values(lines)
    current_entries = fix_method_entries(lines)
    if len(rounds) != 1 or not any(
        MECHANISM_DECLARED_RE.search(entry) for entry in current_entries
    ):
        return []
    previous = rounds[0] - 1
    if previous < 1 or not path or not os.path.isfile(path):
        return []
    declared, _ = declared_fix_rounds(path)
    previous_paths = declared.get(previous, [])
    if len(previous_paths) != 1:
        return []
    if not os.path.isfile(previous_paths[0]):
        return []
    try:
        with open(previous_paths[0], encoding="utf-8") as handle:
            previous_entries = fix_method_entries(handle.read().splitlines())
    except (OSError, UnicodeDecodeError):
        return []
    return (
        [STRUCTURAL_WARNING]
        if any(MECHANISM_DECLARED_RE.search(entry) for entry in previous_entries)
        else []
    )


def check_review_contract(lines: list[str]) -> list[str]:
    kinds = metadata_values(lines, REVIEW_KIND_RE)
    if len(kinds) != 1 or kinds[0] not in {"adversarial", "acceptance", "none"}:
        return ["review-kind: adversarial|acceptance|none を行頭形式で 1 行指定せよ"]
    kind = kinds[0]
    findings: list[str] = []
    live_text = "\n".join(lines[index] for index in outside_fences(lines))
    if kind == "none" and REVIEW_WORD_RE.search(live_text):
        findings.append(
            "review-kind: none と本文の敵対レビュー / adversarial 指定が一致しない"
        )
    if kind == "none":
        return findings
    inventory = level_two_body(lines, "既製手段の棚卸し")
    if inventory is None or not any(line.strip() for line in inventory):
        findings.append(
            "## 既製手段の棚卸し に検討した既製 command/skill と不使用理由を列挙せよ"
        )
    scopes = metadata_values(lines, SCOPE_RE)
    if len(scopes) != 1 or scopes[0] not in {"diff", "artifact"}:
        findings.append("scope: diff|artifact を行頭形式で 1 行指定せよ")
    elif scopes[0] == "artifact":
        reasons = metadata_values(lines, SCOPE_REASON_RE)
        if len(reasons) != 1:
            findings.append(
                "scope: artifact には非空の scope-reason: を行頭形式で 1 行指定せよ"
            )
    targets = metadata_values(lines, TARGET_RE)
    if len(targets) != 1 or not TARGET_VALUE_RE.fullmatch(targets[0]):
        findings.append("target: <slug> を [a-z0-9-]{1,40} で 1 行指定せよ")
    missing_verdict = [item for item in VERDICT_ITEMS if item not in live_text]
    if missing_verdict:
        findings.append(
            "報告書の verdict 要件が不足している: " + " / ".join(missing_verdict)
        )
    return findings


def check_fix_contract(lines: list[str], path: str) -> list[str]:
    rounds = fix_round_values(lines)
    method = level_two_body(lines, "修正方式")
    if not rounds and method is None:
        return []
    findings: list[str] = []
    kinds = metadata_values(lines, REVIEW_KIND_RE)
    if len(kinds) != 1 or kinds[0] != "none":
        findings.append("fix 発注書は review-kind: none と fix round header を指定せよ")
    if len(rounds) != 1:
        findings.append("fix 発注書は # fix round N: の H1 header を 1 行指定せよ")
    else:
        findings.extend(check_fix_round_sequence(path, rounds[0]))
        if rounds[0] >= 2:
            previous = level_two_body(lines, "前巡 verdict")
            if previous is None or not any(line.strip() for line in previous):
                findings.append("fix round 2 以上には必須の節がない: ## 前巡 verdict")
    if kinds == ["none"] and not has_nonempty_section(lines, "2 方向分析"):
        findings.append("fix 発注書に必須の節がない: ## 2 方向分析")
    if method is None:
        findings.append("fix 発注書に必須の節がない: ## 修正方式")
    else:
        live = [method[index] for index in outside_fences(method)]
        entries = fix_method_entries(lines)
        if not entries or any(not FIX_METHOD_RE.search(line) for line in entries):
            findings.append(
                "## 修正方式 で各所見に 仕様縮小 / 削除 / 既存集約 / 機構追加を列挙せよ"
            )
        whole = "\n".join(live)
        mechanism_declared = any(MECHANISM_DECLARED_RE.search(line) for line in live)
        if mechanism_declared:
            missing = [
                word
                for word in ("観測", "分岐", "資源", "failure mode", "test")
                if word not in whole
            ]
            if missing:
                findings.append(
                    "機構追加には追加する観測 / 分岐 / 資源と各 failure mode + 対応 test を"
                    "列挙せよ (不足: " + " / ".join(missing) + ")"
                )
            if not has_nonempty_section(lines, "既存保証の監査"):
                findings.append("機構追加には必須の節がない: ## 既存保証の監査")
    findings.extend(
        f"fix 発注書に必須の節がない: ## {section} ({hint})"
        for section, hint in INVENTORY_SECTIONS
        if not has_nonempty_section(lines, section)
    )
    sweep = level_two_body(lines, "掃引")
    if sweep is None or not any(line.strip() for line in sweep):
        findings.append(
            "## 掃引 に各所見の欠陥定義 1 行と、同欠陥の全 site を機械列挙する"
            " grep/AST command と結果、または単一 site である根拠を記載せよ。"
            "指摘 site だけの修正による配り漏れと多巡消費を防ぐため class 単位で掃引せよ"
        )
    return findings


def lint(text: str, path: str = "") -> list[str]:
    """Every convention breach in one order document."""
    lines = text.splitlines()
    found = sections(lines)
    return [
        *check_slots(lines),
        *check_review_contract(lines),
        *check_sections(found),
        *check_report_path(lines),
        *check_terminal_token(lines),
        *check_estimate(lines),
        *check_rulings(body(lines, found, "適用される既存裁定")),
        *check_prohibitions(lines),
        *check_command_fence(body(lines, found, "実行してよい command")),
        *check_fix_contract(lines, path),
    ]


