            with self.subTest(kind=kind):
                findings = lint(self._text(kind))
                self.assertTrue(findings[0].startswith(f"{SLOT} の slot が"))

    def test_every_template_is_completable(self):
        for kind in TEMPLATE_KINDS:
            with self.subTest(kind=kind):
                self.assertEqual(lint(self._fill(self._text(kind))), [])

    def test_fix_template_round_header_stays_inert(self):
        # 文字どおりの N は申告に数えない。 数えると実在の round 1 が「重複」で落ちる。
        self.assertEqual(fix_round_values(self._text("fix").splitlines()), [])

    def test_new_derives_from_the_path_and_refuses_to_clobber(self):
        import io
        from contextlib import redirect_stdout

        self._text("plain")
        directory = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, directory, True)
        target = os.path.join(directory, "sample-order.md")
        with redirect_stdout(io.StringIO()):
            self.assertEqual(main(["--new", "plain", target]), 0)
            with open(target, encoding="utf-8") as handle:
                seeded = handle.read()
            self.assertEqual(main(["--new", "plain", target]), 3)
        self.assertIn("# 発注書: sample-order", seeded)
        self.assertIn(os.path.join(directory, "sample-order-report.md"), seeded)

    def test_new_fix_numbers_the_round_from_its_siblings(self):
        import io
        from contextlib import redirect_stdout

        self._text("fix")
        directory = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, directory, True)
        with redirect_stdout(io.StringIO()):
            main(["--new", "fix", os.path.join(directory, "first.md")])
            main(["--new", "fix", os.path.join(directory, "second.md")])
        with open(os.path.join(directory, "first.md"), encoding="utf-8") as handle:
            first = handle.read()
        with open(os.path.join(directory, "second.md"), encoding="utf-8") as handle:
            second = handle.read()
        self.assertIn("# fix round 1: first", first)
        self.assertNotIn("前巡 verdict", first)  # 1 巡目に前巡は無い
        self.assertIn("# fix round 2: second", second)
        self.assertIn("前巡 verdict", second)


def template_source(kind: str) -> str | None:
    """雛形の実体。 配備先を先に見て、 repo から直接動かす場合は隣を見る。"""
    name = TEMPLATE_KINDS[kind]
    return next(
        (
            path
            for directory in TEMPLATE_DIRS
            if os.path.isfile(path := os.path.join(directory, name))
        ),
        None,
    )


def drop_section(text: str, heading: str) -> str:
    lines = text.splitlines(keepends=True)
    start = next(
        (i for i, line in enumerate(lines) if line.strip() == f"## {heading}"), None
    )
    if start is None:
        return text
    end = next(
        (i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")),
        len(lines),
    )
    return "".join(lines[:start] + lines[end:])


def seed_order(kind: str, path: str) -> str:
    """雛形を、 著者が選んだ path から決まる値だけ埋めた本文。"""
    source = template_source(kind)
    if source is None:
        raise FileNotFoundError(TEMPLATE_KINDS[kind])
    with open(source, encoding="utf-8") as handle:
        text = handle.read()
    stem = os.path.splitext(os.path.basename(path))[0]
    directory = os.path.dirname(path)
    text = text.replace(
        f"{SLOT}-report.md", os.path.join(directory, f"{stem}-report.md")
    )
    text = text.replace(
        f"{SLOT}-probe.txt", os.path.join(directory, f"{stem}-probe.txt")
    )
    text = text.replace(f"# {SLOT} 報告書", f"# {stem} 報告書")
    if kind == "fix":
        # 巡番号は検査器自身の申告集計から採る。 欠番・重複・逆行を作れない唯一の取り方。
        rounds, _ = declared_fix_rounds(path)
        number = max(rounds, default=0) + 1
        text = text.replace("# fix round N:", f"# fix round {number}:")
        if number == 1:
            text = drop_section(text, "前巡 verdict")
    return text.replace(f": {SLOT}\n", f": {stem}\n", 1)


def write_new_order(kind: str, path: str) -> int:
    if os.path.exists(path):
        print(f"{path}: 既にあるので上書きしない")
        return 3
    try:
        text = seed_order(kind, path)
    except FileNotFoundError as error:
        print(f"雛形が見つからない: {error}")
        return 2
    try:
        if directory := os.path.dirname(path):
            os.makedirs(directory, exist_ok=True)
        with open(path, "x", encoding="utf-8") as handle:
            handle.write(text)
    except OSError as error:
        print(f"{path}: 書けない ({error.strerror})")
        return 2
    print(f"{path}: {TEMPLATE_KINDS[kind]} から作成した")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Lint a codex order document.")
    parser.add_argument("paths", nargs="*", help="order documents to check")
    parser.add_argument(
        "--metadata", action="store_true", help="emit one JSON object per document"
    )
    parser.add_argument(
        "--new",
        choices=tuple(TEMPLATE_KINDS),
        metavar="KIND",
        help="雛形から骨組みを書き出す (plain|fix|review)",
    )
    parser.add_argument(
        "--selftest", action="store_true", help="run the built-in tests"
    )
    args = parser.parse_args(argv)

    if args.new:
        if len(args.paths) != 1:
            parser.error("--new は書き出す path を 1 つ取る")
        return write_new_order(args.new, args.paths[0])
    if args.selftest:
        loaded = unittest.defaultTestLoader.loadTestsFromNames(
            [f"{__name__}.LintTest", f"{__name__}.TemplateTest"]
        )
        return 0 if unittest.TextTestRunner().run(loaded).wasSuccessful() else 1
    if not args.paths:
        parser.error("give at least one order document, or --selftest")

    total = 0
    for path in args.paths:
        if not os.path.isfile(path):
            print(f"{path}: regular file でないため読めない")
            return 2
        try:
            with open(path, encoding="utf-8") as handle:
                text = handle.read()
        except OSError as err:
            print(f"{path}: 読めない ({err.strerror})")
            return 2
        except UnicodeDecodeError:
            print(f"{path}: UTF-8 として読めない")
            return 2
        findings = lint(text, path)
        for warning in structural_warnings(text, path):
            print(f"{path}: warning: {warning}", file=sys.stderr)
        if args.metadata:
            print(json.dumps(lint_metadata(text, path, findings), ensure_ascii=False))
        else:
            for finding in findings:
                print(f"{path}: {finding}")
        total += len(findings)
    if total and not args.metadata:
        print(f"{total} 件の規約違反")
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
