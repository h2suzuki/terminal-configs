#!/usr/bin/env python3
"""Check a codex order document against the delegation conventions (発注書の規約適合の機械検査).

用途: codex へ委譲する直前の gate。 委譲規律が必須とする節 (スコープ / 成果物 /
作業量上限 / 実行してよい command / 適用される既存裁定 / 出力言語規約 / 所要見積もり)
の有無と、 巡を重ねると食い違いやすい点 (報告書 path・終端 token・見積もりバンド・
裁定の列挙・kill-by-port 禁止・fix round の重複) を検査する。

雛形の生成も本 script が持つ。 規則の持ち主と骨組みの作り手を分けると、 必須節が増えたときに
片方だけ古くなるため。 空欄は `未記入` で置き、 埋め忘れは check_slots が所見にする。

Usage:
  codex_order_lint ORDER.md [ORDER.md ...]
  codex_order_lint --metadata ORDER.md
  codex_order_lint --new plain|fix|review NEW_ORDER.md

Exit: 0 clean / 1 findings / 2 usage・読み取りエラー / 3 --new の書き出し先が既にある。
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from typing import Any

REQUIRED_SECTIONS = (
    "スコープ",
    "成果物",
    "作業量上限",
    "実行してよい command",
    "適用される既存裁定",
    "出力言語規約",
    "所要見積もり",
)

# 雛形が置いた印を読み戻すだけ (語から意図を推測しない)。 fence 内にも置くので fence を見ない。
SLOT = "未記入"
SLOT_PREVIEW = 8

TEMPLATE_KINDS = {
    "plain": "template-order.md",
    "fix": "template-fix-order.md",
    "review": "template-review-order.md",
}
TEMPLATE_DIRS = (
    os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "claude_managed-skills",
        "codex-delegation",
    ),
    "/etc/claude-code/skills/codex-delegation",
)

HEADING_RE = re.compile(r"^#{2,}\s+(\S.*?)\s*$")
LEVEL_TWO_END_RE = re.compile(r"^#{1,2}\s")
FENCE_RE = re.compile(r"^\s*```")
REPORT_PATH_RE = re.compile(r"[\w./-]*-report\.md")
TOKEN_RE = re.compile(r"\b([A-Z][A-Z0-9_]{3,})\b")
BAND_RE = re.compile(r"見積もりバンド[^\d]*(\d+)\s*[〜~-]\s*(\d+)\s*分")
THRESHOLD_RE = re.compile(r"調査発動しきい値[^\d]*(\d+)\s*分")
ORDERED_RE = re.compile(r"^(\d+)\.\s")
NO_COMMIT_RE = re.compile(r"(commit|コミット)\s*(も|は)?\s*(しない|禁止)")
REVIEW_KIND_RE = re.compile(r"^review-kind:\s*(\S.*?)\s*$")
SCOPE_RE = re.compile(r"^scope:\s*(\S.*?)\s*$")
FIX_HEADER_RE = re.compile(
    r"^#\s+fix round\s+([1-9][0-9]*)(?:\s*:|\s*$)", re.IGNORECASE
)
NEGATED_DECLARATION_PATTERN = (
    r"\s*(?:なし|ゼロ|しない|はしない|をしない|ではない|"
    r"は本発注に含まれない|は含まれない|(?:は|を)?持たない|"
    r"(?:は|を)?作らない|(?:廃止)?済み)"
)
FIX_METHOD_RE = re.compile(
    rf"仕様縮小|削除|既存集約|機構追加(?!{NEGATED_DECLARATION_PATTERN})"
)
FINDING_LINE_RE = re.compile(r"^\s*(?:[-*]|\d+[.)])\s+.*所見", re.IGNORECASE)
FINDING_NUMBER_RE = re.compile(r"所見\s*([1-9][0-9]*)", re.IGNORECASE)

KIND = "review-kind: adversarial|acceptance|none を行頭形式で 1 行指定せよ"
NO_INVENTORY = "## 既製手段の棚卸し に検討した既製 command/skill と不使用理由を列挙せよ"
NO_SCOPE = "scope: diff|artifact を行頭形式で 1 行指定せよ"
NO_REPORT = "報告書 path (*-report.md) が 1 度も書かれていない"
NO_TOKEN = "報告書の最終行に置く終端 token が指定されていない"
NO_BAND = "見積もりバンド (N〜M 分) が無い"
NO_THRESHOLD = "調査発動しきい値 (K 分) が無い"
NO_RULING = "適用される既存裁定が 1 件も列挙されていない"
NO_KILL = "kill-by-port (fuser -k / pkill) の禁止が書かれていない"
NO_COMMIT = "commit しない旨が書かれていない"
NO_TOUCH = "触らない path が明示されていない"
NO_FENCE = "実行してよい command が code fence で列挙されていない"
FIX_KIND = "fix 発注書は review-kind: none と fix round header を指定せよ"
FIX_HEADER = "fix 発注書は # fix round N: の H1 header を 1 行指定せよ"
FIX_PREVIOUS = "fix round 2 以上には必須の節がない: ## 前巡 verdict"
FIX_TWOWAY = "fix 発注書に必須の節がない: ## 2 方向分析"
FIX_METHOD_SECTION = "fix 発注書に必須の節がない: ## 修正方式"
FIX_METHOD = "## 修正方式 で各所見に 仕様縮小 / 削除 / 既存集約 / 機構追加を列挙せよ"
SWEEP = (
    "## 掃引 に各所見の欠陥定義 1 行と、同欠陥の全 site を機械列挙する grep/AST command と結果、"
    "または単一 site である根拠を記載せよ。指摘 site だけの修正による配り漏れと多巡消費を防ぐため"
    "class 単位で掃引せよ"
)
TREATMENTS = ("削除・縮小", "契約の訂正", "構造化", "bounded-risk 受入", "廃棄")
TREATMENT_MIN_ROUND = 3
TREATMENT_MISSING = (
    f"fix round {TREATMENT_MIN_ROUND} 以上には必須の節がない: ## 処置の種別 ("
    + " / ".join(TREATMENTS)
    + " の 1 つを名乗る)"
)
TREATMENT_CHOICE = (
    "## 処置の種別 で " + " / ".join(TREATMENTS) + " のちょうど 1 つを名乗れ"
)


def outside_fences(lines: list[str]) -> list[int]:
    """Indices of the lines that are not inside a ``` fence."""
    live, fenced = [], False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            live.append(i)
    return live


def sections(lines: list[str]) -> list[tuple[str, int, int]]:
    """[(heading, first body line, end line)] for every heading outside a fence."""
    live = set(outside_fences(lines))
    marks = [
        (i, m.group(1), len(line) - len(line.lstrip("#")))
        for i, line in enumerate(lines)
        if i in live and (m := HEADING_RE.match(line))
    ]
    return [
        (
            name,
            i + 1,
            next((j for j, _n, d in marks[k + 1 :] if d <= depth), len(lines)),
        )
        for k, (i, name, depth) in enumerate(marks)
    ]


def body(lines: list[str], found: list[tuple[str, int, int]], prefix: str) -> list[str]:
    """Lines of the first section whose heading starts with prefix, [] if absent."""
    return next(
        (lines[start:end] for name, start, end in found if name.startswith(prefix)),
        [],
    )


def check_sections(found: list[tuple[str, int, int]]) -> list[str]:
    return [
        f"必須の節がない: ## {prefix}"
        for prefix in REQUIRED_SECTIONS
        if not any(name.startswith(prefix) for name, _, _ in found)
    ]


def check_slots(lines: list[str]) -> list[str]:
    """雛形の空欄が埋まっていない箇所。 節の本文を読まない検査群の死角を塞ぐ。"""
    marked = [index + 1 for index, line in enumerate(lines) if SLOT in line]
    if not marked:
        return []
    shown = ", ".join(f"L{number}" for number in marked[:SLOT_PREVIEW])
    rest = f" 他 {len(marked) - SLOT_PREVIEW} 行" if len(marked) > SLOT_PREVIEW else ""
    return [f"{SLOT} の slot が {len(marked)} 件残っている: {shown}{rest}"]


def level_two_body(
    lines: list[str], heading: str, *, prefix: bool = False
) -> list[str] | None:
    """level 2 見出しに一致する最初の本文。"""
    live = set(outside_fences(lines))
    start = next(
        (
            index + 1
            for index, line in enumerate(lines)
            if index in live
            and (
                line.strip().startswith(f"## {heading}")
                if prefix
                else line.strip() == f"## {heading}"
            )
        ),
        None,
    )
    if start is None:
        return None
    end = next(
        (
            index
            for index in range(start, len(lines))
            if index in live and LEVEL_TWO_END_RE.match(lines[index])
        ),
        len(lines),
    )
    return lines[start:end]


def has_nonempty_section(lines: list[str], heading: str) -> bool:
    section = level_two_body(lines, heading, prefix=True)
    return section is not None and any(line.strip() for line in section)


def metadata_values(lines: list[str], pattern: re.Pattern[str]) -> list[str]:
    """行頭メタデータの値。 code fence 内の例は申告として扱わない。"""
    return [
        match.group(1)
        for index in outside_fences(lines)
        if (match := pattern.match(lines[index]))
    ]


def fix_round_values(lines: list[str]) -> list[int]:
    """H1 の fix round 宣言。 code fence 内の例は申告として扱わない。"""
    return [
        int(match.group(1))
        for index in outside_fences(lines)
        if (match := FIX_HEADER_RE.match(lines[index]))
    ]


def check_report_path(lines: list[str]) -> list[str]:
    paths = {m.group(0) for line in lines for m in REPORT_PATH_RE.finditer(line)}
    if not paths:
        return [NO_REPORT]
    if len(paths) > 1:
        return [f"報告書 path が食い違う: {' / '.join(sorted(paths))}"]
    return []


def check_terminal_token(lines: list[str]) -> list[str]:
    found = any(
        TOKEN_RE.search(lines[index])
        for index in outside_fences(lines)
        if "最終行" in lines[index]
    )
    return [] if found else [NO_TOKEN]


def check_estimate(lines: list[str]) -> list[str]:
    whole = "\n".join(lines)
    if not BAND_RE.search(whole):
        return [NO_BAND]
    if not THRESHOLD_RE.search(whole):
        return [NO_THRESHOLD]
    return []


def check_rulings(lines: list[str]) -> list[str]:
    """裁定節の本文 (fence 外) に番号付き item が 1 件以上あるか。"""
    live = [lines[index] for index in outside_fences(lines)]
    if any(ORDERED_RE.match(line) for line in live):
        return []
    return [NO_RULING]


def check_prohibitions(lines: list[str]) -> list[str]:
    whole = "\n".join(lines[index] for index in outside_fences(lines))
    stated = {
        NO_KILL: "fuser -k" in whole and "pkill" in whole,
        NO_COMMIT: bool(NO_COMMIT_RE.search(whole)),
        NO_TOUCH: "触らない" in whole,
    }
    return [message for message, said in stated.items() if not said]


def check_command_fence(section: list[str]) -> list[str]:
    if not any(FENCE_RE.match(line) for line in section):
        return [NO_FENCE]
    return []


def check_review_contract(lines: list[str]) -> list[str]:
    kinds = metadata_values(lines, REVIEW_KIND_RE)
    if len(kinds) != 1 or kinds[0] not in {"adversarial", "acceptance", "none"}:
        return [KIND]
    if kinds[0] == "none":
        return []
    findings: list[str] = []
    if not has_nonempty_section(lines, "既製手段の棚卸し"):
        findings.append(NO_INVENTORY)
    scopes = metadata_values(lines, SCOPE_RE)
    if len(scopes) != 1 or scopes[0] not in {"diff", "artifact"}:
        findings.append(NO_SCOPE)
    return findings


def fix_method_entries(lines: list[str]) -> list[str]:
    method = level_two_body(lines, "修正方式", prefix=True)
    if method is None:
        return []
    return [
        method[index]
        for index in outside_fences(method)
        if FINDING_LINE_RE.match(method[index])
    ]


def fix_methods(lines: list[str]) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    for entry in fix_method_entries(lines):
        number = FINDING_NUMBER_RE.search(entry)
        methods = list(dict.fromkeys(FIX_METHOD_RE.findall(entry)))
        result.append(
            {"finding": int(number.group(1)) if number else None, "methods": methods}
        )
    return result


def declared_fix_rounds(path: str) -> dict[int, list[str]]:
    """同じ directory の regular Markdown file にある fix round 宣言 (自分自身も含む)。"""
    rounds: dict[int, list[str]] = {}
    directory = os.path.dirname(os.path.abspath(path)) or os.curdir
    try:
        entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
    except OSError:
        return rounds
    for entry in entries:
        if not entry.name.endswith(".md") or not entry.is_file(follow_symlinks=True):
            continue
        try:
            with open(entry.path, encoding="utf-8") as handle:
                sibling_lines = handle.read().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        for number in fix_round_values(sibling_lines):
            rounds.setdefault(number, []).append(os.path.abspath(entry.path))
    return rounds


def check_fix_round_duplicates(path: str) -> list[str]:
    if not path or not os.path.isfile(path):
        return []
    rounds = declared_fix_rounds(path)
    duplicates = sorted(number for number, paths in rounds.items() if len(paths) != 1)
    if not duplicates:
        return []
    return ["fix round が重複している: " + " / ".join(map(str, duplicates))]


def check_treatment(lines: list[str]) -> list[str]:
    if not has_nonempty_section(lines, "処置の種別"):
        return [TREATMENT_MISSING]
    text = "\n".join(level_two_body(lines, "処置の種別", prefix=True) or [])
    named = [option for option in TREATMENTS if option in text]
    return [] if len(named) == 1 else [TREATMENT_CHOICE]


def check_fix_contract(lines: list[str], path: str) -> list[str]:
    rounds = fix_round_values(lines)
    method = level_two_body(lines, "修正方式", prefix=True)
    if not rounds and method is None:
        return []
    findings: list[str] = []
    kinds = metadata_values(lines, REVIEW_KIND_RE)
    if len(kinds) != 1 or kinds[0] != "none":
        findings.append(FIX_KIND)
    current = rounds[0] if len(rounds) == 1 else None
    if current is None:
        findings.append(FIX_HEADER)
    else:
        findings.extend(check_fix_round_duplicates(path))
        if current >= 2 and not has_nonempty_section(lines, "前巡 verdict"):
            findings.append(FIX_PREVIOUS)
    if not has_nonempty_section(lines, "2 方向分析"):
        findings.append(FIX_TWOWAY)
    if method is None:
        findings.append(FIX_METHOD_SECTION)
    else:
        entries = fix_method_entries(lines)
        if not entries or any(not FIX_METHOD_RE.search(entry) for entry in entries):
            findings.append(FIX_METHOD)
    if not has_nonempty_section(lines, "掃引"):
        findings.append(SWEEP)
    if current is not None and current >= TREATMENT_MIN_ROUND:
        findings.extend(check_treatment(lines))
    return findings


def lint(text: str, path: str = "") -> list[str]:
    """Every convention breach in one order document, in a fixed order."""
    lines = text.splitlines()
    found = sections(lines)
    return [
        *check_slots(lines),
        *check_review_contract(lines),
        *check_sections(found),
        *check_report_path(lines),
        *check_terminal_token(lines),
        *check_estimate(lines),
        *check_rulings(body(lines, found, "適用される既存裁定")),
        *check_prohibitions(lines),
        *check_command_fence(body(lines, found, "実行してよい command")),
        *check_fix_contract(lines, path),
    ]


def metadata_record(text: str, path: str, findings: list[str]) -> dict[str, Any]:
    lines = text.splitlines()
    rounds = fix_round_values(lines)
    kinds = metadata_values(lines, REVIEW_KIND_RE)
    scopes = metadata_values(lines, SCOPE_RE)
    report_paths = sorted(
        {match.group(0) for line in lines for match in REPORT_PATH_RE.finditer(line)}
    )
    found = sections(lines)
    has_order_marker = bool(kinds) or any(
        name.startswith(REQUIRED_SECTIONS) for name, _, _ in found
    )
    return {
        "path": os.path.abspath(path),
        "order_document": has_order_marker,
        "review_kind": kinds[0] if len(kinds) == 1 else None,
        "round": rounds[0] if len(rounds) == 1 else None,
        "scope": scopes[0] if len(scopes) == 1 else None,
        "methods": fix_methods(lines),
        "has_previous_verdict": has_nonempty_section(lines, "前巡 verdict"),
        "report_path": report_paths[0] if len(report_paths) == 1 else None,
        "findings": findings,
    }


def read_order(path: str) -> tuple[str | None, str | None]:
    """UTF-8 本文と、 exit 2 用の 1 行理由 (成功時は理由 None)。"""
    reason = None
    if not os.path.isfile(path):
        reason = f"{path}: 通常 file ではない"
    else:
        try:
            with open(path, encoding="utf-8") as handle:
                return handle.read(), None
        except UnicodeDecodeError:
            reason = f"{path}: UTF-8 として読めない"
        except OSError as error:
            reason = f"{path}: 読めない ({error})"
    return None, reason


def find_template(filename: str) -> tuple[str | None, str | None]:
    for directory in TEMPLATE_DIRS:
        candidate = os.path.join(directory, filename)
        if not os.path.isfile(candidate):
            continue
        try:
            with open(candidate, encoding="utf-8") as handle:
                return handle.read(), None
        except OSError as error:
            return None, f"{candidate}: 読めない ({error})"
    return None, f"{filename}: 雛形が見つからない"


def drop_level2_section(text: str, heading: str) -> str:
    lines = text.splitlines(keepends=True)
    marker = f"## {heading}"
    start = next((i for i, line in enumerate(lines) if line.strip() == marker), None)
    if start is None:
        return text
    end = next(
        (i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")),
        len(lines),
    )
    return "".join(lines[:start] + lines[end:])


def render_template(
    template: str, stem: str, directory: str, kind: str, round_number: int | None
) -> str:
    text = template.replace(
        "未記入-report.md", os.path.join(directory, f"{stem}-report.md")
    )
    text = text.replace(
        "未記入-probe.txt", os.path.join(directory, f"{stem}-probe.txt")
    )
    text = text.replace("# 未記入 報告書", f"# {stem} 報告書")
    text = text.replace(": 未記入", f": {stem}")
    if kind == "fix" and round_number is not None:
        text = text.replace("fix round N:", f"fix round {round_number}:")
        if round_number == 1:
            text = drop_level2_section(text, "前巡 verdict")
        if round_number < TREATMENT_MIN_ROUND:
            text = drop_level2_section(text, "処置の種別")
    return text


def new_order(kind: str, path: str) -> int:
    filename = TEMPLATE_KINDS[kind]
    template, reason = find_template(filename)
    if reason is not None or template is None:
        print(reason)
        return 2
    stem = os.path.splitext(os.path.basename(path))[0]
    directory = os.path.dirname(os.path.abspath(path)) or os.curdir
    round_number = None
    if kind == "fix":
        existing = declared_fix_rounds(path)
        round_number = max(existing) + 1 if existing else 1
    text = render_template(template, stem, directory, kind, round_number)
    try:
        with open(path, "x", encoding="utf-8") as handle:
            handle.write(text)
    except FileExistsError:
        print(f"{path}: 既に存在する")
        return 3
    except OSError as error:
        print(f"{path}: 書き出せない ({error})")
        return 2
    print(f"{path}: {filename} から作成した")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="codex_order_lint")
    parser.add_argument("paths", nargs="*", metavar="ORDER.md")
    parser.add_argument("--metadata", action="store_true")
    parser.add_argument("--new", metavar="KIND", choices=tuple(TEMPLATE_KINDS))
    return parser


def lint_paths(paths: list[str], *, metadata: bool) -> int:
    total = 0
    for path in paths:
        text, reason = read_order(path)
        if reason is not None or text is None:
            print(reason)
            return 2
        findings = lint(text, path)
        total += len(findings)
        if metadata:
            record = metadata_record(text, path, findings)
            print(json.dumps(record, ensure_ascii=False))
        else:
            for finding in findings:
                print(f"{path}: {finding}")
    if not metadata and total:
        print(f"{total} 件の規約違反")
    return 1 if total else 0


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.new is not None:
        if len(args.paths) != 1:
            parser.error("--new KIND には ORDER.md を 1 つだけ指定する")
        return new_order(args.new, args.paths[0])
    if not args.paths:
        parser.error("ORDER.md を 1 つ以上指定するか --new を使う")
    return lint_paths(args.paths, metadata=args.metadata)


if __name__ == "__main__":
    sys.exit(main())
