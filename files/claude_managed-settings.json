{
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1"
  },
  "permissions": {
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/application_default_credentials.json)",
      "Read(~/.config/gcloud/credentials.db)",
      "Read(~/.config/gcloud/access_tokens.db)",
      "Read(~/.config/gcloud/legacy_credentials/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.agent-browser/**)",
      "Read(~/.local/share/com.vercel.cli/**)",
      "Read(~/.config/vercel-plugin/**)",
      "Read(~/.claude/daemon/control.key)",
      "Read(~/.config/google-chrome/**/Cookies*)",
      "Read(~/.config/google-chrome/**/Login Data*)",
      "Read(~/.config/google-chrome/**/Web Data*)",
      "Read(~/.config/google-chrome/**/Local State)",
      "Read(~/.local/share/pki/**)",
      "Read(//mnt/c/Users/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git *",
      "gh *",
      "docker *",
      "codex *",
      "node *codex-companion.mjs*",
      "agent-browser *",
      "claude --bg *",
      "claude agents *"
    ],
    "filesystem": {
      "allowWrite": ["~/.claude/plugins/data", "/var/lib/claude-rag-memory"],
      "denyRead": ["/run/docker.sock"]
    },
    "network": {
      "allowAllUnixSockets": true
    },
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.config/gh/hosts.yml", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.pypirc", "mode": "deny" },
        { "path": "~/.config/pip", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" },
        { "path": "~/.codex/auth.json", "mode": "deny" },
        { "path": "~/.agent-browser", "mode": "deny" },
        { "path": "~/.local/share/com.vercel.cli", "mode": "deny" },
        { "path": "~/.config/vercel-plugin", "mode": "deny" },
        { "path": "~/.claude/daemon/control.key", "mode": "deny" },
        { "path": "~/.config/google-chrome", "mode": "deny" },
        { "path": "~/.local/share/pki", "mode": "deny" },
        { "path": "~/.bash_history", "mode": "deny" },
        { "path": "/mnt/c/Users", "mode": "deny" }
      ],
      "envVars": [
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GOOGLE_APPLICATION_CREDENTIALS", "mode": "deny" },
        { "name": "CLOUDSDK_AUTH_ACCESS_TOKEN", "mode": "deny" },
        { "name": "CLOUDSDK_PROXY_PASSWORD", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "CODEX_API_KEY", "mode": "deny" },
        { "name": "TWINE_PASSWORD", "mode": "deny" },
        { "name": "PYPI_TOKEN", "mode": "deny" }
      ]
    }
  }
}
