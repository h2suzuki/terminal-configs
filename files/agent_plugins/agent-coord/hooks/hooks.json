{
  "description": "agent-coord: join the ledger, surface unread events once, keep enforced edits inside the claimed worktree.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "agent_coord hook SessionStart", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "agent_coord hook SessionEnd", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "agent_coord hook UserPromptSubmit", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "agent_coord hook PostToolUse", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [ { "type": "command", "command": "agent_coord hook PreToolUse", "timeout": 10 } ]
      }
    ]
  }
}
